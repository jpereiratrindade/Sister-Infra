# Template documental. A unidade instalada é renderizada por bin/sister-workstation.
[Unit]
Description=SisTer Workstation Ecosystem
After=network-online.target
Wants=network-online.target

[Service]
Environment=SISTER_INFRA_RUNTIME_MODE=installed
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-%h/.config/sister/workstation/runtime.env
ExecStart=%h/.local/share/sister/current/components/sister-infra/bin/sister-workstation runtime-start
ExecStop=%h/.local/share/sister/current/components/sister-infra/bin/sister-workstation runtime-stop
TimeoutStartSec=1200
TimeoutStopSec=180

[Install]
WantedBy=default.target
