# EXAMPLE — NOT INSTALLATION AUTHORITY.
# Materialize reviewed values under /etc/sister; never rename this file in repo.
PROFILE="production"

# Exemplo: 0.0.0.0, IP da interface institucional ou endereço dedicado.
GATEWAY_LISTEN_ADDRESS="0.0.0.0"
GATEWAY_LISTEN_PORT="443"

# A topologia dos participantes (bindings, hosts públicos e probes) não é
# declarada neste perfil. Ela pertence ao deployment declarativo selecionado
# pela workstation.

# Produção nunca gera certificado automaticamente.
TLS_MODE="external"
TLS_PEM="/etc/sister/tls/ecosystem.pem"

# Gate obrigatório de produção. Deve apontar para um comando de readiness
# administrado explicitamente pela implantação.
# Exemplo:
# PRODUCTION_GATE_CMD="/usr/local/libexec/sister-production-readiness"
PRODUCTION_GATE_CMD=""

# Dupla trava deliberada para impedir promoção acidental.
PRODUCTION_APPROVED="NO"
