#!/usr/bin/env python3
"""Production Adapter & Institutional Authority Gates for SisTer Infra (OPS-07).

Implements strictly governed, FHS-compliant, sealed-plan transactional
production lifecycle operations.
"""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import fcntl
import hashlib
import http.client
import json
import os
from pathlib import Path
import shlex
import shutil
import socket
import ssl
import stat
import subprocess
import sys
import tempfile
import time
from typing import Any
import urllib.request

INFRA_ROOT = Path(__file__).resolve().parent.parent
AUTHORITY_CLI = INFRA_ROOT / "bin" / "sister-authority"
CANDIDATE_CLI = INFRA_ROOT / "bin" / "sister-candidate"


class ProductionError(RuntimeError):
    def __init__(self, code: str, message: str) -> None:
        super().__init__(message)
        self.code = code
        self.message = message


class ProductionPreflightError(ProductionError):
    pass


class ProductionAuthorityError(ProductionError):
    pass


class ProductionRollbackError(ProductionError):
    pass


class CandidateIdentityError(RuntimeError):
    pass


def compute_candidate_tree_digest(candidate_dir: Path) -> str:
    proc = subprocess.run(
        [str(CANDIDATE_CLI), "digest", str(candidate_dir), "--json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        raise CandidateIdentityError(proc.stderr.strip() or proc.stdout.strip())
    try:
        return json.loads(proc.stdout)["candidate_digest"]
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise CandidateIdentityError("sister-candidate digest retornou contrato inválido") from exc


def resolve_installation_lock_path(locks_dir: Path) -> Path:
    locks_dir.mkdir(parents=True, exist_ok=True)
    canonical = locks_dir / "installation.lock"
    if not canonical.exists():
        canonical.touch(mode=0o600, exist_ok=True)
    return canonical.resolve()


class ProductionInstallationLock:
    def __init__(self, locks_dir: Path):
        self.locks_dir = locks_dir
        self.lock_target = resolve_installation_lock_path(locks_dir)
        self._fd: int | None = None
        self._inherited: bool = False

    def __enter__(self) -> "ProductionInstallationLock":
        inherited_fd_str = os.environ.get("SISTER_INSTALLATION_LOCK_FD") or os.environ.get("SISTER_WORKSTATION_LOCK_FD")
        if inherited_fd_str:
            try:
                inherited_fd = int(inherited_fd_str)
                fd_path = Path(f"/proc/{os.getpid()}/fd/{inherited_fd}")
                if fd_path.exists() and fd_path.resolve() == self.lock_target:
                    self._fd = inherited_fd
                    self._inherited = True
                    return self
            except (ValueError, OSError):
                pass

        try:
            self._fd = os.open(str(self.lock_target), os.O_CREAT | os.O_RDWR, 0o600)
            fcntl.flock(self._fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.set_inheritable(self._fd, True)
            os.environ["SISTER_INSTALLATION_LOCK_FD"] = str(self._fd)
            os.environ["SISTER_WORKSTATION_LOCK_FD"] = str(self._fd)
        except (BlockingIOError, OSError) as exc:
            if self._fd is not None:
                try:
                    os.close(self._fd)
                except OSError:
                    pass
                self._fd = None
            raise ProductionError(
                "INSTALLATION_LOCKED",
                f"outra operação de produção/lifecycle está em execução (lock ativo em {self.lock_target})",
            ) from exc
        return self

    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:
        if not self._inherited and self._fd is not None:
            if os.environ.get("SISTER_INSTALLATION_LOCK_FD") == str(self._fd):
                del os.environ["SISTER_INSTALLATION_LOCK_FD"]
            if os.environ.get("SISTER_WORKSTATION_LOCK_FD") == str(self._fd):
                del os.environ["SISTER_WORKSTATION_LOCK_FD"]
            try:
                fcntl.flock(self._fd, fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                os.close(self._fd)
            except OSError:
                pass
            self._fd = None


def resolve_authority_context(
    composition_selection: Path,
    deployment: Path,
) -> dict[str, Any]:
    proc = subprocess.run(
        [
            str(AUTHORITY_CLI),
            "resolve",
            "--target", "production",
            "--composition", str(composition_selection),
            "--deployment", str(deployment),
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        raise ProductionError(
            "INSTALLATION_AUTHORITY_INVALID",
            proc.stderr.strip() or "falha ao resolver installation authority",
        )
    return json.loads(proc.stdout)


# -----------------------------------------------------------------------------
# 1. FHS Paths & Environment
# -----------------------------------------------------------------------------

def get_production_root() -> Path:
    root_env = os.environ.get("SISTER_PRODUCTION_ROOT", "").strip()
    if root_env:
        return Path(root_env).expanduser().resolve()
    return Path("/")


def get_fhs_paths(prod_root: Path | None = None) -> dict[str, Path]:
    if prod_root is None:
        prod_root = get_production_root()

    opt_dir = prod_root / "opt" / "sister"
    etc_dir = prod_root / "etc" / "sister"
    var_lib_dir = prod_root / "var" / "lib" / "sister"
    run_dir = prod_root / "run" / "sister"

    return {
        "root": prod_root,
        "opt": opt_dir,
        "releases": opt_dir / "releases",
        "candidates": opt_dir / "candidates",
        "current": opt_dir / "current",
        "previous": opt_dir / "previous",
        "etc": etc_dir,
        "config_env": etc_dir / "production.env",
        "tls": etc_dir / "tls",
        "var_lib": var_lib_dir,
        "state": var_lib_dir / "state",
        "evidence": var_lib_dir / "evidence" / "production",
        "locks": var_lib_dir / "locks",
        "run": run_dir,
        "sockets": run_dir / "sockets",
        "pids": run_dir / "pids",
        "gateway": run_dir / "gateway",
    }


def parse_openssl_date(date_str: str) -> datetime | None:
    for fmt in (
        "%b %d %H:%M:%S %Y GMT",
        "%b  %d %H:%M:%S %Y GMT",
        "%b %d %H:%M:%S %Y",
        "%b  %d %H:%M:%S %Y",
        "%Y-%m-%d %H:%M:%S",
    ):
        try:
            return datetime.strptime(date_str.strip(), fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            pass
    return None


# -----------------------------------------------------------------------------
# 2. Preflight Validators
# -----------------------------------------------------------------------------

def check_clean_sources(
    control_plane_dir: Path,
    candidate_path: Path,
) -> None:
    """Valida se o control plane e os fontes da candidata estão estritamente limpos (PRD-008)."""
    # 1. Control Plane Git Clean
    if (control_plane_dir / ".git").exists():
        proc = subprocess.run(
            ["git", "-C", str(control_plane_dir), "status", "--porcelain"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            raise ProductionPreflightError(
                "DIRTY_SOURCE_CONTROL_PLANE",
                f"control plane possui arquivos modificados ou não rastreados:\n{proc.stdout.strip()}",
            )

    # 2. Fontes de Componentes na Candidata via qualification.json
    qual_file = candidate_path / "evidence" / "composition" / "qualification.json"
    if qual_file.is_file():
        try:
            qual_doc = json.loads(qual_file.read_text(encoding="utf-8"))
            for c in qual_doc.get("components", []):
                root_str = c.get("root")
                cid = c.get("component_id", "unknown")
                if root_str:
                    src_path = Path(root_str)
                    if not src_path.is_absolute():
                        src_path = (control_plane_dir / src_path).resolve()
                    if src_path.is_dir() and (src_path / ".git").exists():
                        proc_c = subprocess.run(
                            ["git", "-C", str(src_path), "status", "--porcelain"],
                            stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE,
                            text=True,
                            check=False,
                        )
                        if proc_c.returncode == 0 and proc_c.stdout.strip():
                            raise ProductionPreflightError(
                                "DIRTY_SOURCE_COMPONENT",
                                f"componente '{cid}' possui fonte com alterações não commitadas:\n{proc_c.stdout.strip()}",
                            )
        except ProductionPreflightError:
            raise
        except Exception:
            pass


def validate_external_tls(
    cert_path: Path,
    key_path: Path,
    expected_hosts: list[str],
    min_validity_sec: int = 86400,
) -> dict[str, Any]:
    """Validação rigorosa de certificado TLS externo (PRD-005, PRD-006)."""
    if not cert_path.is_file():
        raise ProductionPreflightError(
            "TLS_CERT_MISSING",
            f"certificado TLS externo não encontrado: {cert_path}",
        )
    if not key_path.is_file():
        raise ProductionPreflightError(
            "TLS_KEY_MISSING",
            f"chave privada TLS externa não encontrada: {key_path}",
        )

    # 1. Parse do certificado via openssl x509
    cmd = [
        "openssl", "x509",
        "-in", str(cert_path),
        "-noout",
        "-subject", "-dates", "-fingerprint", "-sha256",
    ]
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if r.returncode != 0:
        raise ProductionPreflightError(
            "TLS_CERT_UNPARSEABLE",
            f"falha ao parsear certificado TLS externo: {r.stderr.strip()}",
        )

    not_after = None
    fingerprint = ""
    for line in r.stdout.splitlines():
        if line.startswith("notAfter="):
            not_after = parse_openssl_date(line[len("notAfter="):].strip())
        elif "Fingerprint=" in line:
            fingerprint = line.split("Fingerprint=", 1)[1].strip()

    if not not_after:
        raise ProductionPreflightError(
            "TLS_CERT_UNPARSEABLE",
            "data notAfter não identificada no certificado TLS",
        )

    now = datetime.now(timezone.utc)
    if now >= not_after:
        raise ProductionPreflightError(
            "TLS_CERT_EXPIRED",
            f"certificado TLS externo expirou em {not_after.isoformat()}",
        )

    remaining = (not_after - now).total_seconds()
    if remaining < min_validity_sec:
        raise ProductionPreflightError(
            "TLS_CERT_EXPIRING_SOON",
            f"certificado TLS externo dentro da janela insegura de expiração ({remaining:.0f}s < {min_validity_sec}s)",
        )

    # 2. Chave privada corresponde à chave pública do certificado
    r_pub_cert = subprocess.run(
        ["openssl", "x509", "-in", str(cert_path), "-noout", "-pubkey"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    r_pub_key = subprocess.run(
        ["openssl", "pkey", "-in", str(key_path), "-pubout"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    if r_pub_cert.returncode != 0 or r_pub_key.returncode != 0:
        raise ProductionPreflightError(
            "TLS_KEY_CERT_MISMATCH",
            "falha ao extrair chaves públicas para comparação",
        )
    if r_pub_cert.stdout.strip() != r_pub_key.stdout.strip():
        raise ProductionPreflightError(
            "TLS_KEY_CERT_MISMATCH",
            "chave privada não corresponde ao certificado TLS externo",
        )

    # 3. Extrair SANs (Subject Alternative Names)
    r_sans = subprocess.run(
        ["openssl", "x509", "-in", str(cert_path), "-noout", "-ext", "subjectAltName"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False,
    )
    sans = []
    if r_sans.returncode == 0:
        import re
        for m in re.finditer(r"(?:DNS|IP(?: Address)?):([^\s,]+)", r_sans.stdout):
            sans.append(m.group(1).strip())

    # 4. Validar cobertura dos hosts esperados
    for host in expected_hosts:
        covered = False
        for san in sans:
            if san == host:
                covered = True
                break
            if san.startswith("*.") and host.count(".") == san.count("."):
                suffix = san[2:]
                if host.endswith(suffix):
                    covered = True
                    break
        if not covered:
            raise ProductionPreflightError(
                "TLS_SAN_MISSING",
                f"hostname '{host}' não coberto pelas SANs do certificado: {sans}",
            )

    return {
        "fingerprint": fingerprint,
        "not_after": not_after.isoformat(),
        "sans": sans,
    }


def check_dns_readiness(
    declared_hosts: list[str],
    expected_target: str,
    resolver_override: dict[str, str] | None = None,
) -> dict[str, Any]:
    """Verifica readiness de DNS dos hostnames publicados (PRD-010)."""
    env_mock = os.environ.get("SISTER_PRODUCTION_DNS_RESOLVER")
    if env_mock and resolver_override is None:
        try:
            resolver_override = json.loads(env_mock)
        except Exception:
            pass

    results = {}
    for host in declared_hosts:
        if resolver_override is not None:
            resolved = resolver_override.get(host)
            if resolved is None:
                raise ProductionPreflightError(
                    "DNS_MISSING",
                    f"hostname '{host}' não encontrado no resolvedor DNS institucional",
                )
            if resolved != expected_target:
                raise ProductionPreflightError(
                    "DNS_DIVERGENT",
                    f"hostname '{host}' resolve para '{resolved}', esperado '{expected_target}'",
                )
            results[host] = {"status": "READY", "target": resolved}
        else:
            try:
                infos = socket.getaddrinfo(host, None)
                ips = list({info[4][0] for info in infos})
                if not ips:
                    raise ProductionPreflightError(
                        "DNS_MISSING",
                        f"hostname '{host}' retornou lista vazia de endereços no DNS",
                    )
                if expected_target not in ips and expected_target not in ("0.0.0.0", "127.0.0.1"):
                    raise ProductionPreflightError(
                        "DNS_DIVERGENT",
                        f"hostname '{host}' resolve para {ips}, esperado conter '{expected_target}'",
                    )
                results[host] = {"status": "READY", "target": ips[0]}
            except socket.gaierror as exc:
                raise ProductionPreflightError(
                    "DNS_MISSING",
                    f"hostname '{host}' falhou ao resolver no DNS: {exc}",
                )
    return results


def check_ports_free(bindings: list[dict[str, Any]], running_pids: set[int]) -> None:
    """Verifica colisão com processos externos não gerenciados (PRD-018)."""
    for b in bindings:
        rt = b.get("runtime", {})
        transport = b.get("transport") or rt.get("transport", "tcp")
        if transport == "tcp":
            host = b.get("listen") or rt.get("listen", "127.0.0.1")
            port = b.get("port") or rt.get("port")
            if port:
                with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                    s.settimeout(0.2)
                    res = s.connect_ex((host, int(port)))
                    if res == 0:
                        raise ProductionPreflightError(
                            "PORT_COLLISION_EXTERNAL",
                            f"porta {port} ({host}) ocupada por processo externo não gerenciado",
                        )


# -----------------------------------------------------------------------------
# 3. Service Manager Adapter
# -----------------------------------------------------------------------------

class ServiceManagerAdapter:
    """Interface abstrata para gerenciar serviços de sistema (PRD-012)."""

    def daemon_reload(self) -> None:
        raise NotImplementedError

    def start(self, unit_name: str, comp_info: dict[str, Any]) -> None:
        raise NotImplementedError

    def stop(self, unit_name: str) -> None:
        raise NotImplementedError

    def restart(self, unit_name: str, comp_info: dict[str, Any]) -> None:
        raise NotImplementedError

    def is_active(self, unit_name: str) -> bool:
        raise NotImplementedError


class MockServiceManager(ServiceManagerAdapter):
    """Implementação em sandbox/mock para execução determinística sem root."""

    def __init__(self, state_dir: Path) -> None:
        self.state_file = state_dir / "mock-services.json"
        self.state_dir = state_dir
        self.state_dir.mkdir(parents=True, exist_ok=True)
        if not self.state_file.exists():
            self._save({})

    def _load(self) -> dict[str, Any]:
        try:
            return json.loads(self.state_file.read_text(encoding="utf-8"))
        except Exception:
            return {}

    def _save(self, data: dict[str, Any]) -> None:
        self.state_file.write_text(json.dumps(data, indent=2), encoding="utf-8")

    def daemon_reload(self) -> None:
        if os.environ.get("SISTER_MOCK_FAIL_DAEMON_RELOAD") == "1":
            raise ProductionError("SERVICE_MANAGER_FAILURE", "falha injetada em daemon-reload")

    def start(self, unit_name: str, comp_info: dict[str, Any]) -> None:
        if os.environ.get("SISTER_MOCK_FAIL_SERVICE_MANAGER") == "1":
            raise ProductionError("SERVICE_MANAGER_FAILURE", "falha simulada no gerenciador de serviços")
        if os.environ.get("SISTER_MOCK_FAIL_START_UNIT") == unit_name:
            raise ProductionError("SERVICE_START_FAILURE", f"falha ao iniciar unidade {unit_name}")

        c_path = comp_info.get("c_path")
        entrypoint = comp_info.get("entrypoint")
        env = comp_info.get("env", os.environ.copy())

        if c_path and entrypoint:
            cmd = [str(c_path / entrypoint), "start"]
            proc = subprocess.run(cmd, cwd=str(c_path), env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if proc.returncode != 0:
                raise ProductionError(
                    "SERVICE_START_FAILURE",
                    f"falha ao iniciar {unit_name}: {proc.stderr.decode('utf-8', errors='replace')}",
                )

        state = self._load()
        state[unit_name] = {
            "active": True,
            "started_at": datetime.now(timezone.utc).isoformat(),
        }
        self._save(state)

    def stop(self, unit_name: str) -> None:
        state = self._load()
        state[unit_name] = {"active": False}
        self._save(state)

    def restart(self, unit_name: str, comp_info: dict[str, Any]) -> None:
        self.stop(unit_name)
        self.start(unit_name, comp_info)

    def is_active(self, unit_name: str) -> bool:
        state = self._load()
        return bool(state.get(unit_name, {}).get("active", False))


class SystemdServiceManager(ServiceManagerAdapter):
    """Implementação real do gerenciador de serviços systemd institucional (PRD-012)."""

    def __init__(self, fhs: dict[str, Path], is_user: bool = False) -> None:
        self.fhs = fhs
        self.is_user = is_user
        env_unit_dir = os.environ.get("SISTER_SYSTEMD_UNIT_DIR")
        if env_unit_dir:
            self.unit_dir = Path(env_unit_dir).expanduser().resolve()
        elif not is_user and os.geteuid() == 0:
            self.unit_dir = Path("/etc/systemd/system")
        elif is_user:
            self.unit_dir = Path.home() / ".config" / "systemd" / "user"
        else:
            self.unit_dir = fhs.get("etc", Path("/etc/sister")) / "systemd"

        self.unit_dir.mkdir(parents=True, exist_ok=True)

    def render_unit(self, unit_name: str, comp_info: dict[str, Any]) -> Path:
        """Separa a materialização determinística da unit do gerenciamento systemd."""
        c_path = comp_info.get("c_path")
        entrypoint = comp_info.get("entrypoint", "")
        env = comp_info.get("env", {})
        exec_cmd = comp_info.get("exec_cmd")
        stop_cmd = None

        if not exec_cmd and c_path and entrypoint:
            exec_cmd = f"{c_path / entrypoint} start"
            stop_cmd = f"{c_path / entrypoint} stop"

        env_lines = []
        for k, v in env.items():
            if k.startswith("SISTER_") or k in ("PATH", "PYTHONPATH"):
                env_lines.append(f'Environment="{k}={v}"')

        unit_content = f"""[Unit]
Description=SisTer Service {unit_name}
After=network.target

[Service]
Type=oneshot
WorkingDirectory={c_path or self.fhs.get("opt", "/opt/sister")}
ExecStart={exec_cmd}
{f"ExecStop={stop_cmd}" if stop_cmd else ""}
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
{"\n".join(env_lines)}

[Install]
WantedBy=multi-user.target
"""
        unit_file = self.unit_dir / unit_name
        unit_file.write_text(unit_content, encoding="utf-8")
        return unit_file

    def daemon_reload(self) -> None:
        cmd = ["systemctl", "--user", "daemon-reload"] if self.is_user else ["systemctl", "daemon-reload"]
        try:
            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        except OSError as exc:
            raise ProductionError("SERVICE_MANAGER_FAILURE", f"systemctl indisponível: {exc}") from exc
        if result.returncode != 0:
            raise ProductionError(
                "SERVICE_MANAGER_FAILURE",
                f"systemd daemon-reload falhou: {result.stderr.strip() or result.stdout.strip()}",
            )

    def start(self, unit_name: str, comp_info: dict[str, Any]) -> None:
        self.render_unit(unit_name, comp_info)
        self.daemon_reload()

        cmd = ["systemctl", "--user", "start", unit_name] if self.is_user else ["systemctl", "start", unit_name]
        try:
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        except OSError as exc:
            raise ProductionError("SERVICE_START_FAILURE", f"systemctl indisponível ao iniciar {unit_name}: {exc}") from exc
        if res.returncode != 0:
            raise ProductionError(
                "SERVICE_START_FAILURE",
                f"systemd recusou start de {unit_name}: {res.stderr.strip() or res.stdout.strip()}",
            )
        if not self.is_active(unit_name):
            raise ProductionError(
                "SERVICE_NOT_ACTIVE",
                f"systemd não confirmou ACTIVE para {unit_name} após start",
            )

    def stop(self, unit_name: str) -> None:
        cmd = ["systemctl", "--user", "stop", unit_name] if self.is_user else ["systemctl", "stop", unit_name]
        try:
            result = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        except OSError as exc:
            raise ProductionError("SERVICE_STOP_FAILURE", f"systemctl indisponível ao parar {unit_name}: {exc}") from exc
        if result.returncode != 0:
            raise ProductionError(
                "SERVICE_STOP_FAILURE",
                f"systemd recusou stop de {unit_name}: {result.stderr.strip() or result.stdout.strip()}",
            )

    def restart(self, unit_name: str, comp_info: dict[str, Any]) -> None:
        self.stop(unit_name)
        self.start(unit_name, comp_info)

    def is_active(self, unit_name: str) -> bool:
        cmd = ["systemctl", "--user", "is-active", "--quiet", unit_name] if self.is_user else ["systemctl", "is-active", "--quiet", unit_name]
        try:
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
        except OSError:
            return False
        return res.returncode == 0


def resolve_service_manager_type(fhs: dict[str, Path]) -> str:
    configured = os.environ.get("SISTER_PRODUCTION_SERVICE_MANAGER", "").strip()
    sandbox_or_test = fhs["root"] != Path("/") or os.environ.get("SISTER_PRODUCTION_TEST_MODE") == "1"
    mgr_type = configured or ("mock" if sandbox_or_test else "systemd")
    if mgr_type == "mock" and not sandbox_or_test:
        raise ProductionError(
            "MOCK_FORBIDDEN_IN_REAL_PRODUCTION",
            "mock é permitido somente com SISTER_PRODUCTION_ROOT isolado ou SISTER_PRODUCTION_TEST_MODE=1",
        )
    if mgr_type not in ("mock", "systemd"):
        raise ProductionError("INVALID_SERVICE_MANAGER", f"gerenciador de serviço desconhecido: {mgr_type}")
    return mgr_type


def get_service_manager(fhs: dict[str, Path]) -> ServiceManagerAdapter:
    mgr_type = resolve_service_manager_type(fhs)
    if mgr_type == "mock":
        return MockServiceManager(fhs["state"])
    if mgr_type == "systemd":
        # Validação mandatória de autoridade institucional (PRD-016)
        prod_approved = os.environ.get("PRODUCTION_APPROVED", "").strip()
        prod_confirm = os.environ.get("SISTER_INFRA_PRODUCTION_CONFIRM", "").strip()
        if prod_approved != "YES" or prod_confirm != "YES":
            raise ProductionError(
                "AUTHORITY_BOUNDARY",
                "systemd institucional requer autorização formal (PRODUCTION_APPROVED=YES e SISTER_INFRA_PRODUCTION_CONFIRM=YES)",
            )
        is_user = os.geteuid() != 0
        return SystemdServiceManager(fhs, is_user=is_user)
    raise AssertionError(f"tipo de gerenciador não tratado: {mgr_type}")


def build_service_witness(
    fhs: dict[str, Path],
    service_mgr: ServiceManagerAdapter,
    unit_names: list[str],
) -> dict[str, Any]:
    """Record the host and authoritative service-manager state behind a PASS."""
    manager = "systemd" if isinstance(service_mgr, SystemdServiceManager) else "mock"
    witness: dict[str, Any] = {
        "service_manager": manager,
        "execution_mode": (
            "REAL_HOST"
            if fhs["root"] == Path("/") and isinstance(service_mgr, SystemdServiceManager)
            else "SANDBOX_TEST"
        ),
        "hostname": socket.gethostname(),
        "units": {unit: ("ACTIVE" if service_mgr.is_active(unit) else "INACTIVE") for unit in unit_names},
    }
    for label, path in (
        ("machine_id", Path("/etc/machine-id")),
        ("boot_id", Path("/proc/sys/kernel/random/boot_id")),
    ):
        try:
            witness[label] = path.read_text(encoding="utf-8").strip()
        except OSError:
            witness[label] = None
    return witness


def reconcile_production_gateway(
    fhs: dict[str, Path],
    resolved_deployment_file: Path,
    service_mgr: ServiceManagerAdapter,
) -> Path:
    """Reconcilia e materializa o gateway HAProxy produtivo a partir do deployment resolvido (PRD-GATEWAY)."""
    tls_cert = Path(os.environ.get("PRODUCTION_TLS_CERT", str(fhs["tls"] / "ecosystem.crt"))).expanduser().resolve()
    tls_key = Path(os.environ.get("PRODUCTION_TLS_KEY", str(fhs["tls"] / "ecosystem.key"))).expanduser().resolve()
    tls_pem = fhs["tls"] / "ecosystem.pem"

    if not tls_pem.is_file():
        fhs["tls"].mkdir(parents=True, exist_ok=True)
        if tls_cert.is_file() and tls_key.is_file():
            bundle = tls_cert.read_text(encoding="utf-8") + "\n" + tls_key.read_text(encoding="utf-8")
            tls_pem.write_text(bundle, encoding="utf-8")
            tls_pem.chmod(0o600)
        else:
            raise ProductionError("TLS_MATERIAL_MISSING", f"cert/key TLS ausentes para gerar bundle: {tls_cert}, {tls_key}")

    resolved_doc = json.loads(resolved_deployment_file.read_text(encoding="utf-8"))
    gw_conf = resolved_doc.get("gateway") or {}
    gw_listen = (
        os.environ.get("SISTER_PRODUCTION_GATEWAY_LISTEN_ADDRESS", "").strip()
        or os.environ.get("GATEWAY_LISTEN_ADDRESS", "").strip()
        or gw_conf.get("listen", "127.0.0.1")
    )
    gw_port = int(
        os.environ.get("SISTER_PRODUCTION_GATEWAY_PORT", "").strip()
        or gw_conf.get("port", 443)
    )

    gateway_cli = INFRA_ROOT / "bin" / "sister-gateway"
    res = subprocess.run(
        [
            sys.executable,
            str(gateway_cli),
            "render",
            str(resolved_deployment_file),
            "--listen-address", str(gw_listen),
            "--listen-port", str(gw_port),
            "--tls-pem", str(tls_pem),
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if res.returncode != 0:
        raise ProductionError("GATEWAY_RENDER_FAILED", f"falha ao renderizar HAProxy de produção: {res.stderr.strip()}")

    gw_etc = fhs["etc"] / "gateway"
    gw_etc.mkdir(parents=True, exist_ok=True)
    gw_cfg = gw_etc / "haproxy.cfg"
    gw_cfg.write_text(res.stdout, encoding="utf-8")

    # Validar sintaxe haproxy -c se o binário existir
    haproxy_bin = shutil.which("haproxy") or "/usr/local/sbin/haproxy-3.2.22"
    if haproxy_bin and Path(haproxy_bin).is_file():
        r_c = subprocess.run([haproxy_bin, "-c", "-f", str(gw_cfg)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        if r_c.returncode != 0:
            raise ProductionError("GATEWAY_CONFIG_INVALID", f"configuração HAProxy de produção rejeitada: {r_c.stderr.strip()}")

        # Gerenciar serviço via service_mgr
        gw_run = fhs["run"] / "gateway"
        gw_run.mkdir(parents=True, exist_ok=True)
        pid_file = gw_run / "haproxy.pid"
        gw_info = {
            "exec_cmd": f"{haproxy_bin} -D -f {gw_cfg} -p {pid_file}",
            "env": os.environ.copy(),
        }
        service_mgr.start("sister-gateway.service", gw_info)

    return gw_cfg


def probe_component_health(runtime: dict[str, Any], health_path: str, timeout: float = 3.0) -> bool:
    """Sonda o endpoint de health do componente diretamente via TCP ou socket Unix."""
    transport = runtime.get("transport")
    if transport == "tcp":
        host = runtime.get("listen", "127.0.0.1")
        port = runtime.get("port")
        if not port:
            return False
        url = f"http://{host}:{port}{health_path}"
        try:
            req = urllib.request.Request(url, method="GET")
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return 200 <= resp.status < 400
        except Exception:
            return False
    elif transport == "unix":
        socket_path = runtime.get("socket")
        if not socket_path or not os.path.exists(socket_path):
            return False
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(timeout)
            sock.connect(socket_path)
            req = f"GET {health_path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
            sock.sendall(req.encode("utf-8"))
            data = sock.recv(1024).decode("utf-8", errors="replace")
            sock.close()
            return "200 OK" in data or "HTTP/1." in data
        except Exception:
            return False
    return False


def probe_gateway_subdomain_https(
    listen_addr: str,
    listen_port: int,
    host: str,
    health_path: str,
    tls_cert_path: Path | None = None,
    timeout: float = 3.0,
) -> bool:
    """Sonda o gateway via HTTPS enviando o hostname no cabeçalho Host e SNI."""
    try:
        ctx = ssl.create_default_context()
        if tls_cert_path and tls_cert_path.is_file():
            ctx.load_verify_locations(cafile=str(tls_cert_path))
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        conn = http.client.HTTPSConnection(listen_addr, listen_port, context=ctx, timeout=timeout)
        conn.request("GET", health_path, headers={"Host": host, "Connection": "close"})
        resp = conn.getresponse()
        status = resp.status
        conn.close()
        return 200 <= status < 400
    except Exception:
        return False


# -----------------------------------------------------------------------------
# 4. Plan & Sealed Digest Computation
# -----------------------------------------------------------------------------

def compute_plan_digest(canonical_payload: dict[str, Any]) -> str:
    """Calcula SHA-256 canônico sobre o payload selado determinístico (PRD-003)."""
    canonical_json = json.dumps(canonical_payload, sort_keys=True, separators=(",", ":"))
    digest = hashlib.sha256(canonical_json.encode("utf-8")).hexdigest()
    return f"sha256:{digest}"


def validate_production_gateway_policy(deployment: dict[str, Any]) -> dict[str, Any]:
    gateway = deployment.get("gateway") or {}
    if gateway.get("protocol", "https") != "https":
        raise ProductionError(
            "PRODUCTION_TLS_REQUIRED",
            "deployment de produção exige gateway.protocol=https",
        )
    if gateway.get("exposure", "host") != "host":
        raise ProductionError(
            "PRODUCTION_HOST_ROUTING_REQUIRED",
            "deployment de produção proíbe exposição LAB ip-ports",
        )
    return gateway


def build_production_plan(
    candidate_dir: Path,
    deployment_file: Path,
    current_release: Path | None = None,
    fhs: dict[str, Path] | None = None,
) -> dict[str, Any]:
    """Constrói o plano de reconciliação de produção (PRD-001)."""
    if fhs is None:
        fhs = get_fhs_paths()

    # 1. Carregar Candidate Manifest
    candidate_manifest_file = candidate_dir / "manifest.json"
    if not candidate_manifest_file.is_file():
        raise ProductionError("CANDIDATE_INVALID", f"manifest.json ausente na candidata: {candidate_dir}")
    candidate_verify = subprocess.run(
        [str(CANDIDATE_CLI), "verify", str(candidate_dir), "--json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if candidate_verify.returncode != 0:
        raise ProductionError(
            "CANDIDATE_INVALID",
            candidate_verify.stderr.strip() or candidate_verify.stdout.strip(),
        )
    candidate_manifest = json.loads(candidate_manifest_file.read_text(encoding="utf-8"))
    try:
        candidate_digest = compute_candidate_tree_digest(candidate_dir)
    except CandidateIdentityError as exc:
        raise ProductionError("CANDIDATE_INVALID", str(exc)) from exc

    # 2. Carregar Deployment Desejado
    if not deployment_file.is_file():
        raise ProductionError("DEPLOYMENT_INVALID", f"arquivo de deployment ausente: {deployment_file}")
    deployment = json.loads(deployment_file.read_text(encoding="utf-8"))
    authority = resolve_authority_context(candidate_manifest_file, deployment_file)
    gateway = validate_production_gateway_policy(deployment)
    gateway_listen = (
        os.environ.get("SISTER_PRODUCTION_GATEWAY_LISTEN_ADDRESS", "").strip()
        or os.environ.get("GATEWAY_LISTEN_ADDRESS", "").strip()
        or gateway.get("listen")
    )
    if not gateway_listen:
        raise ProductionError(
            "GATEWAY_BIND_MISSING",
            "deployment de produção deve declarar gateway.listen ou receber override explícito",
        )
    gateway_port_text = (
        os.environ.get("SISTER_PRODUCTION_GATEWAY_LISTEN_PORT", "").strip()
        or os.environ.get("GATEWAY_LISTEN_PORT", "").strip()
    )
    gateway_port = int(gateway_port_text) if gateway_port_text else gateway.get("port")
    if not isinstance(gateway_port, int) or isinstance(gateway_port, bool):
        raise ProductionError(
            "GATEWAY_PORT_MISSING",
            "deployment de produção deve declarar gateway.port ou receber override explícito",
        )

    # 3. Invocar reconciliador em modo production
    reconcile_bin = INFRA_ROOT / "bin" / "sister-reconcile"
    cmd = [
        str(reconcile_bin),
        "plan",
        "--mode", "production",
        "--desired-candidate", str(candidate_dir),
        "--desired-deployment", str(deployment_file),
        "--no-probe-runtime",
        "--json",
    ]
    if current_release is not None:
        cmd.extend(["--current-release", str(current_release)])
    elif fhs["current"].is_symlink() or fhs["current"].is_dir():
        cmd.extend(["--current-release", str(fhs["current"].resolve())])

    env = os.environ.copy()
    env["SISTER_PRODUCTION_ROOT"] = str(fhs["root"])
    env["SISTER_PRODUCTION_INSTALL_ROOT"] = str(fhs["opt"])

    proc = subprocess.run(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if proc.returncode != 0:
        raise ProductionError("PLAN_RECONCILE_FAILED", f"falha ao projetar plano pelo reconciliador: {proc.stderr.strip()}")

    try:
        raw_plan = json.loads(proc.stdout)
    except Exception as exc:
        raise ProductionError("PLAN_PARSE_FAILED", f"saída inválida do reconciliador: {exc}")

    # 4. Extrair bindings e hosts declarados
    declared_hosts = []
    gw_config = deployment.get("gateway") or {}
    domain = gw_config.get("domain")
    if domain:
        for c in candidate_manifest.get("components", []):
            cid = c.get("component_id", "")
            if cid:
                identity = cid.lower().replace("_", "-")
                declared_hosts.append(f"{identity}.{domain}")
    else:
        for b in deployment.get("bindings", []):
            gw = b.get("gateway", {})
            host = gw.get("host")
            if host:
                declared_hosts.append(host)

    normalized_bindings = []
    for b in deployment.get("bindings", []):
        sys_id = b.get("system_id", "")
        gw = b.get("gateway", {})
        host = gw.get("host")
        rt = b.get("runtime", {})
        normalized_bindings.append({
            "system_id": sys_id,
            "transport": rt.get("transport", "tcp"),
            "listen": rt.get("listen", "127.0.0.1"),
            "port": rt.get("port"),
            "socket": rt.get("socket"),
            "host": host,
        })

    # 5. Montar Sealed Payload Criptográfico
    sealed_payload = {
        "candidate_id": candidate_manifest.get("candidate_id", ""),
        "candidate_digest": candidate_digest,
        "composition_id": candidate_manifest.get("composition_id", ""),
        "deployment_id": deployment.get("deployment_id", ""),
        "policy": {
            "mode": "production",
            "tls_mode": "external",
        },
        "gateway": {
            "listen": gateway_listen,
            "port": gateway_port,
        },
        "bindings": sorted(normalized_bindings, key=lambda x: x["system_id"]),
        "changes": sorted([
            {
                "component_id": c.get("component_id", ""),
                "action": c.get("action", ""),
                "reason": c.get("reason", ""),
            }
            for c in raw_plan.get("changes", [])
        ], key=lambda x: (x["component_id"], x["action"])),
    }

    plan_digest = compute_plan_digest(sealed_payload)

    # 6. Plano Final Estruturado
    full_plan = {
        "schema": "sister.infra.production.plan/1.0.0",
        "plan_version": "1.0.0",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "authority": authority,
        "policy": {
            "mode": "production",
            "fhs_root": str(fhs["root"]),
            "tls_mode": "external",
        },
        "candidate": {
            "candidate_id": candidate_manifest.get("candidate_id"),
            "composition_id": candidate_manifest.get("composition_id"),
            "candidate_path": str(candidate_dir.resolve()),
            "candidate_digest": candidate_digest,
            "digest_algorithm": "sister.infra.candidate.tree/1+sha256",
        },
        "deployment": {
            "deployment_id": deployment.get("deployment_id"),
            "schema": deployment.get("schema"),
            "deployment_path": str(deployment_file.resolve()),
            "gateway_listen": gateway_listen,
            "gateway_port": gateway_port,
            "declared_hosts": declared_hosts,
        },
        "current_release": {
            "release_id": raw_plan.get("current_release", {}).get("release_id") if raw_plan.get("current_release") else None,
            "release_path": str(fhs["current"].resolve()) if fhs["current"].exists() else None,
        },
        "changes": raw_plan.get("changes", []),
        "summary": raw_plan.get("summary", {}),
        "sealed_payload": sealed_payload,
        "plan_digest": plan_digest,
    }

    return full_plan


# -----------------------------------------------------------------------------
# 5. Transactional Apply & Rollback
# -----------------------------------------------------------------------------

def execute_production_apply(
    plan_path: Path,
    expected_digest: str,
    fhs: dict[str, Path] | None = None,
) -> dict[str, Any]:
    """Execução transacional de produção com autoridade, preflight e rollback (PRD-002, PRD-013)."""
    if fhs is None:
        fhs = get_fhs_paths()

    with ProductionInstallationLock(fhs["locks"]):
        return _execute_production_apply_unlocked(plan_path, expected_digest, fhs=fhs)


def _execute_production_apply_unlocked(
    plan_path: Path,
    expected_digest: str,
    fhs: dict[str, Path],
) -> dict[str, Any]:
    # -------------------------------------------------------------------------
    # 1. Authority Gate: Digest Validation (PRD-003)
    # -------------------------------------------------------------------------
    if not plan_path.is_file():
        raise ProductionAuthorityError("PLAN_FILE_NOT_FOUND", f"arquivo de plano ausente: {plan_path}")

    try:
        plan_doc = json.loads(plan_path.read_text(encoding="utf-8"))
    except Exception as exc:
        raise ProductionAuthorityError("PLAN_FILE_INVALID", f"falha ao ler JSON do plano: {exc}")

    sealed_payload = plan_doc.get("sealed_payload")
    if not sealed_payload:
        raise ProductionAuthorityError("PLAN_SEALED_PAYLOAD_MISSING", "plano não contém 'sealed_payload'")

    computed_digest = compute_plan_digest(sealed_payload)
    if computed_digest != expected_digest or plan_doc.get("plan_digest") != expected_digest:
        raise ProductionAuthorityError(
            "PLAN_DIGEST_MISMATCH",
            f"digest aprovado não confere ({expected_digest} != {computed_digest})",
        )

    # -------------------------------------------------------------------------
    # 2. Authority Gate: Institutional Confirmation (PRD-016)
    # -------------------------------------------------------------------------
    prod_approved = os.environ.get("PRODUCTION_APPROVED", "").strip()
    prod_confirm = os.environ.get("SISTER_INFRA_PRODUCTION_CONFIRM", "").strip()

    if prod_approved != "YES":
        raise ProductionAuthorityError(
            "AUTHORITY_APPROVAL_MISSING",
            "produção exige PRODUCTION_APPROVED=YES explicitamente declarado",
        )
    if prod_confirm != "YES":
        raise ProductionAuthorityError(
            "AUTHORITY_APPROVAL_MISSING",
            "produção exige SISTER_INFRA_PRODUCTION_CONFIRM=YES explicitamente declarado",
        )

    gate_cmd = os.environ.get("PRODUCTION_GATE_CMD", "").strip()
    require_gate_cmd = os.environ.get("PRODUCTION_REQUIRE_GATE_CMD") == "1"

    if require_gate_cmd and not gate_cmd:
        raise ProductionAuthorityError(
            "AUTHORITY_GATE_CMD_MISSING",
            "PRODUCTION_GATE_CMD obrigatório quando PRODUCTION_REQUIRE_GATE_CMD=1",
        )

    if gate_cmd:
        cmd_parts = shlex.split(gate_cmd)
        gate_proc = subprocess.run(cmd_parts, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
        if gate_proc.returncode != 0:
            raise ProductionAuthorityError(
                "AUTHORITY_GATE_REJECTED",
                f"comando de gate institucional rejeitou a implantação (exit={gate_proc.returncode}): {gate_proc.stderr.strip()}",
            )

    # -------------------------------------------------------------------------
    # 3. Preflight: Source Clean, TLS Externo, DNS, Ports (PRD-005, 008, 010)
    # -------------------------------------------------------------------------
    candidate_path = Path(plan_doc["candidate"]["candidate_path"])
    candidate_manifest = json.loads((candidate_path / "manifest.json").read_text(encoding="utf-8"))
    expected_candidate_digest = plan_doc["candidate"].get("candidate_digest")
    try:
        actual_candidate_digest = compute_candidate_tree_digest(candidate_path)
    except CandidateIdentityError as exc:
        raise ProductionAuthorityError("CANDIDATE_IDENTITY_INVALID", str(exc)) from exc
    if not expected_candidate_digest or actual_candidate_digest != expected_candidate_digest:
        raise ProductionAuthorityError(
            "CANDIDATE_DIGEST_MISMATCH",
            f"árvore da candidata divergiu do plano ({actual_candidate_digest} != {expected_candidate_digest})",
        )

    control_plane_source = Path(
        os.environ.get("SISTER_PRODUCTION_CONTROL_PLANE_SOURCE", str(INFRA_ROOT))
    ).expanduser().resolve()
    check_clean_sources(control_plane_source, candidate_path)

    # Configuração de TLS Externo
    tls_cert = Path(os.environ.get("PRODUCTION_TLS_CERT", str(fhs["tls"] / "ecosystem.crt"))).expanduser().resolve()
    tls_key = Path(os.environ.get("PRODUCTION_TLS_KEY", str(fhs["tls"] / "ecosystem.key"))).expanduser().resolve()
    declared_hosts = plan_doc["deployment"].get("declared_hosts", [])

    tls_info = validate_external_tls(tls_cert, tls_key, declared_hosts)

    # Verificação de DNS
    expected_gw_target = plan_doc["deployment"]["gateway_listen"]
    dns_info = check_dns_readiness(declared_hosts, expected_gw_target)

    # Verificação de portas e concorrência
    check_ports_free(plan_doc["sealed_payload"].get("bindings", []), set())

    # -------------------------------------------------------------------------
    # 4. Verificação Factual de Divergência (PRD-004)
    # -------------------------------------------------------------------------
    deployment_path_str = plan_doc["deployment"].get("deployment_path")
    if deployment_path_str and Path(deployment_path_str).is_file():
        deployment_file = Path(deployment_path_str)
    else:
        raise ProductionAuthorityError(
            "PLAN_DEPLOYMENT_MISSING",
            f"deployment selado no plano não está disponível: {deployment_path_str}",
        )
    fresh_plan = build_production_plan(
        candidate_path,
        deployment_file,
        current_release=fhs["current"].resolve() if fhs["current"].exists() else None,
        fhs=fhs,
    )
    if fresh_plan["plan_digest"] != expected_digest:
        raise ProductionAuthorityError(
            "PLAN_DIVERGENCE_DETECTED",
            f"estado factual atual divergiu do plano aprovado ({fresh_plan['plan_digest']} != {expected_digest})",
        )

    # Se todas as ações forem KEEP (NO_OP)
    if fresh_plan["summary"].get("add", 0) == 0 and fresh_plan["summary"].get("update", 0) == 0 and fresh_plan["summary"].get("remove", 0) == 0:
        verification = execute_production_verify(fhs=fhs)
        if verification.get("candidate_digest") != actual_candidate_digest:
            raise ProductionError(
                "NO_OP_CANDIDATE_DIVERGENCE",
                "estado convergido executa outra candidata; uma promoção exata requer nova release",
            )
        audit_evidence = {
            "schema": "sister.infra.production.evidence/1.0.0",
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "status": "NO_OP",
            "plan_digest": expected_digest,
            "candidate_id": plan_doc["candidate"]["candidate_id"],
            "deployment_id": plan_doc["deployment"]["deployment_id"],
            "actions_applied": [],
            "tls": tls_info,
            "dns": dns_info,
            "candidate_digest": actual_candidate_digest,
            "verification": verification,
            "service_witness": verification["service_witness"],
        }
        evidence_dir = fhs["evidence"]
        evidence_dir.mkdir(parents=True, exist_ok=True)
        evidence_file = evidence_dir / f"audit-{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S')}-{expected_digest.replace(':', '_')}.json"
        evidence_file.write_text(json.dumps(audit_evidence, indent=2), encoding="utf-8")
        return audit_evidence

    # -------------------------------------------------------------------------
    # 5. Transação: Materialização Staging -> Start -> Verify -> Commit (PRD-013)
    # -------------------------------------------------------------------------
    service_mgr = get_service_manager(fhs)
    service_mgr.daemon_reload()

    ts = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%SZ")
    candidate_id = plan_doc["candidate"]["candidate_id"]
    target_release_id = f"pr-{ts}-{candidate_id}"
    staging_dir = fhs["releases"] / f".creating-{target_release_id}"
    target_release_dir = fhs["releases"] / target_release_id

    # Limpeza de staging anterior se houver
    if staging_dir.exists():
        shutil.rmtree(staging_dir)

    staging_dir.mkdir(parents=True, exist_ok=True)
    rollback_needed = True
    previous_release_dir = fhs["current"].resolve() if fhs["current"].exists() else None
    actions_applied = []

    try:
        # Copiar a árvore completa e provar a identidade da cópia antes de
        # transformá-la em release (fecha troca concorrente/TOCTOU da candidata).
        shutil.copytree(candidate_path, staging_dir, dirs_exist_ok=True)
        copied_candidate_digest = compute_candidate_tree_digest(staging_dir)
        if copied_candidate_digest != actual_candidate_digest:
            raise ProductionError(
                "CANDIDATE_COPY_DIGEST_MISMATCH",
                f"cópia staging divergiu da candidata aprovada ({copied_candidate_digest} != {actual_candidate_digest})",
            )

        candidate_evidence_dir = staging_dir / "evidence" / "candidate"
        candidate_evidence_dir.mkdir(parents=True, exist_ok=True)
        shutil.move(staging_dir / "manifest.json", candidate_evidence_dir / "manifest.json")

        # Materializar evidências de deployment (declaration.json e resolved.json)
        dep_evidence_dir = staging_dir / "evidence" / "deployment"
        dep_evidence_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy(deployment_file, dep_evidence_dir / "declaration.json")

        dep_cli = INFRA_ROOT / "bin" / "sister-deployment"
        cmd_resolve = [str(dep_cli), "resolve", str(candidate_path / "manifest.json"), str(deployment_file), "--json"]
        r_resolve = subprocess.run(
            cmd_resolve,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if r_resolve.returncode != 0:
            raise ProductionError("DEPLOYMENT_RESOLVE_FAILED", f"falha ao resolver deployment: {r_resolve.stderr.strip()}")
        (dep_evidence_dir / "resolved.json").write_text(r_resolve.stdout, encoding="utf-8")

        # Gerar manifesto da release de produção
        manifest_doc = {
            "schema": "sister.infra.release/1.0.0",
            "release_id": target_release_id,
            "mode": "production",
            "created_at": datetime.now(timezone.utc).isoformat(),
            "candidate": {
                "candidate_id": candidate_id,
                "composition_id": plan_doc["candidate"]["composition_id"],
                "candidate_digest": actual_candidate_digest,
            },
            "deployment": {
                "deployment_id": plan_doc["deployment"]["deployment_id"],
                "evidence": "evidence/deployment/resolved.json",
            },
            "components": candidate_manifest.get("components", []),
            "tls": {
                "mode": "external",
                "fingerprint": tls_info["fingerprint"],
            },
        }
        (staging_dir / "manifest.json").write_text(json.dumps(manifest_doc, indent=2), encoding="utf-8")

        # Materialização atômica da release directory
        os.rename(staging_dir, target_release_dir)

        # Iniciar/Reconfigurar serviços necessários
        for change in fresh_plan.get("changes", []):
            cid = change.get("component_id")
            action = change.get("action")
            if action in ("ADD", "UPDATE"):
                comp_dir = target_release_dir / "components" / cid
                # Localizar entrypoint
                entrypoint = ""
                for mc in manifest_doc["components"]:
                    if mc.get("component_id") == cid:
                        entrypoint = mc.get("runtime", {}).get("entrypoint", "")
                        break

                resolved_dep_file = target_release_dir / "evidence" / "deployment" / "resolved.json"
                (fhs["run"] / cid).mkdir(parents=True, exist_ok=True)
                (fhs["state"] / cid).mkdir(parents=True, exist_ok=True)
                comp_env = os.environ.copy()
                comp_env["SISTER_RUNTIME_RUN_DIR"] = str(fhs["run"] / cid)
                comp_env["SISTER_RUNTIME_STATE_DIR"] = str(fhs["state"] / cid)
                comp_env["SISTER_RESOLVED_DEPLOYMENT_FILE"] = str(resolved_dep_file)
                comp_info = {
                    "c_path": comp_dir,
                    "entrypoint": entrypoint,
                    "env": comp_env,
                }
                service_mgr.start(f"sister-{cid}.service", comp_info)
                actions_applied.append({"component_id": cid, "action": action, "status": "STARTED"})

        # Reconciliar e materializar gateway HAProxy produtivo
        resolved_dep_file = target_release_dir / "evidence" / "deployment" / "resolved.json"
        reconcile_production_gateway(fhs, resolved_dep_file, service_mgr)

        # Factual health probes antes do commit
        resolved_doc = json.loads(resolved_dep_file.read_text(encoding="utf-8"))
        for comp in resolved_doc.get("components", []):
            cid = comp.get("component_id")
            probe = comp.get("probe") or {}
            health_path = probe.get("health_path")
            runtime = comp.get("runtime") or {}
            if health_path and runtime and not isinstance(service_mgr, MockServiceManager):
                healthy = False
                for _ in range(10):
                    if probe_component_health(runtime, health_path):
                        healthy = True
                        break
                    time.sleep(0.5)
                if not healthy:
                    raise ProductionError("HEALTH_PROBE_FAILED", f"sondagem de health check falhou no componente {cid} ({health_path})")

        if os.environ.get("SISTER_MOCK_FAIL_HEALTH") == "1":
            raise ProductionError("HEALTH_PROBE_FAILED", "sondagem de health check falhou no participante")

        unit_names = [
            f"sister-{component.get('component_id')}.service"
            for component in manifest_doc["components"]
        ] + ["sister-gateway.service"]
        inactive_units = [unit for unit in unit_names if not service_mgr.is_active(unit)]
        if inactive_units:
            raise ProductionError(
                "SERVICE_NOT_ACTIVE",
                f"gerenciador não confirmou ACTIVE para todas as units: {inactive_units}",
            )

        # Commit Point atômico (PRD-020)
        current_symlink = fhs["current"]
        previous_symlink = fhs["previous"]
        tmp_link = fhs["opt"] / f".tmp-current-{ts}"

        # Cria symlink temporário apontando para a nova release
        os.symlink(target_release_dir, tmp_link)

        # Se já existia um current, salva como previous
        if current_symlink.is_symlink() or current_symlink.exists():
            old_target = current_symlink.resolve()
            if previous_symlink.is_symlink() or previous_symlink.exists():
                previous_symlink.unlink()
            os.symlink(old_target, previous_symlink)

        # Troca atômica do current
        os.replace(tmp_link, current_symlink)

        rollback_needed = False

    except Exception as exc:
        if rollback_needed:
            # -----------------------------------------------------------------
            # 6. Rollback Handler (PRD-013, PRD-021)
            # -----------------------------------------------------------------
            for act in actions_applied:
                try:
                    service_mgr.stop(f"sister-{act['component_id']}.service")
                except Exception:
                    pass

            if previous_release_dir and previous_release_dir.exists():
                try:
                    if fhs["current"].is_symlink():
                        fhs["current"].unlink()
                    os.symlink(previous_release_dir, fhs["current"])
                except Exception:
                    pass

            evidence_dir = fhs["evidence"]
            evidence_dir.mkdir(parents=True, exist_ok=True)
            rollback_evidence = {
                "schema": "sister.infra.production.evidence/1.0.0",
                "timestamp": datetime.now(timezone.utc).isoformat(),
                "status": "ROLLBACK",
                "plan_digest": expected_digest,
                "error": str(exc),
                "actions_attempted": actions_applied,
                "rollback_completed": True,
            }
            rb_file = evidence_dir / f"audit-rollback-{ts}-{expected_digest.replace(':', '_')}.json"
            rb_file.write_text(json.dumps(rollback_evidence, indent=2), encoding="utf-8")

            if staging_dir.exists():
                shutil.rmtree(staging_dir, ignore_errors=True)
            if target_release_dir.exists():
                shutil.rmtree(target_release_dir, ignore_errors=True)

            raise ProductionRollbackError(
                "TRANSACTION_ROLLED_BACK",
                f"falha durante implantação produtiva; rollback executado com sucesso: {exc}",
            ) from exc
        raise

    # -------------------------------------------------------------------------
    # 7. Gravação de Evidência Auditável de Sucesso (PRD-014)
    # -------------------------------------------------------------------------
    evidence_dir = fhs["evidence"]
    evidence_dir.mkdir(parents=True, exist_ok=True)
    audit_evidence = {
        "schema": "sister.infra.production.evidence/1.0.0",
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "status": "APPLIED",
        "plan_digest": expected_digest,
        "candidate_id": candidate_id,
        "candidate_digest": actual_candidate_digest,
        "deployment_id": plan_doc["deployment"]["deployment_id"],
        "release_id": target_release_id,
        "actions_applied": actions_applied,
        "tls": tls_info,
        "dns": dns_info,
        "verification": {"status": "PASS", "details": "implantação transacional concluída com sucesso"},
        "service_witness": build_service_witness(fhs, service_mgr, unit_names),
    }
    evidence_file = evidence_dir / f"audit-{ts}-{expected_digest.replace(':', '_')}.json"
    evidence_file.write_text(json.dumps(audit_evidence, indent=2), encoding="utf-8")

    return audit_evidence


# -----------------------------------------------------------------------------
# 6. Production Verify (PRD-020, PRD-023)
# -----------------------------------------------------------------------------

def execute_production_verify(fhs: dict[str, Path] | None = None) -> dict[str, Any]:
    """Validação estritamente read-only do estado de produção (PRD-020)."""
    if fhs is None:
        fhs = get_fhs_paths()

    current_link = fhs["current"]
    if not current_link.is_symlink() and not current_link.is_dir():
        raise ProductionError("VERIFY_FAILED", f"link 'current' ausente em {current_link}")

    current_dir = current_link.resolve()
    manifest_file = current_dir / "manifest.json"
    if not manifest_file.is_file():
        raise ProductionError("VERIFY_FAILED", f"manifest.json ausente na release atual: {current_dir}")

    manifest = json.loads(manifest_file.read_text(encoding="utf-8"))

    ev_rel = manifest.get("deployment", {}).get("evidence")
    if not ev_rel or not (current_dir / ev_rel).is_file():
        raise ProductionError("VERIFY_FAILED", "evidência de deployment ausente na release atual")

    resolved_dep = json.loads((current_dir / ev_rel).read_text(encoding="utf-8"))

    service_mgr = get_service_manager(fhs)

    # 1. Validar se units dos componentes estão ativas
    components_status = {}
    for c in manifest.get("components", []):
        cid = c.get("component_id")
        unit_name = f"sister-{cid}.service"
        if not service_mgr.is_active(unit_name):
            raise ProductionError("VERIFY_FAILED", f"serviço {unit_name} inativo")
        components_status[cid] = "ACTIVE"

    # 2. Validar se o gateway está ativo (se gerenciado via systemd)
    gateway_active = True
    if isinstance(service_mgr, SystemdServiceManager):
        if not service_mgr.is_active("sister-gateway.service"):
            raise ProductionError("VERIFY_FAILED", "serviço de gateway de produção (sister-gateway.service) inativo")

    # 3. Validar health probes dos componentes diretamente
    component_probes = {}
    for c in resolved_dep.get("components", []):
        cid = c.get("component_id")
        probe = c.get("probe") or {}
        health_path = probe.get("health_path")
        runtime = c.get("runtime") or {}
        if health_path and runtime and not isinstance(service_mgr, MockServiceManager):
            healthy = probe_component_health(runtime, health_path)
            if not healthy:
                raise ProductionError("VERIFY_FAILED", f"componente {cid} falhou no health probe direto em {health_path}")
            component_probes[cid] = "PASS"
        else:
            component_probes[cid] = "PASS (simulated)"

    # 4. Validar TLS
    tls_cert = Path(os.environ.get("PRODUCTION_TLS_CERT", str(fhs["tls"] / "ecosystem.crt"))).expanduser().resolve()
    tls_key = Path(os.environ.get("PRODUCTION_TLS_KEY", str(fhs["tls"] / "ecosystem.key"))).expanduser().resolve()
    declared_hosts = [
        c.get("gateway", {}).get("host")
        for c in resolved_dep.get("components", [])
        if c.get("gateway", {}).get("host")
    ]
    tls_info = validate_external_tls(tls_cert, tls_key, declared_hosts)

    # 5. Validar DNS
    gateway = resolved_dep.get("gateway") or {}
    expected_gw_target = (
        os.environ.get("SISTER_PRODUCTION_GATEWAY_LISTEN_ADDRESS", "").strip()
        or os.environ.get("GATEWAY_LISTEN_ADDRESS", "").strip()
        or gateway.get("listen")
    )
    if not expected_gw_target:
        raise ProductionError(
            "GATEWAY_BIND_MISSING",
            "deployment resolvido não identifica gateway.listen",
        )
    dns_info = check_dns_readiness(declared_hosts, expected_gw_target)

    # 6. Validar acessibilidade HTTPS de cada subdomínio via gateway
    subdomain_probes = {}
    gw_listen = expected_gw_target
    gw_port = int(os.environ.get("SISTER_PRODUCTION_GATEWAY_PORT", "").strip() or gateway.get("port", 443))
    for c in resolved_dep.get("components", []):
        cid = c.get("component_id")
        gw_entry = c.get("gateway") or {}
        host = gw_entry.get("host")
        probe = c.get("probe") or {}
        health_path = probe.get("health_path", "/")
        if host and not isinstance(service_mgr, MockServiceManager):
            accessible = probe_gateway_subdomain_https(gw_listen, gw_port, host, health_path, tls_cert_path=tls_cert)
            if not accessible:
                raise ProductionError("VERIFY_FAILED", f"subdomínio {host} inacessível via HTTPS no gateway ({health_path})")
            subdomain_probes[host] = "PASS"
        elif host:
            subdomain_probes[host] = "PASS (simulated)"

    if not fhs["state"].is_dir():
        raise ProductionError("VERIFY_FAILED", f"diretório de estado persistente ausente: {fhs['state']}")

    unit_names = [f"sister-{c.get('component_id')}.service" for c in manifest.get("components", [])]
    if isinstance(service_mgr, SystemdServiceManager):
        unit_names.append("sister-gateway.service")
    service_witness = build_service_witness(fhs, service_mgr, unit_names)

    return {
        "schema": "sister.infra.production.verify/1.0.0",
        "status": "PASS",
        "release_id": manifest.get("release_id"),
        "candidate_id": manifest.get("candidate", {}).get("candidate_id"),
        "candidate_digest": manifest.get("candidate", {}).get("candidate_digest"),
        "components_verified": len(manifest.get("components", [])),
        "components_status": components_status,
        "component_health_probes": component_probes,
        "subdomain_https_probes": subdomain_probes,
        "gateway_active": gateway_active,
        "tls": tls_info,
        "dns": dns_info,
        "current_path": str(current_dir),
        "service_witness": service_witness,
    }


# -----------------------------------------------------------------------------
# 7. CLI Entrypoint
# -----------------------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sister-production",
        description="Adaptador de produção e autoridade institucional de SisTer Infra (OPS-07).",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    # Plan
    plan_p = sub.add_parser("plan", help="Projeta plano de reconciliação de produção (estritamente read-only)")
    plan_p.add_argument("--desired-candidate", required=True, help="Diretório da candidata desejada verificada")
    plan_p.add_argument("--desired-deployment", required=True, help="Arquivo de deployment declarativo")
    plan_p.add_argument("--current-release", help="Release atual (opcional)")
    plan_p.add_argument("--out", help="Arquivo de destino para salvar o plano JSON selado")
    plan_p.add_argument("--json", action="store_true", help="Emite o plano no formato JSON padronizado")

    # Apply
    apply_p = sub.add_parser("apply", help="Aplica transacionalmente o plano aprovado sob autoridade")
    apply_p.add_argument("--plan", required=True, help="Arquivo do plano JSON gerado pelo production plan")
    apply_p.add_argument("--plan-digest", required=True, help="Digest SHA-256 criptográfico aprovado do plano")
    apply_p.add_argument("--json", action="store_true", help="Emite o resultado em JSON padronizado")

    # Verify
    verify_p = sub.add_parser("verify", help="Verifica o estado atual de produção (estritamente read-only)")
    verify_p.add_argument("--json", action="store_true", help="Emite a verificação em JSON")

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    fhs = get_fhs_paths()

    try:
        if args.command == "plan":
            cand = Path(args.desired_candidate).expanduser().resolve()
            dep = Path(args.desired_deployment).expanduser().resolve()
            cur = Path(args.current_release).expanduser().resolve() if args.current_release else None

            plan_doc = build_production_plan(cand, dep, cur, fhs=fhs)

            if args.out:
                out_path = Path(args.out).expanduser().resolve()
                out_path.parent.mkdir(parents=True, exist_ok=True)
                out_path.write_text(json.dumps(plan_doc, indent=2), encoding="utf-8")
                sha_file = out_path.with_suffix(out_path.suffix + ".sha256")
                sha_file.write_text(f"{plan_doc['plan_digest']}\n", encoding="utf-8")

            if args.json:
                print(json.dumps(plan_doc, indent=2))
            else:
                print("=== SisTer Infra — Production Plan (SEALED) ===")
                print(f"Digest:     {plan_doc['plan_digest']}")
                print(f"Candidate:  {plan_doc['candidate']['candidate_id']}")
                print(f"Deployment: {plan_doc['deployment']['deployment_id']}")
                print(f"Summary:    {plan_doc['summary']}")
                print("Changes:")
                for c in plan_doc.get("changes", []):
                    print(f"  [{c.get('action')}] {c.get('component_id')}: {c.get('reason')}")
            return 0

        elif args.command == "apply":
            plan_file = Path(args.plan).expanduser().resolve()
            evidence = execute_production_apply(plan_file, args.plan_digest, fhs=fhs)

            if args.json:
                print(json.dumps(evidence, indent=2))
            else:
                print(f"[PASS] Production apply concluído com status: {evidence['status']}")
                print(f"Digest:     {evidence.get('plan_digest')}")
                print(f"Release:    {evidence.get('release_id')}")
            return 0

        elif args.command == "verify":
            ver = execute_production_verify(fhs=fhs)
            if args.json:
                print(json.dumps(ver, indent=2))
            else:
                print(f"[PASS] Production verify: {ver['status']}")
                print(f"Release ativa: {ver['release_id']}")
                print(f"Componentes:   {ver['components_verified']}")
            return 0

        return 1

    except ProductionError as exc:
        if getattr(args, "json", False):
            doc = {
                "schema": "sister.infra.production.error/1.0.0",
                "status": "FAIL_CLOSED",
                "code": exc.code,
                "error": exc.message,
            }
            print(json.dumps(doc, indent=2))
        else:
            print(f"[FAIL] [{exc.code}] {exc.message}", file=sys.stderr)
        if exc.code == "INSTALLATION_LOCKED":
            return 4
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
