from __future__ import annotations

import argparse
import fcntl
import http.client
import json
import os
from pathlib import Path
import shlex
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import time
from typing import Any
import urllib.error
import urllib.request

try:
    import jsonschema
except ImportError as exc:
    raise SystemExit(
        "[FAIL] sister-reconcile requer o módulo Python jsonschema"
    ) from exc


INFRA_ROOT = Path(__file__).resolve().parents[1]
CANDIDATE_CLI = INFRA_ROOT / "bin" / "sister-candidate"
DEPLOYMENT_CLI = INFRA_ROOT / "bin" / "sister-deployment"
WORKSTATION_CLI = INFRA_ROOT / "bin" / "sister-workstation"
GATEWAY_CLI = INFRA_ROOT / "bin" / "sister-gateway"
PLAN_SCHEMA = "sister.infra.reconcile.plan/1"
APPLY_SCHEMA = "sister.infra.reconcile.apply/1"

# Runtime probes observe the local data plane directly and must not
# inherit ambient HTTP/HTTPS proxy configuration.
PROXYLESS_HTTP_OPENER = urllib.request.build_opener(
    urllib.request.ProxyHandler({})
)


class ReconcileError(RuntimeError):
    pass


def load_json(path: Path, label: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise ReconcileError(f"não foi possível ler {label}: {path}: {exc}") from exc
    except json.JSONDecodeError as exc:
        raise ReconcileError(
            f"JSON inválido em {label}: {path}:{exc.lineno}:{exc.colno}: {exc.msg}"
        ) from exc
    if not isinstance(value, dict):
        raise ReconcileError(f"{label} deve ser um objeto JSON: {path}")
    return value


def probe_runtime_endpoint(
    runtime: dict[str, Any],
    probe: dict[str, Any] | None,
    timeout_seconds: float = 1.0,
) -> tuple[bool, str]:
    transport = runtime.get("transport")
    health_path = probe.get("health_path") if probe else None

    if transport == "tcp":
        listen = runtime.get("listen", "127.0.0.1")
        port = runtime.get("port")
        if not port or not isinstance(port, int):
            return False, "invalid_or_missing_port"

        if not health_path:
            try:
                with socket.create_connection((listen, port), timeout=timeout_seconds):
                    return True, "port_open"
            except OSError as exc:
                return False, f"connection_refused: {exc}"
        else:
            url = f"http://{listen}:{port}{health_path}"
            req = urllib.request.Request(url, headers={"User-Agent": "sister-reconcile"})
            try:
                with PROXYLESS_HTTP_OPENER.open(req, timeout=timeout_seconds) as resp:
                    if resp.status == 200:
                        return True, "PASS (HTTP 200)"
                    return False, f"HTTP {resp.status}"
            except urllib.error.HTTPError as exc:
                return False, f"HTTP {exc.code}"
            except OSError as exc:
                return False, f"connection_failed: {exc}"
            except Exception as exc:
                return False, f"probe_failed: {exc}"

    elif transport == "unix":
        socket_path = runtime.get("socket")
        if not socket_path or not isinstance(socket_path, str):
            return False, "missing_socket_path"
        sock_p = Path(socket_path)
        if not sock_p.exists():
            return False, f"socket_absent: {socket_path}"

        if not health_path:
            return True, "socket_exists"

        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.settimeout(timeout_seconds)
            sock.connect(socket_path)
            req = f"GET {health_path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n"
            sock.sendall(req.encode("utf-8"))
            raw = sock.recv(4096)
            sock.close()
            if b"HTTP/1." in raw and (b" 200 " in raw or b" 200\r\n" in raw):
                return True, "PASS (HTTP 200)"
            return False, "HTTP response status is not 200"
        except Exception as exc:
            return False, f"socket_probe_failed: {exc}"

    return False, f"unsupported_transport: {transport}"


def load_current_state(
    current_release_arg: str | None,
    probe_runtime: bool = True,
    probe_override: dict[str, tuple[bool, str]] | None = None,
) -> dict[str, Any] | None:
    current_dir: Path | None = None

    if current_release_arg:
        path = Path(current_release_arg).expanduser().resolve()
        if path.is_file() and path.name == "manifest.json":
            current_dir = path.parent
        elif path.is_dir():
            current_dir = path
        else:
            raise ReconcileError(f"release current indicada inexistente: {path}")
    else:
        env_release = os.environ.get("SISTER_CURRENT_RELEASE")
        if env_release:
            current_dir = Path(env_release).expanduser().resolve()
        else:
            install_root = os.environ.get("SISTER_WORKSTATION_INSTALL_ROOT")
            if install_root:
                cand = Path(install_root).expanduser() / "current"
                if cand.is_symlink() or cand.is_dir():
                    current_dir = cand.resolve()
            else:
                default_cand = Path.home() / ".local" / "share" / "sister" / "current"
                if default_cand.is_symlink() or default_cand.is_dir():
                    current_dir = default_cand.resolve()

    if not current_dir or not current_dir.exists():
        return None

    manifest_file = current_dir / "manifest.json"
    if not manifest_file.is_file():
        raise ReconcileError(f"manifest.json ausente na release current: {current_dir}")

    manifest = load_json(manifest_file, "manifesto da release current")

    # Localiza o deployment resolvido da release atual
    deployment_evidence_rel = manifest.get("deployment", {}).get("evidence")
    if not deployment_evidence_rel:
        raise ReconcileError(f"manifesto current sem evidência de deployment: {manifest_file}")

    resolved_file = current_dir / deployment_evidence_rel
    if not resolved_file.is_file():
        raise ReconcileError(f"deployment resolvido ausente em current: {resolved_file}")

    resolved = load_json(resolved_file, "deployment resolvido da release current")

    # Mapeia componentes do deployment resolvido
    resolved_by_id: dict[str, dict[str, Any]] = {}
    for comp in resolved.get("components", []):
        cid = comp.get("component_id")
        if cid:
            resolved_by_id[cid] = comp

    # Observação factual do runtime
    observed_components: dict[str, dict[str, Any]] = {}
    for comp in manifest.get("components", []):
        cid = comp.get("component_id")
        if not cid:
            continue

        resolved_comp = resolved_by_id.get(cid, {})
        runtime = resolved_comp.get("runtime", comp.get("runtime", {}))
        probe = resolved_comp.get("probe")

        if probe_override and cid in probe_override:
            healthy, detail = probe_override[cid]
        elif probe_runtime:
            healthy, detail = probe_runtime_endpoint(runtime, probe)
        else:
            healthy, detail = None, "probe_unobserved"

        observed_components[cid] = {
            "component_id": cid,
            "system_id": comp.get("system_id"),
            "commit": comp.get("commit"),
            "path": comp.get("path"),
            "artifacts": comp.get("artifacts", []),
            "runtime": runtime,
            "probe": probe,
            "gateway": resolved_comp.get("gateway"),
            "factual_healthy": healthy,
            "factual_detail": detail,
        }

    return {
        "release_id": manifest.get("release_id", current_dir.name),
        "current_dir": str(current_dir),
        "manifest": manifest,
        "resolved_deployment": resolved,
        "resolved_file": str(resolved_file),
        "components": observed_components,
    }


def verify_resolved_deployment_authority(
    candidate_manifest_path: Path,
    resolved_deployment_path: Path,
) -> dict[str, Any]:
    res = subprocess.run(
        [
            sys.executable,
            str(DEPLOYMENT_CLI),
            "verify",
            str(candidate_manifest_path),
            str(resolved_deployment_path),
            "--json",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if res.returncode != 0:
        err = res.stderr.strip() or res.stdout.strip()
        raise ReconcileError(
            f"deployment resolvido falhou na verificação de compatibilidade:\n{err}"
        )
    try:
        return json.loads(res.stdout)
    except json.JSONDecodeError as exc:
        raise ReconcileError(f"saída inválida de sister-deployment verify: {exc}") from exc


def extract_normalized_projection(
    components: dict[str, dict[str, Any]],
) -> dict[str, tuple[Any, ...]]:
    projection = {}
    for cid, c in components.items():
        rt = c.get("runtime") or {}
        pr = c.get("probe") or {}
        gw = c.get("gateway") or {}
        projection[cid] = (
            c.get("system_id"),
            rt.get("transport"),
            rt.get("listen"),
            rt.get("port"),
            rt.get("socket"),
            pr.get("health_path"),
            gw.get("host"),
            gw.get("public_url"),
        )
    return projection


def verify_candidate_authority(
    candidate_dir: Path,
    candidate_manifest: dict[str, Any],
) -> dict[str, Any]:
    schema = candidate_manifest.get("schema")
    if schema == "sister.infra.candidate/1":
        if not CANDIDATE_CLI.is_file():
            raise ReconcileError(
                f"autoridade sister-candidate não encontrada em {CANDIDATE_CLI}"
            )
        res = subprocess.run(
            [sys.executable, str(CANDIDATE_CLI), "verify", str(candidate_dir), "--json"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if res.returncode != 0:
            err = res.stderr.strip() or res.stdout.strip()
            raise ReconcileError(
                f"candidata desejada falhou na verificação autoritativa fail-closed:\n{err}"
            )
        try:
            return json.loads(res.stdout)
        except json.JSONDecodeError as exc:
            raise ReconcileError(
                f"saída JSON inválida de sister-candidate verify: {exc}"
            ) from exc
    elif schema == "sister.infra.workstation.candidate/1":
        if candidate_manifest.get("qualification", {}).get("status") != "PASS":
            raise ReconcileError("candidata legado sem qualificação PASS")
        return candidate_manifest
    else:
        raise ReconcileError(f"schema de candidata não suportado: {schema!r}")


def load_desired_state(
    candidate_arg: str,
    deployment_arg: str,
) -> dict[str, Any]:
    cand_path = Path(candidate_arg).expanduser().resolve()
    if cand_path.is_file() and cand_path.name == "manifest.json":
        candidate_dir = cand_path.parent
        cand_manifest_file = cand_path
    elif cand_path.is_dir():
        candidate_dir = cand_path
        cand_manifest_file = candidate_dir / "manifest.json"
    else:
        raise ReconcileError(f"candidata desejada inexistente: {cand_path}")

    if not cand_manifest_file.is_file():
        raise ReconcileError(f"manifest.json ausente na candidata: {cand_manifest_file}")

    raw_manifest = load_json(cand_manifest_file, "manifesto da candidata desejada")
    candidate_manifest = verify_candidate_authority(candidate_dir, raw_manifest)

    dep_path = Path(deployment_arg).expanduser().resolve()
    if not dep_path.is_file():
        raise ReconcileError(f"arquivo de deployment desejado inexistente: {dep_path}")

    dep_doc = load_json(dep_path, "deployment desejado")

    # Se o deployment informado já estiver resolvido (READY), utiliza e verifica diretamente.
    if dep_doc.get("schema") == "sister.infra.deployment.resolved/1":
        resolved_deployment = dep_doc
        resolved_file_path = dep_path
        # Validação fail-closed de compatibilidade entre deployment resolvido e candidata
        verify_resolved_deployment_authority(cand_manifest_file, dep_path)
    elif dep_doc.get("schema") == "sister.infra.deployment/1.0.0":
        # Resolve utilizando sister-deployment
        res = subprocess.run(
            [sys.executable, str(DEPLOYMENT_CLI), "resolve", str(cand_manifest_file), str(dep_path), "--json"],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if res.returncode != 0:
            err = res.stderr.strip() or res.stdout.strip()
            raise ReconcileError(f"falha ao resolver deployment desejado:\n{err}")
        try:
            resolved_deployment = json.loads(res.stdout)
        except json.JSONDecodeError as exc:
            raise ReconcileError(f"resolução de deployment produziu JSON inválido: {exc}") from exc
        resolved_file_path = None
    else:
        raise ReconcileError(f"schema de deployment não reconhecido: {dep_doc.get('schema')}")

    resolved_by_id: dict[str, dict[str, Any]] = {}
    for comp in resolved_deployment.get("components", []):
        cid = comp.get("component_id")
        if cid:
            resolved_by_id[cid] = comp

    desired_components: dict[str, dict[str, Any]] = {}
    for comp in candidate_manifest.get("components", []):
        cid = comp.get("component_id")
        if not cid:
            continue
        resolved_comp = resolved_by_id.get(cid, {})
        desired_components[cid] = {
            "component_id": cid,
            "system_id": comp.get("system_id"),
            "commit": comp.get("commit"),
            "path": comp.get("path"),
            "artifacts": comp.get("artifacts", []),
            "runtime": resolved_comp.get("runtime", comp.get("runtime", {})),
            "probe": resolved_comp.get("probe"),
            "gateway": resolved_comp.get("gateway"),
        }

    return {
        "candidate_id": candidate_manifest.get("candidate_id", candidate_dir.name),
        "candidate_dir": str(candidate_dir),
        "candidate_manifest": candidate_manifest,
        "resolved_deployment": resolved_deployment,
        "resolved_file": str(resolved_file_path),
        "components": desired_components,
    }


def compute_plan(
    current: dict[str, Any] | None,
    desired: dict[str, Any],
    mode: str = "lab",
    probe_runtime: bool = True,
) -> dict[str, Any]:
    curr_components = current["components"] if current else {}
    des_components = desired["components"]

    all_cids = sorted(set(curr_components.keys()) | set(des_components.keys()))

    changes = []
    summary_counts = {
        "keep": 0,
        "add": 0,
        "update": 0,
        "remove": 0,
        "reconfigure": 0,
        "repair": 0,
    }

    for cid in all_cids:
        in_curr = cid in curr_components
        in_des = cid in des_components

        if in_des and not in_curr:
            # ADD
            des_c = des_components[cid]
            d_commit = des_c.get("commit") or "-"
            changes.append({
                "component_id": cid,
                "system_id": des_c.get("system_id"),
                "current_commit": "-",
                "desired_commit": d_commit,
                "action": "ADD",
                "factual_status": "unobserved",
                "reason": "desired participant absent from current state",
            })
            summary_counts["add"] += 1

        elif in_curr and not in_des:
            # REMOVE
            curr_c = curr_components[cid]
            c_commit = curr_c.get("commit") or "-"
            f_healthy = curr_c.get("factual_healthy")
            f_status = "healthy" if f_healthy is True else ("unhealthy" if f_healthy is False else "unobserved")
            changes.append({
                "component_id": cid,
                "system_id": curr_c.get("system_id"),
                "current_commit": c_commit,
                "desired_commit": "-",
                "action": "REMOVE",
                "factual_status": f_status,
                "reason": "participant absent from desired candidate",
            })
            summary_counts["remove"] += 1

        else:
            # Presente em ambos
            curr_c = curr_components[cid]
            des_c = des_components[cid]
            c_commit = curr_c.get("commit") or "-"
            d_commit = des_c.get("commit") or "-"
            factual_healthy = curr_c.get("factual_healthy")
            factual_detail = curr_c.get("factual_detail", "")
            f_status = "healthy" if factual_healthy is True else ("unhealthy" if factual_healthy is False else "unobserved")

            c_artifacts = {a["id"]: a.get("sha256") for a in curr_c.get("artifacts", [])}
            d_artifacts = {a["id"]: a.get("sha256") for a in des_c.get("artifacts", [])}

            c_binding = curr_c.get("runtime", {})
            d_binding = des_c.get("runtime", {})
            c_probe = curr_c.get("probe", {})
            d_probe = des_c.get("probe", {})
            c_gw = curr_c.get("gateway", {})
            d_gw = des_c.get("gateway", {})

            # 1. Alteração desejada de código/commit
            if c_commit != d_commit:
                action = "UPDATE"
                c_short = c_commit[:12] if len(c_commit) >= 12 else c_commit
                d_short = d_commit[:12] if len(d_commit) >= 12 else d_commit
                reason = f"desired commit differs (current={c_short}, desired={d_short})"
                summary_counts["update"] += 1

            # 2. Alteração desejada de hashes de artefatos
            elif c_artifacts != d_artifacts:
                action = "UPDATE"
                reason = "component artifact hashes differ"
                summary_counts["update"] += 1

            # 3. Alteração desejada de configuração física/runtime/gateway (precedência estrita sobre REPAIR)
            elif c_binding != d_binding or c_probe != d_probe or c_gw != d_gw:
                action = "RECONFIGURE"
                reason = "runtime transport, endpoint or gateway configuration changed"
                summary_counts["reconfigure"] += 1

            # 4. Estado estrutural desejado == atual, mas observação factual divergiu (REPAIR estrito)
            elif factual_healthy is False:
                action = "REPAIR"
                reason = f"declared current matches desired structurally, but factual health probe failed ({factual_detail})"
                summary_counts["repair"] += 1

            # 5. Estado estrutural desejado == atual e observação factual não divergente (KEEP)
            else:
                action = "KEEP"
                if factual_healthy is True:
                    reason = "desired and current identity, commit, artifacts and binding match; runtime probe healthy"
                else:
                    reason = "desired and current identity, commit, artifacts and binding match; runtime probe unobserved (--no-probe-runtime)"
                summary_counts["keep"] += 1

            changes.append({
                "component_id": cid,
                "system_id": des_c.get("system_id", curr_c.get("system_id")),
                "current_commit": c_commit,
                "desired_commit": d_commit,
                "action": action,
                "factual_status": f_status,
                "reason": reason,
            })

    # Gateway diff
    curr_gw_routes = {}
    if current and "resolved_deployment" in current:
        for c in current["resolved_deployment"].get("components", []):
            if c.get("gateway"):
                curr_gw_routes[c["component_id"]] = c["gateway"]

    des_gw_routes = {}
    for c in desired["resolved_deployment"].get("components", []):
        if c.get("gateway"):
            des_gw_routes[c["component_id"]] = c["gateway"]

    if curr_gw_routes == des_gw_routes:
        gw_action = "KEEP"
        gw_reason = "gateway routes and listeners unchanged"
    else:
        gw_action = "RECONFIGURE"
        gw_reason = "gateway routing or published hosts differ"

    # Ecosystem projection diff (normalizado pelos campos efetivamente projetados)
    curr_proj = extract_normalized_projection(curr_components)
    des_proj = extract_normalized_projection(des_components)
    if curr_proj == des_proj:
        proj_action = "KEEP"
        proj_reason = "ecosystem projection unchanged"
    else:
        proj_action = "REFRESH"
        proj_reason = "ecosystem participants or runtime projections changed"

    plan = {
        "schema": PLAN_SCHEMA,
        "mode": mode,
        "runtime_observation": "active" if probe_runtime else "unobserved",
        "current": {
            "release_id": current.get("release_id", "-") if current else "-",
            "deployment_id": (
                current.get("resolved_deployment", {}).get("deployment_id", "-")
                if current else "-"
            ),
        },
        "desired": {
            "candidate_id": desired.get("candidate_id", "-"),
            "deployment_id": (
                desired.get("resolved_deployment", {}).get("deployment_id", "-")
            ),
        },
        "changes": changes,
        "gateway": {
            "action": gw_action,
            "reason": gw_reason,
        },
        "projection": {
            "action": proj_action,
            "reason": proj_reason,
        },
        "summary": summary_counts,
    }

    return plan


def render_human_plan(plan: dict[str, Any]) -> str:
    lines = []
    lines.append(f"=== SisTer Infra — Reconcile Plan ({plan['mode']}) ===")
    lines.append(f"Current release:    {plan['current']['release_id']}")
    lines.append(f"Desired candidate:  {plan['desired']['candidate_id']}")
    lines.append(f"Desired deployment: {plan['desired']['deployment_id']}")
    lines.append("")

    header = f"{'COMPONENT':<12} {'CURRENT':<14} {'DESIRED':<14} {'ACTION':<12} {'REASON'}"
    lines.append(header)
    lines.append("-" * len(header))

    for item in plan["changes"]:
        cid = item["component_id"]
        c_short = item["current_commit"]
        if c_short != "-" and len(c_short) > 12:
            c_short = c_short[:12]
        d_short = item["desired_commit"]
        if d_short != "-" and len(d_short) > 12:
            d_short = d_short[:12]
        action = item["action"]
        reason = item["reason"]

        lines.append(f"{cid:<12} {c_short:<14} {d_short:<14} {action:<12} {reason}")

    lines.append("")
    lines.append(f"{'DERIVED RESOURCE':<18} {'ACTION':<12} {'REASON'}")
    lines.append("-" * 50)
    lines.append(f"{'gateway':<18} {plan['gateway']['action']:<12} {plan['gateway']['reason']}")
    lines.append(f"{'projection':<18} {plan['projection']['action']:<12} {plan['projection']['reason']}")

    s = plan["summary"]
    lines.append("")
    lines.append(
        f"Summary: {s['keep']} KEEP, {s['add']} ADD, {s['update']} UPDATE, "
        f"{s['remove']} REMOVE, {s['reconfigure']} RECONFIGURE, {s['repair']} REPAIR"
    )
    lines.append("Plan only: no operational changes performed.")
    return "\n".join(lines)


def render_human_apply(result: dict[str, Any]) -> str:
    lines = [
        f"=== SisTer Infra — Reconcile Apply ({result.get('mode', 'lab')}) ===",
        f"Status: {result.get('status')}",
    ]
    if result.get("status") == "NO_OP":
        lines.append("[NO-OP] Todos os componentes estão KEEP. Nenhuma alteração necessária.")
        return "\n".join(lines)

    executed = result.get("executed_changes", [])
    if executed:
        lines.append("\nAções executadas:")
        for ch in executed:
            lines.append(
                f"  [{ch['action']}] {ch['component_id']}: {ch['status']} ({ch.get('detail', '')})"
            )

    untouched = result.get("untouched_components", [])
    if untouched:
        lines.append(f"\nComponentes preservados (KEEP): {', '.join(untouched)}")

    summ = result.get("summary", {})
    lines.append(
        f"\nResumo: {summ.get('add', 0)} ADD, {summ.get('update', 0)} UPDATE, "
        f"{summ.get('remove', 0)} REMOVE, {summ.get('repair', 0)} REPAIR, "
        f"{summ.get('keep', 0)} KEEP"
    )
    return "\n".join(lines)


def invoke_component_action(
    base_dir: Path,
    comp: dict[str, Any],
    action: str,
    resolved_file: Path,
    state_root: Path | None = None,
    config_root: Path | None = None,
) -> subprocess.CompletedProcess[str]:
    cid = comp["component_id"]
    comp_path = comp.get("path", f"components/{cid}")
    root = base_dir / comp_path
    entrypoint_rel = comp.get("runtime", {}).get("entrypoint", "scripts/runtime.sh")
    entrypoint = root / entrypoint_rel

    if not entrypoint.is_file():
        raise ReconcileError(f"entrypoint ausente para componente '{cid}': {entrypoint}")
    if not os.access(entrypoint, os.X_OK):
        raise ReconcileError(f"entrypoint não executável para componente '{cid}': {entrypoint}")

    if not state_root:
        state_root = Path(
            os.environ.get("SISTER_WORKSTATION_STATE_ROOT", "~/.local/state/sister/workstation")
        ).expanduser().resolve()
    if not config_root:
        config_root = Path(
            os.environ.get("SISTER_WORKSTATION_CONFIG_ROOT", "~/.config/sister/workstation")
        ).expanduser().resolve()

    comp_state_dir = state_root / "components" / cid
    comp_run_dir = state_root / "run" / cid
    comp_state_dir.mkdir(parents=True, exist_ok=True)
    comp_run_dir.mkdir(parents=True, exist_ok=True)

    config_file = config_root / f"{cid}.env"

    env = dict(os.environ)
    env["SISTER_RESOLVED_DEPLOYMENT_FILE"] = str(resolved_file)
    env["SISTER_COMPONENT_CONFIG_FILE"] = str(config_file)
    env["SISTER_RUNTIME_STATE_DIR"] = str(comp_state_dir)
    env["SISTER_RUNTIME_RUN_DIR"] = str(comp_run_dir)

    return subprocess.run(
        [str(entrypoint), action],
        cwd=str(root),
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def verify_component_health(
    base_dir: Path,
    comp: dict[str, Any],
    resolved_file: Path,
    runtime_binding: dict[str, Any],
    probe_config: dict[str, Any] | None,
    state_root: Path | None = None,
    config_root: Path | None = None,
    max_attempts: int = 10,
    delay_seconds: float = 0.2,
) -> tuple[bool, str]:
    import time
    last_err = "health_check_failed"
    for _ in range(max_attempts):
        h_res = invoke_component_action(
            base_dir, comp, "health", resolved_file, state_root=state_root, config_root=config_root
        )
        p_ok, p_detail = probe_runtime_endpoint(runtime_binding, probe_config)
        if h_res.returncode == 0 and p_ok:
            return True, "PASS"
        last_err = f"entrypoint_rc={h_res.returncode}, probe={p_detail}"
        time.sleep(delay_seconds)
    return False, last_err


class ReconcileLock:
    def __init__(self, state_root: Path):
        self.lock_dir = state_root / "locks"
        self.lock_file = self.lock_dir / "workstation-lifecycle.lock"
        self._fd: int | None = None

    def __enter__(self) -> "ReconcileLock":
        self.lock_dir.mkdir(parents=True, exist_ok=True)
        try:
            self._fd = os.open(
                str(self.lock_file),
                os.O_CREAT | os.O_RDWR,
                0o600,
            )
            fcntl.flock(self._fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.set_inheritable(self._fd, True)
            os.environ["SISTER_WORKSTATION_LOCK_FD"] = str(self._fd)
        except (BlockingIOError, OSError) as exc:
            if self._fd is not None:
                try:
                    os.close(self._fd)
                except OSError:
                    pass
                self._fd = None
            raise ReconcileError(
                f"outra operação de lifecycle está em execução (lock ativo em {self.lock_file})"
            ) from exc
        return self

    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:
        if "SISTER_WORKSTATION_LOCK_FD" in os.environ:
            del os.environ["SISTER_WORKSTATION_LOCK_FD"]
        if self._fd is not None:
            try:
                fcntl.flock(self._fd, fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                os.close(self._fd)
            except OSError:
                pass
            self._fd = None


class TransactionContext:
    def __init__(self) -> None:
        self.old_leaf_bytes: bytes | None = None
        self.old_gateway_cfg: str | None = None
        self.old_projection_tsv: str | None = None
        self.pid_old_gateway: int | None = None
        self.pid_target_gateway: int | None = None
        self.switched_release: bool = False
        self.components_rollback_stack: list[tuple[Any, ...]] = []


def is_pid_alive(pid: int | None) -> bool:
    if not pid or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def get_tls_paths(config_root: Path) -> tuple[Path, Path, Path]:
    tls_pem_str = os.environ.get("TLS_PEM")
    ca_cert_str = os.environ.get("CA_CERT")
    ca_key_str = os.environ.get("CA_KEY")

    tls_pem = Path(tls_pem_str).expanduser().resolve() if tls_pem_str else (config_root / "tls" / "ecosystem-lab.pem")
    ca_cert = Path(ca_cert_str).expanduser().resolve() if ca_cert_str else (config_root / "tls" / "ecosystem-lab-ca.crt")
    ca_key = Path(ca_key_str).expanduser().resolve() if ca_key_str else (config_root / "tls" / "ecosystem-lab-ca.key")

    if not tls_pem.is_file() and (INFRA_ROOT / "secrets" / "ecosystem-lab.pem").is_file():
        tls_pem = (INFRA_ROOT / "secrets" / "ecosystem-lab.pem").resolve()
    if not ca_cert.is_file() and (INFRA_ROOT / "secrets" / "ecosystem-lab-ca.crt").is_file():
        ca_cert = (INFRA_ROOT / "secrets" / "ecosystem-lab-ca.crt").resolve()
    if not ca_key.is_file() and (INFRA_ROOT / "secrets" / "ecosystem-lab-ca.key").is_file():
        ca_key = (INFRA_ROOT / "secrets" / "ecosystem-lab-ca.key").resolve()

    return tls_pem, ca_cert, ca_key


def check_ca_valid(ca_cert: Path, ca_key: Path, renew_before_sec: int = 2592000) -> bool:
    if not ca_cert.is_file() or not ca_key.is_file():
        return False
    res = subprocess.run(
        ["openssl", "x509", "-in", str(ca_cert), "-noout", "-checkend", str(renew_before_sec)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if res.returncode != 0:
        return False
    res1 = subprocess.run(
        ["openssl", "x509", "-in", str(ca_cert), "-pubkey", "-noout"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    res2 = subprocess.run(
        ["openssl", "pkey", "-in", str(ca_key), "-pubout"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if res1.returncode != 0 or res2.returncode != 0:
        return False
    return res1.stdout.strip() == res2.stdout.strip() and len(res1.stdout.strip()) > 0


def get_cert_sans(tls_pem: Path) -> set[str]:
    if not tls_pem.is_file():
        return set()
    res = subprocess.run(
        ["openssl", "x509", "-in", str(tls_pem), "-noout", "-ext", "subjectAltName"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if res.returncode != 0:
        return set()
    sans = set()
    for item in res.stdout.replace(",", "\n").splitlines():
        item = item.strip()
        if item.startswith("DNS:"):
            sans.add(item[4:].strip())
    return sans


def generate_leaf_certificate(
    tls_pem: Path,
    ca_cert: Path,
    ca_key: Path,
    hosts: list[str],
) -> None:
    if not hosts:
        raise ReconcileError("nenhum host configurado para emissão de certificado TLS")
    tls_pem.parent.mkdir(parents=True, exist_ok=True)

    with tempfile.TemporaryDirectory(dir=tls_pem.parent) as td:
        tmp_dir = Path(td)
        key_file = tmp_dir / "gateway.key"
        csr_file = tmp_dir / "gateway.csr"
        crt_file = tmp_dir / "gateway.crt"
        ext_file = tmp_dir / "ext.cnf"
        cnf_file = tmp_dir / "openssl.cnf"

        res = subprocess.run(
            ["openssl", "genrsa", "-out", str(key_file), "3072"],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if res.returncode != 0:
            raise ReconcileError(f"falha ao gerar chave privada TLS: {res.stderr.decode('utf-8', 'replace')}")

        cnf_lines = [
            "[req]",
            "prompt = no",
            "distinguished_name = dn",
            "req_extensions = req_ext",
            "",
            "[dn]",
            f"CN = {hosts[0]}",
            "",
            "[req_ext]",
            "subjectAltName = @alt_names",
            "",
            "[alt_names]",
        ]
        for i, h in enumerate(hosts, start=1):
            cnf_lines.append(f"DNS.{i} = {h}")
        cnf_file.write_text("\n".join(cnf_lines) + "\n", encoding="utf-8")

        res = subprocess.run(
            ["openssl", "req", "-new", "-key", str(key_file), "-out", str(csr_file), "-config", str(cnf_file)],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if res.returncode != 0:
            raise ReconcileError(f"falha ao gerar CSR TLS: {res.stderr.decode('utf-8', 'replace')}")

        san_str = ",".join(f"DNS:{h}" for h in hosts)
        ext_lines = [
            f"subjectAltName={san_str}",
            "extendedKeyUsage=serverAuth",
            "keyUsage=digitalSignature,keyEncipherment",
        ]
        ext_file.write_text("\n".join(ext_lines) + "\n", encoding="utf-8")

        res = subprocess.run(
            [
                "openssl", "x509", "-req",
                "-in", str(csr_file),
                "-CA", str(ca_cert),
                "-CAkey", str(ca_key),
                "-CAcreateserial",
                "-out", str(crt_file),
                "-days", "825",
                "-sha256",
                "-extfile", str(ext_file),
            ],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        if res.returncode != 0:
            raise ReconcileError(f"falha ao assinar certificado TLS com a CA: {res.stderr.decode('utf-8', 'replace')}")

        pem_content = crt_file.read_bytes() + b"\n" + key_file.read_bytes() + b"\n"

        tmp_pem = tls_pem.with_suffix(f".tmp.{os.getpid()}_{time.time_ns()}")
        try:
            tmp_pem.write_bytes(pem_content)
            tmp_pem.chmod(0o600)
            os.replace(tmp_pem, tls_pem)
        finally:
            if tmp_pem.exists():
                try:
                    tmp_pem.unlink()
                except OSError:
                    pass


def get_gateway_paths(
    state_root: Path,
    config_root: Path,
) -> tuple[Path, Path, str, int]:
    cfg_p = Path(os.environ.get("GATEWAY_CFG", state_root / "control-plane" / "gateway" / "haproxy-lan.cfg")).expanduser().resolve()
    pid_p = Path(os.environ.get("GATEWAY_PID", state_root / "control-plane" / "gateway" / "haproxy-lan.pid")).expanduser().resolve()
    listen_addr = os.environ.get("GATEWAY_LISTEN_ADDRESS", "127.0.0.1")
    listen_port = int(os.environ.get("GATEWAY_LISTEN_PORT", "8443"))
    return cfg_p, pid_p, listen_addr, listen_port


def find_haproxy_bin() -> str:
    for candidate in [
        os.environ.get("HAPROXY_BIN"),
        "/usr/local/sbin/haproxy-3.2.22",
        shutil.which("haproxy"),
    ]:
        if candidate and os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return candidate
    raise ReconcileError("binário do HAProxy não encontrado em HAPROXY_BIN nem no PATH")


def render_haproxy_config(
    resolved_deployment_file: Path,
    listen_address: str,
    listen_port: int,
    tls_pem: Path,
) -> str:
    res = subprocess.run([
        sys.executable,
        str(GATEWAY_CLI),
        "render",
        str(resolved_deployment_file),
        "--listen-address", listen_address,
        "--listen-port", str(listen_port),
        "--tls-pem", str(tls_pem),
    ], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if res.returncode != 0:
        raise ReconcileError(f"falha ao renderizar configuração HAProxy: {res.stderr.strip()}")
    return res.stdout


def validate_haproxy_config(haproxy_bin: str, cfg_content: str, parent_dir: Path) -> None:
    parent_dir.mkdir(parents=True, exist_ok=True)
    tmp_cfg = parent_dir / f"haproxy.chk.{os.getpid()}_{time.time_ns()}.cfg"
    try:
        tmp_cfg.write_text(cfg_content, encoding="utf-8")
        res = subprocess.run(
            [haproxy_bin, "-c", "-f", str(tmp_cfg)],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=False,
        )
        if res.returncode != 0:
            raise ReconcileError(f"configuração HAProxy inválida (haproxy -c): {res.stderr.strip() or res.stdout.strip()}")
    finally:
        if tmp_cfg.exists():
            try:
                tmp_cfg.unlink()
            except OSError:
                pass


def get_gateway_pid(pid_file: Path) -> int | None:
    if pid_file.is_file():
        try:
            val = int(pid_file.read_text(encoding="utf-8").strip())
            if is_pid_alive(val):
                return val
        except (ValueError, OSError):
            pass
    return None


def reload_haproxy_gracefully(
    haproxy_bin: str,
    cfg_file: Path,
    pid_file: Path,
    pid_old: int | None = None,
) -> int:
    cfg_file.parent.mkdir(parents=True, exist_ok=True)
    pid_file.parent.mkdir(parents=True, exist_ok=True)

    cmd = [haproxy_bin, "-D", "-f", str(cfg_file), "-p", str(pid_file)]
    if pid_old and is_pid_alive(pid_old):
        cmd.extend(["-sf", str(pid_old)])

    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if res.returncode != 0:
        raise ReconcileError(f"falha ao executar HAProxy reload: {res.stderr.strip() or res.stdout.strip()}")

    deadline = time.monotonic() + 5.0
    new_pid = None
    while time.monotonic() < deadline:
        candidate_pid = get_gateway_pid(pid_file)
        if candidate_pid and (pid_old is None or candidate_pid != pid_old):
            new_pid = candidate_pid
            break
        elif candidate_pid and is_pid_alive(candidate_pid):
            new_pid = candidate_pid
        time.sleep(0.05)

    if not new_pid:
        raise ReconcileError("HAProxy não permaneceu ativo após reload")
    return new_pid


def verify_gateway_urls(
    resolved_doc: dict[str, Any],
    listen_address: str,
    listen_port: int,
    ca_cert: Path,
    timeout: float = 5.0,
) -> tuple[bool, str]:
    import http.client
    import ssl

    class SNIHTTPSConnection(http.client.HTTPSConnection):
        def __init__(self, ip: str, port: int, server_hostname: str, context: ssl.SSLContext, timeout: float = 5.0):
            super().__init__(ip, port=port, context=context, timeout=timeout)
            self._sni_server_hostname = server_hostname

        def connect(self):
            super(http.client.HTTPSConnection, self).connect()
            self.sock = self._context.wrap_socket(self.sock, server_hostname=self._sni_server_hostname)

    ssl_ctx = ssl.create_default_context(cafile=str(ca_cert))

    for comp in resolved_doc.get("components", []):
        cid = comp.get("component_id", "")
        gw = comp.get("gateway")
        probe = comp.get("probe")
        if not gw or not probe:
            continue
        host = gw.get("host")
        health_path = probe.get("health_path")
        if not host or not health_path:
            continue

        try:
            conn = SNIHTTPSConnection(
                listen_address,
                port=listen_port,
                server_hostname=host,
                context=ssl_ctx,
                timeout=timeout,
            )
            conn.request("GET", health_path, headers={"Host": host, "User-Agent": "sister-reconcile", "Connection": "close"})
            resp = conn.getresponse()
            status = resp.status
            conn.close()
            if status != 200:
                return False, f"componente '{cid}' via gateway https://{host}:{listen_port}{health_path} retornou HTTP {status}"
        except Exception as exc:
            return False, f"componente '{cid}' via gateway https://{host}:{listen_port}{health_path} falhou: {exc}"

    return True, "OK"


def resolve_projection_file_path(
    state_root: Path,
    config_root: Path,
    current_components: dict[str, Any] | None = None,
    desired_components: dict[str, Any] | None = None,
) -> Path:
    # 1. SISTER_ECOSYSTEM_PROJECTION_FILE no ambiente
    env_p = os.environ.get("SISTER_ECOSYSTEM_PROJECTION_FILE")
    if env_p:
        return Path(env_p).expanduser().resolve()

    # 2. Configuração operacional instalada (runtime.env)
    runtime_env = config_root / "runtime.env"
    if runtime_env.is_file():
        for line in runtime_env.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line.startswith("SISTER_ECOSYSTEM_PROJECTION_FILE="):
                val = line.split("=", 1)[1].strip().strip('"').strip("'")
                if val:
                    return Path(val).expanduser().resolve()

    # 3. Default comprovadamente definido pelo runtime/contrato existente:
    # Procura se algum componente participante possui run_dir com projection file
    all_comps = {}
    if current_components:
        all_comps.update(current_components)
    if desired_components:
        all_comps.update(desired_components)

    for cid in all_comps:
        run_dir = state_root / "run" / cid
        if (run_dir / "ecosystem_projection.tsv").is_file():
            return (run_dir / "ecosystem_projection.tsv").resolve()

    raise ReconcileError(
        "autoridade da ecosystem projection não pôde ser determinada: "
        "defina SISTER_ECOSYSTEM_PROJECTION_FILE no ambiente ou configure runtime.env"
    )


def render_ecosystem_projection(resolved_doc: dict[str, Any]) -> str:
    comp_id = resolved_doc.get("composition_id", "")
    dep_id = resolved_doc.get("deployment_id", "")
    status = resolved_doc.get("status", "READY")
    lines = [f"META\t{comp_id}\t{dep_id}\t{status}"]
    for comp in resolved_doc.get("components", []):
        cid = comp.get("component_id", "")
        sid = comp.get("system_id", "")
        rt = comp.get("runtime", {})
        transport = rt.get("transport", "")
        listen = rt.get("listen", "")
        port = str(rt.get("port", 0)) if transport == "tcp" else ""
        probe = comp.get("probe", {})
        health_path = probe.get("health_path", "")
        gw = comp.get("gateway") or {}
        host = gw.get("host", "")
        pub_url = gw.get("public_url", "")
        lines.append(f"PARTICIPANT\t{cid}\t{sid}\t{transport}\t{listen}\t{port}\t{health_path}\t{host}\t{pub_url}")
    return "\n".join(lines) + "\n"


def refresh_ecosystem_projection(
    projection_file: Path,
    resolved_doc: dict[str, Any],
) -> None:
    tsv_content = render_ecosystem_projection(resolved_doc)
    projection_file.parent.mkdir(parents=True, exist_ok=True)
    tmp_file = projection_file.with_suffix(f".tmp.{os.getpid()}_{time.time_ns()}")
    try:
        tmp_file.write_text(tsv_content, encoding="utf-8")
        os.replace(tmp_file, projection_file)
    finally:
        if tmp_file.exists():
            try:
                tmp_file.unlink()
            except OSError:
                pass


def verify_ecosystem_observation(
    current_components: dict[str, Any],
    expected_participant_cids: set[str],
) -> tuple[bool, str]:
    for cid, comp in current_components.items():
        rt = comp.get("runtime", {})
        if rt.get("transport") != "tcp":
            continue
        listen = rt.get("listen", "127.0.0.1")
        port = rt.get("port")
        if not port:
            continue

        url = f"http://{listen}:{port}/api/ecosystem"
        req = urllib.request.Request(url, headers={"User-Agent": "sister-reconcile"})
        try:
            with PROXYLESS_HTTP_OPENER.open(req, timeout=1.0) as resp:
                if resp.status == 200:
                    data = json.loads(resp.read().decode("utf-8"))
                    systems = data.get("systems", [])
                    seen_cids = {s.get("componentId") for s in systems}
                    if not expected_participant_cids.issubset(seen_cids):
                        missing = expected_participant_cids - seen_cids
                        return False, f"ecosystem view em '{cid}' não projetou os participantes esperados: faltando {missing}"
                    return True, "OK"
        except Exception:
            continue

    return True, "nenhum endpoint /api/ecosystem ativo encontrado; observação dispensada"


def execute_apply(
    current_release_arg: str | None,
    desired_candidate_arg: str,
    desired_deployment_arg: str,
    mode: str = "lab",
    state_root: Path | None = None,
    config_root: Path | None = None,
) -> dict[str, Any]:
    if mode != "lab":
        raise ReconcileError(
            f"modo '{mode}' não autorizado para apply no ciclo OPS-04 (somente 'lab' é suportado)"
        )

    if not state_root:
        state_root = Path(
            os.environ.get("SISTER_WORKSTATION_STATE_ROOT", "~/.local/state/sister/workstation")
        ).expanduser().resolve()
    if not config_root:
        config_root = Path(
            os.environ.get("SISTER_WORKSTATION_CONFIG_ROOT", "~/.config/sister/workstation")
        ).expanduser().resolve()

    with ReconcileLock(state_root):
        # 1. OBSERVE & PLAN sob lock operacional
        current = load_current_state(current_release_arg, probe_runtime=True)
        if not current:
            raise ReconcileError("apply requer uma release current ativa declarada")

        desired = load_desired_state(desired_candidate_arg, desired_deployment_arg)
        plan = compute_plan(current, desired, mode=mode, probe_runtime=True)

        # 2. PREFLIGHT & AUTHORIZATION
        if plan["summary"]["reconfigure"] > 0:
            reconfig_cids = [c["component_id"] for c in plan["changes"] if c["action"] == "RECONFIGURE"]
            raise ReconcileError(
                f"apply recusado: RECONFIGURE de componentes não é suportado ({reconfig_cids})"
            )

        has_add = any(c["action"] == "ADD" for c in plan["changes"])
        has_remove = any(c["action"] == "REMOVE" for c in plan["changes"])
        has_update = any(c["action"] == "UPDATE" for c in plan["changes"])
        has_repair = any(c["action"] == "REPAIR" for c in plan["changes"])
        if has_repair and (has_add or has_remove or has_update):
            raise ReconcileError(
                "apply recusado: plano combina UPDATE e REPAIR no mesmo ciclo; "
                "combinação não autorizada (execute REPAIR primeiro ou isole o UPDATE)"
            )

        # 3. NO-OP CHECK
        active_changes = [c for c in plan["changes"] if c["action"] != "KEEP"]
        untouched = [c["component_id"] for c in plan["changes"] if c["action"] == "KEEP"]

        if not active_changes and plan["gateway"]["action"] == "KEEP" and plan["projection"]["action"] == "KEEP":
            return {
                "schema": APPLY_SCHEMA,
                "status": "NO_OP",
                "mode": mode,
                "executed_changes": [],
                "untouched_components": untouched,
                "summary": plan["summary"],
                "gateway": plan["gateway"],
                "projection": plan["projection"],
            }

        current_dir = Path(current["current_dir"])
        current_resolved_file = Path(current["resolved_file"])
        current_resolved_doc = load_json(current_resolved_file, "deployment atual resolvido")

        target_release_dir: Path | None = None
        target_resolved_file: Path | None = None
        target_resolved_doc: dict[str, Any] | None = None

        needs_target_release = (
            has_add
            or has_remove
            or has_update
            or plan["gateway"]["action"] != "KEEP"
            or plan["projection"]["action"] != "KEEP"
        )

        # 4. MATERIALIZE TARGET_RELEASE
        if needs_target_release:
            dep_doc = load_json(Path(desired_deployment_arg), "deployment desejado")
            if dep_doc.get("schema") != "sister.infra.deployment/1.0.0":
                raise ReconcileError(
                    f"apply com mutação de topologia/recursos requer deployment declarativo 'sister.infra.deployment/1.0.0' (obtido: {dep_doc.get('schema')})"
                )

            # 4a. Valida integridade da OLD_RELEASE
            verify_old = subprocess.run(
                [str(WORKSTATION_CLI), "release-verify", str(current_dir), "--json"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                close_fds=False,
                check=False,
            )
            if verify_old.returncode != 0:
                err = verify_old.stderr.strip() or verify_old.stdout.strip()
                raise ReconcileError(f"release atual (OLD_RELEASE) falhou na verificação de integridade: {err}")

            # 4b. Cria TARGET_RELEASE via sister-workstation release-create
            dep_arg = desired_deployment_arg
            create_res = subprocess.run(
                [
                    str(WORKSTATION_CLI),
                    "release-create",
                    "--candidate", str(desired["candidate_dir"]),
                    "--deployment", str(dep_arg),
                    "--json",
                ],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                close_fds=False,
                check=False,
            )
            if create_res.returncode != 0:
                err = create_res.stderr.strip() or create_res.stdout.strip()
                raise ReconcileError(f"falha ao materializar TARGET_RELEASE via sister-workstation: {err}")

            try:
                rel_info = json.loads(create_res.stdout)
            except json.JSONDecodeError as exc:
                raise ReconcileError(f"saída JSON inválida de release-create: {exc}") from exc

            target_release_dir = Path(rel_info["release_path"])
            target_resolved_file = target_release_dir / "evidence" / "deployment" / "resolved.json"
            target_resolved_doc = load_json(target_resolved_file, "deployment resolvido TARGET")

            # 4c. Valida integridade da TARGET_RELEASE recém-criada
            verify_target = subprocess.run(
                [str(WORKSTATION_CLI), "release-verify", str(target_release_dir), "--json"],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                close_fds=False,
                check=False,
            )
            if verify_target.returncode != 0:
                err = verify_target.stderr.strip() or verify_target.stdout.strip()
                raise ReconcileError(f"TARGET_RELEASE recém-criada falhou na verificação de integridade: {err}")

        # 5. CONTEXTO TRANSACIONAL (em memória, sem backups persistentes implícitos no disco)
        tx = TransactionContext()
        executed_changes = []

        tls_pem, ca_cert, ca_key = get_tls_paths(config_root)
        gateway_cfg, gateway_pid_file, gw_listen_addr, gw_listen_port = get_gateway_paths(state_root, config_root)
        if target_resolved_doc and "gateway" in target_resolved_doc:
            gw_listen_port = target_resolved_doc["gateway"].get("port", gw_listen_port)
            gw_listen_addr = target_resolved_doc["gateway"].get("listen", gw_listen_addr)

        projection_file: Path | None = None
        if plan["projection"]["action"] != "KEEP":
            projection_file = resolve_projection_file_path(state_root, config_root, current["components"], desired["components"])
            if projection_file.is_file():
                tx.old_projection_tsv = projection_file.read_text(encoding="utf-8")

        haproxy_bin: str | None = None
        if plan["gateway"]["action"] != "KEEP":
            haproxy_bin = find_haproxy_bin()
            if gateway_cfg.is_file():
                tx.old_gateway_cfg = gateway_cfg.read_text(encoding="utf-8")
            tx.pid_old_gateway = get_gateway_pid(gateway_pid_file)

        try:
            # -------------------------------------------------------------
            # FASE 1: EXPAND / ATIVAÇÃO DE RUNTIMES (ADD, UPDATE, REPAIR)
            # -------------------------------------------------------------
            for item in plan["changes"]:
                action = item["action"]
                cid = item["component_id"]

                if action == "ADD":
                    assert target_release_dir is not None
                    assert target_resolved_file is not None
                    des_comp = desired["components"][cid]
                    start_res = invoke_component_action(
                        target_release_dir, des_comp, "start", target_resolved_file,
                        state_root=state_root, config_root=config_root,
                    )
                    if start_res.returncode != 0:
                        err = start_res.stderr.strip() or start_res.stdout.strip()
                        raise ReconcileError(f"ADD falhou ao iniciar {cid} em TARGET_RELEASE: {err}")
                    tx.components_rollback_stack.append(("STARTED_ADD", des_comp, target_release_dir, target_resolved_file))

                    ok, detail = verify_component_health(
                        target_release_dir, des_comp, target_resolved_file,
                        des_comp["runtime"], des_comp.get("probe"),
                        state_root=state_root, config_root=config_root,
                    )
                    if not ok:
                        raise ReconcileError(f"ADD falhou no health check de {cid}: {detail}")

                    executed_changes.append({
                        "component_id": cid,
                        "action": "ADD",
                        "status": "SUCCESS",
                        "detail": "added to target release and verified healthy locally",
                        "reason": item["reason"],
                    })

                elif action == "UPDATE":
                    curr_comp = current["components"][cid]
                    des_comp = desired["components"][cid]

                    stop_res = invoke_component_action(
                        current_dir, curr_comp, "stop", current_resolved_file,
                        state_root=state_root, config_root=config_root,
                    )
                    if stop_res.returncode != 0:
                        err = stop_res.stderr.strip() or stop_res.stdout.strip()
                        raise ReconcileError(f"UPDATE falhou ao parar versão anterior de {cid}: {err}")
                    tx.components_rollback_stack.append(("STOPPED_OLD", curr_comp, current_dir, current_resolved_file))

                    assert target_release_dir is not None
                    assert target_resolved_file is not None
                    start_res = invoke_component_action(
                        target_release_dir, des_comp, "start", target_resolved_file,
                        state_root=state_root, config_root=config_root,
                    )
                    if start_res.returncode != 0:
                        err = start_res.stderr.strip() or start_res.stdout.strip()
                        raise ReconcileError(f"UPDATE falhou ao iniciar nova versão de {cid} na TARGET_RELEASE: {err}")
                    tx.components_rollback_stack.append(("STARTED_NEW", des_comp, target_release_dir, target_resolved_file))

                    ok, detail = verify_component_health(
                        target_release_dir, des_comp, target_resolved_file,
                        des_comp["runtime"], des_comp.get("probe"),
                        state_root=state_root, config_root=config_root,
                    )
                    if not ok:
                        raise ReconcileError(f"UPDATE falhou no health check da nova versão de {cid}: {detail}")

                    executed_changes.append({
                        "component_id": cid,
                        "action": "UPDATE",
                        "status": "SUCCESS",
                        "detail": "updated to target release version and verified healthy",
                        "reason": item["reason"],
                    })

                elif action == "REPAIR":
                    curr_comp = current["components"][cid]
                    start_res = invoke_component_action(
                        current_dir, curr_comp, "start", current_resolved_file,
                        state_root=state_root, config_root=config_root,
                    )
                    if start_res.returncode != 0:
                        err = start_res.stderr.strip() or start_res.stdout.strip()
                        raise ReconcileError(f"REPAIR falhou ao iniciar {cid}: {err}")

                    ok, detail = verify_component_health(
                        current_dir, curr_comp, current_resolved_file,
                        curr_comp["runtime"], curr_comp.get("probe"),
                        state_root=state_root, config_root=config_root,
                    )
                    if not ok:
                        raise ReconcileError(f"REPAIR falhou no health check de {cid}: {detail}")

                    executed_changes.append({
                        "component_id": cid,
                        "action": "REPAIR",
                        "status": "SUCCESS",
                        "detail": "restored drifted runtime and verified healthy",
                        "reason": item["reason"],
                    })

            # VERIFICA KEEP: componentes intocados preservam a saúde
            for cid in untouched:
                curr_comp = current["components"][cid]
                ok, detail = probe_runtime_endpoint(curr_comp["runtime"], curr_comp.get("probe"))
                if not ok:
                    raise ReconcileError(f"violação crítica: componente KEEP '{cid}' perdeu a saúde após mutação: {detail}")

            # -------------------------------------------------------------
            # FASE 2: PREPARE TLS & VALIDATE
            # -------------------------------------------------------------
            if target_resolved_doc and plan["gateway"]["action"] != "KEEP":
                desired_published_hosts = [
                    c["gateway"]["host"] for c in target_resolved_doc.get("components", [])
                    if c.get("gateway") and c["gateway"].get("host")
                ]
                current_sans = get_cert_sans(tls_pem)
                if set(desired_published_hosts) != current_sans:
                    if not check_ca_valid(ca_cert, ca_key):
                        raise ReconcileError(
                            "lab apply recusado: CA lab exige rotação (validade residual insuficiente ou CA ausente/inválida). "
                            "A rotação da CA de laboratório requer ação explícita de autoridade (ex: sister-infra bootstrap)."
                        )
                    ca_cert_bytes = ca_cert.read_bytes()
                    ca_key_bytes = ca_key.read_bytes()
                    if tls_pem.is_file():
                        tx.old_leaf_bytes = tls_pem.read_bytes()

                    generate_leaf_certificate(tls_pem, ca_cert, ca_key, sorted(set(desired_published_hosts)))

                    if ca_cert.read_bytes() != ca_cert_bytes or ca_key.read_bytes() != ca_key_bytes:
                        raise ReconcileError("violação crítica: CA_CERT ou CA_KEY foi modificado durante renovação de folha")

            # -------------------------------------------------------------
            # FASE 3: PREPARE GATEWAY & RELOAD GRACEFULLY
            # -------------------------------------------------------------
            if plan["gateway"]["action"] != "KEEP":
                assert target_resolved_file is not None
                assert haproxy_bin is not None
                target_cfg_content = render_haproxy_config(target_resolved_file, gw_listen_addr, gw_listen_port, tls_pem)
                validate_haproxy_config(haproxy_bin, target_cfg_content, gateway_cfg.parent)

                tmp_gw_file = gateway_cfg.with_suffix(f".tmp.{os.getpid()}_{time.time_ns()}")
                try:
                    tmp_gw_file.write_text(target_cfg_content, encoding="utf-8")
                    os.replace(tmp_gw_file, gateway_cfg)
                finally:
                    if tmp_gw_file.exists():
                        try:
                            tmp_gw_file.unlink()
                        except OSError:
                            pass

                tx.pid_target_gateway = reload_haproxy_gracefully(
                    haproxy_bin, gateway_cfg, gateway_pid_file, pid_old=tx.pid_old_gateway
                )

                assert target_resolved_doc is not None
                ok, detail = verify_gateway_urls(target_resolved_doc, gw_listen_addr, gw_listen_port, ca_cert)
                if not ok:
                    raise ReconcileError(f"verificação do gateway após reload falhou: {detail}")

            # -------------------------------------------------------------
            # FASE 4: ATOMIC REFRESH PROJECTION & VERIFY ECOSYSTEM
            # -------------------------------------------------------------
            if plan["projection"]["action"] != "KEEP":
                assert projection_file is not None
                assert target_resolved_doc is not None
                refresh_ecosystem_projection(projection_file, target_resolved_doc)

                expected_cids = {c["component_id"] for c in target_resolved_doc.get("components", [])}
                ok, detail = verify_ecosystem_observation(current["components"], expected_cids)
                if not ok:
                    raise ReconcileError(f"verificação da ecosystem projection em /api/ecosystem falhou: {detail}")

            # -------------------------------------------------------------
            # FASE 5: CONTRACT REMOVALS (Ordem Segura)
            # -------------------------------------------------------------
            for item in plan["changes"]:
                if item["action"] == "REMOVE":
                    cid = item["component_id"]
                    curr_comp = current["components"][cid]
                    stop_res = invoke_component_action(
                        current_dir, curr_comp, "stop", current_resolved_file,
                        state_root=state_root, config_root=config_root,
                    )
                    if stop_res.returncode != 0:
                        err = stop_res.stderr.strip() or stop_res.stdout.strip()
                        raise ReconcileError(f"REMOVE falhou ao parar {cid}: {err}")
                    tx.components_rollback_stack.append(("STOPPED_REMOVED", curr_comp, current_dir, current_resolved_file))

                    executed_changes.append({
                        "component_id": cid,
                        "action": "REMOVE",
                        "status": "SUCCESS",
                        "detail": "unpublished from gateway/projection and stopped safely (data preserved)",
                        "reason": item["reason"],
                    })

            # -------------------------------------------------------------
            # FASE 6: COMMIT RELEASE (Comutação Atômica de Links)
            # -------------------------------------------------------------
            if target_release_dir is not None:
                switch_res = subprocess.run(
                    [str(WORKSTATION_CLI), "release-switch", "--target", str(target_release_dir)],
                    text=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    close_fds=False,
                    check=False,
                )
                if switch_res.returncode != 0:
                    err = switch_res.stderr.strip() or switch_res.stdout.strip()
                    raise ReconcileError(f"falha no commit operacional ao comutar release via sister-workstation: {err}")
                tx.switched_release = True

            # -------------------------------------------------------------
            # FASE 7: VERIFY FINAL (Sob lock até o fim)
            # -------------------------------------------------------------
            if target_resolved_doc is not None:
                for comp in target_resolved_doc.get("components", []):
                    ok, detail = probe_runtime_endpoint(comp["runtime"], comp.get("probe"))
                    if not ok:
                        raise ReconcileError(f"VERIFY FINAL falhou para componente '{comp['component_id']}': {detail}")

            return {
                "schema": APPLY_SCHEMA,
                "status": "SUCCESS",
                "mode": mode,
                "target_release": str(target_release_dir) if target_release_dir else str(current_dir),
                "executed_changes": executed_changes,
                "untouched_components": untouched,
                "summary": plan["summary"],
                "gateway": plan["gateway"],
                "projection": plan["projection"],
            }

        except Exception:
            # Rollback integral em cascata
            # 1. Se release-switch já tiver ocorrido, reverte links para OLD_RELEASE
            if tx.switched_release:
                try:
                    subprocess.run(
                        [str(WORKSTATION_CLI), "release-switch", "--target", str(current_dir)],
                        stdout=subprocess.PIPE,
                        stderr=subprocess.PIPE,
                        text=True,
                        check=False,
                        close_fds=False,
                    )
                except Exception:
                    pass

            # 2. Se REMOVALS foram parados em Phase 5, reinicia na OLD_RELEASE
            for step in reversed(tx.components_rollback_stack):
                if step[0] == "STOPPED_REMOVED":
                    _, rem_comp, cur_dir, cur_res_file = step
                    try:
                        invoke_component_action(cur_dir, rem_comp, "start", cur_res_file, state_root=state_root, config_root=config_root)
                    except Exception:
                        pass

            # 3. Restaura projeção antiga se foi modificada
            if tx.old_projection_tsv is not None and projection_file is not None:
                try:
                    tmp_p = projection_file.with_suffix(f".tmp.{os.getpid()}_{time.time_ns()}")
                    tmp_p.write_text(tx.old_projection_tsv, encoding="utf-8")
                    os.replace(tmp_p, projection_file)
                except Exception:
                    pass

            # 4. Restaura Gateway antigo: re-aplica old_gateway_cfg e faz graceful reload sobre pid_target_gateway
            if tx.old_gateway_cfg is not None and tx.pid_target_gateway is not None and haproxy_bin is not None:
                try:
                    tmp_gw = gateway_cfg.with_suffix(f".tmp.{os.getpid()}_{time.time_ns()}")
                    tmp_gw.write_text(tx.old_gateway_cfg, encoding="utf-8")
                    os.replace(tmp_gw, gateway_cfg)
                    reload_haproxy_gracefully(haproxy_bin, gateway_cfg, gateway_pid_file, pid_old=tx.pid_target_gateway)
                except Exception:
                    pass

            # 5. Restaura leaf TLS antigo se foi modificado
            if tx.old_leaf_bytes is not None:
                try:
                    tmp_leaf = tls_pem.with_suffix(f".tmp.{os.getpid()}_{time.time_ns()}")
                    tmp_leaf.write_bytes(tx.old_leaf_bytes)
                    tmp_leaf.chmod(0o600)
                    os.replace(tmp_leaf, tls_pem)
                except Exception:
                    pass

            # 6. Reverte ADDs e UPDATEs (Fase 1)
            for step in reversed(tx.components_rollback_stack):
                step_type = step[0]
                if step_type in ("STARTED_ADD", "STARTED_NEW"):
                    _, des_comp, tr_dir, tr_res_file = step
                    try:
                        invoke_component_action(tr_dir, des_comp, "stop", tr_res_file, state_root=state_root, config_root=config_root)
                    except Exception:
                        pass
                elif step_type == "STOPPED_OLD":
                    _, curr_comp, cur_dir, cur_res_file = step
                    try:
                        invoke_component_action(cur_dir, curr_comp, "start", cur_res_file, state_root=state_root, config_root=config_root)
                    except Exception:
                        pass

            # 7. Remove TARGET_RELEASE uncommitted
            if target_release_dir and target_release_dir.exists():
                shutil.rmtree(target_release_dir, ignore_errors=True)

            raise


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sister-reconcile",
        description="Calcula e explica o plano determinístico de reconciliação entre o estado atual e o desejado",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    plan_p = sub.add_parser("plan", help="Emite o plano declarativo de reconciliação (read-only)")
    plan_p.add_argument(
        "--desired-candidate",
        required=True,
        help="Diretório da candidata desejada verificada ou caminho de seu manifest.json",
    )
    plan_p.add_argument(
        "--desired-deployment",
        required=True,
        help="Caminho do arquivo de deployment desejado (resolvido ou declarativo)",
    )
    plan_p.add_argument(
        "--current-release",
        help="Caminho da release ativa instalada ou seu manifest.json",
    )
    plan_p.add_argument(
        "--mode",
        default="lab",
        choices=["dev", "lab", "production"],
        help="Contexto operacional do plano (padrão: lab)",
    )
    plan_p.add_argument(
        "--probe-runtime",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Ativa ou desativa sondagem factual de rede nos componentes atuais (padrão: ativa)",
    )
    plan_p.add_argument(
        "--json",
        action="store_true",
        help="Emite o plano no formato JSON padronizado",
    )

    apply_p = sub.add_parser(
        "apply",
        help="Executa transacionalmente alterações de componentes e recursos derivados",
    )
    apply_p.add_argument(
        "--desired-candidate",
        required=True,
        help="Diretório da candidata desejada verificada ou caminho de seu manifest.json",
    )
    apply_p.add_argument(
        "--desired-deployment",
        required=True,
        help="Deployment desejado; mutações que materializam TARGET_RELEASE exigem sister.infra.deployment/1.0.0",
    )
    apply_p.add_argument(
        "--current-release",
        help="Caminho da release ativa instalada ou seu manifest.json",
    )
    apply_p.add_argument(
        "--mode",
        default="lab",
        choices=["lab"],
        help="Contexto operacional autorizado (somente lab neste ciclo)",
    )
    apply_p.add_argument(
        "--json",
        action="store_true",
        help="Emite o resultado da execução em JSON",
    )

    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    try:
        if args.command == "plan":
            current = load_current_state(
                args.current_release,
                probe_runtime=args.probe_runtime,
            )
            desired = load_desired_state(
                args.desired_candidate,
                args.desired_deployment,
            )
            plan = compute_plan(
                current,
                desired,
                mode=args.mode,
                probe_runtime=args.probe_runtime,
            )

            if args.json:
                print(json.dumps(plan, indent=2, sort_keys=True))
            else:
                print(render_human_plan(plan))

            return 0

        elif args.command == "apply":
            result = execute_apply(
                args.current_release,
                args.desired_candidate,
                args.desired_deployment,
                mode=args.mode,
            )

            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                print(render_human_apply(result))

            return 0

        else:
            raise ReconcileError(f"comando desconhecido: {args.command}")

    except ReconcileError as exc:
        print(f"[FAIL] {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
