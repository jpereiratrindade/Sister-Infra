#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
INFRA_ROOT="$(cd "$SELF_DIR/.." && pwd -P)"

HOME_DIR="${HOME:?HOME não definido}"
INSTALL_ROOT="${SISTER_WORKSTATION_INSTALL_ROOT:-$HOME_DIR/.local/share/sister}"
RELEASES_ROOT="$INSTALL_ROOT/releases"
CANDIDATES_ROOT="$INSTALL_ROOT/candidates"
CURRENT_LINK="$INSTALL_ROOT/current"
PREVIOUS_LINK="$INSTALL_ROOT/previous"

STATE_ROOT="${SISTER_WORKSTATION_STATE_ROOT:-$HOME_DIR/.local/state/sister/workstation}"
SYSTEMD_USER_ROOT="${SISTER_WORKSTATION_SYSTEMD_ROOT:-$HOME_DIR/.config/systemd/user}"
UNIT_NAME="${SISTER_WORKSTATION_UNIT_NAME:-sister-workstation.service}"
UNIT_FILE="$SYSTEMD_USER_ROOT/$UNIT_NAME"
BIN_ROOT="${SISTER_WORKSTATION_BIN_ROOT:-$HOME_DIR/.local/bin}"
CLI_LINK="$BIN_ROOT/sister-infra"

CONTROL_PLANE_SOURCE="${SISTER_WORKSTATION_CONTROL_PLANE_SOURCE:-$INFRA_ROOT}"
AUTHORITY_CLI="$INFRA_ROOT/bin/sister-authority"
AUTHORITY_PATHS_OUTPUT="$(
  "$AUTHORITY_CLI" resolve --target lab --allow-missing --format paths
)" || {
  printf '[FAIL] não foi possível resolver installation authority\n' >&2
  exit 1
}
mapfile -t AUTHORITY_PATHS <<<"$AUTHORITY_PATHS_OUTPUT"
CONFIG_ROOT="${AUTHORITY_PATHS[0]}"
COMPOSITION_FILE="${AUTHORITY_PATHS[1]}"
DEPLOYMENT_FILE="${AUTHORITY_PATHS[2]}"
POLICY_FILE="${AUTHORITY_PATHS[3]}"
RUNTIME_ENV="$CONFIG_ROOT/runtime.env"
TLS_CONFIG="$CONFIG_ROOT/tls"
COMPOSITION_CONTRACTS_ROOT="${SISTER_WORKSTATION_CONTRACTS_ROOT:-}"

TEST_MODE="${SISTER_WORKSTATION_TEST_MODE:-0}"

pass() { printf '[PASS] %s\n' "$*" >&2; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
info() { printf '[INFO] %s\n' "$*" >&2; }
die()  { printf '[FAIL] %s\n' "$*" >&2; exit 1; }

is_git_repo() {
  git -C "$1" rev-parse --git-dir >/dev/null 2>&1
}

usage() {
  cat <<'EOF'
SisTer Infra — workstation deployment control plane

Uso:
  sister-infra workstation <comando>

Comandos:
  check           observa invariantes locais e declarações canônicas, sem mutar
  bootstrap       materializa pré-condições locais ausentes de forma idempotente
  doctor          diagnostica host, fontes, Git, systemd e layout, sem mutar
  repair          repara drift factual comprovado sob autoridade e mínima ação
  plan            mostra diferença entre release atual e fontes, sem mutar
  release-create  cria release declarativa qualificada e READY
  release-verify <dir> [--json]  verifica integridade declarativa da release
  release-switch --target <id|dir>  comuta links previous e current atomicamente
  candidate-create [arquivo]  materializa candidata qualificada, sem bindings
  candidate-verify <id>  verifica candidata declarativa materializada
  runtime-start   inicia participantes e gateway da release declarativa
  runtime-stop    para gateway e participantes da release declarativa
  runtime-status  observa participantes da release declarativa
  runtime-verify  verifica participantes e gateway declarativos
  release-list    lista releases instaladas
  install [id]    seleciona release e instala unidade systemd (não inicia)
  promote <id>    promove release já verificada com rollback automático
  activate        migra o runtime atual para o serviço workstation
  start           inicia a instalação workstation
  stop            para a instalação workstation
  restart         reinicia a instalação workstation
  status          mostra release, serviço e saúde agregada
  verify          verifica integridade da release e endpoints
  update          cria release das fontes, promove e verifica; rollback em falha
  rollback        retorna para previous e verifica
  logs            mostra journal do serviço
  current         mostra release current/previous
  help            esta ajuda
EOF
}

layout_paths() {
  printf '%s\n' \
    "$INSTALL_ROOT" \
    "$RELEASES_ROOT" \
    "$CANDIDATES_ROOT" \
    "$CONFIG_ROOT" \
    "$STATE_ROOT" \
    "$SYSTEMD_USER_ROOT" \
    "$BIN_ROOT"
}

layout_check() {
  local failures=0
  local path

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue

    if [[ -d "$path" ]]; then
      pass "layout dir: $path"
    elif [[ -e "$path" || -L "$path" ]]; then
      printf '[FAIL] layout exige diretório, mas encontrou outro tipo: %s\n' \
        "$path" >&2
      failures=$((failures + 1))
    else
      printf '[FAIL] diretório de layout ausente: %s\n' "$path" >&2
      failures=$((failures + 1))
    fi
  done < <(layout_paths)

  [[ "$failures" -eq 0 ]]
}

layout_preflight() {
  local path
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if [[ -e "$path" || -L "$path" ]]; then
      [[ -d "$path" ]] || \
        die "materialização recusada: path de layout existe e não é diretório: $path"
    fi
  done < <(layout_paths)
}

workstation_bootstrap_preflight() {
  layout_preflight
}

materialize_layout() {
  layout_preflight

  local created=0
  local path

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    if [[ ! -d "$path" ]]; then
      mkdir -p "$path"
      created=$((created + 1))
    fi
  done < <(layout_paths)

  layout_check || die "layout não convergiu após materialização"

  if [[ "$created" -eq 0 ]]; then
    pass "layout já convergido (NO_OP)"
  else
    pass "layout materializado: $created diretório(s) criado(s)"
  fi
}

require_repo_clean() {
  local repo="$1"
  local name="$2"

  is_git_repo "$repo" || die "$name não localizado: $repo"

  local dirty
  dirty="$(git -C "$repo" status --porcelain)"
  [[ -z "$dirty" ]] || {
    printf '%s\n' "$dirty" >&2
    die "$name possui alterações locais; release recusada"
  }
}

repo_head() {
  git -C "$1" rev-parse HEAD
}

repo_short() {
  git -C "$1" rev-parse --short=7 HEAD
}

release_path_by_id() {
  printf '%s\n' "$RELEASES_ROOT/$1"
}

link_target_id() {
  local link="$1"
  if [[ -L "$link" ]]; then
    basename "$(readlink -f "$link")"
  else
    printf '%s\n' "-"
  fi
}

current_release_path() {
  [[ -L "$CURRENT_LINK" ]] || return 1
  readlink -f "$CURRENT_LINK"
}

current_release_id() {
  link_target_id "$CURRENT_LINK"
}

previous_release_id() {
  link_target_id "$PREVIOUS_LINK"
}

manifest_path() {
  printf '%s\n' "$1/manifest.json"
}

release_integrity() {
  local release="$1"

  [[ -d "$release" ]] || die "release ausente: $release"
  [[ -f "$(manifest_path "$release")" ]] || die "manifest ausente em $release"
  declarative_release_integrity "$release"
}

sync_runtime_env() {
  materialize_layout
  local release resolved values
  release="$(current_release_path)" || die "nenhuma release current"
  resolved="$(release_resolved_deployment "$release")"
  local gateway_listen
  gateway_listen="$(jq -r '.gateway.listen // empty' "$resolved")"
  values="$(jq -r --arg gw_ip "$gateway_listen" '
    ["localhost", "127.0.0.0/8", "127.0.0.1", "::1"]
    + (if $gw_ip != "" then [$gw_ip] else [] end)
    + [.components[] | select(.runtime.transport == "tcp") | .runtime.listen]
    + [.components[] | select(.gateway != null) | .gateway.host]
    | unique | join(",")
  ' "$resolved")"
  {
    printf 'NO_PROXY=%s\n' "$values"
    printf 'no_proxy=%s\n' "$values"
  } > "$RUNTIME_ENV"
  chmod 600 "$RUNTIME_ENV"
}

cmd_client_env() {
  local release resolved values
  release="$(current_release_path)" || die "nenhuma release current"
  resolved="$(release_resolved_deployment "$release")"
  local gateway_listen
  gateway_listen="$(jq -r '.gateway.listen // empty' "$resolved")"
  values="$(jq -r --arg gw_ip "$gateway_listen" '
    ["localhost", "127.0.0.0/8", "127.0.0.1", "::1"]
    + (if $gw_ip != "" then [$gw_ip] else [] end)
    + [.components[] | select(.runtime.transport == "tcp") | .runtime.listen]
    + [.components[] | select(.gateway != null) | .gateway.host]
    | unique | join(",")
  ' "$resolved")"
  printf 'export NO_PROXY="%s"\n' "$values"
  printf 'export no_proxy="%s"\n' "$values"
}

cmd_hosts_line() {
  local release resolved hosts_list
  release="$(current_release_path)" || die "nenhuma release current"
  resolved="$(release_resolved_deployment "$release")"
  local gateway_listen
  gateway_listen="$(jq -r '.gateway.listen // empty' "$resolved")"
  [[ -n "$gateway_listen" ]] || die "gateway.listen ausente no deployment resolvido"
  hosts_list="$(jq -r '
    [.components[] | select(.gateway != null) | .gateway.host]
    | unique | join(" ")
  ' "$resolved")"
  printf '%s %s\n' "$gateway_listen" "$hosts_list"
}

clone_component() {
  local source="$1"
  local dest="$2"
  local commit="$3"

  git clone --no-hardlinks --quiet "$source" "$dest"
  git -C "$dest" checkout --quiet --detach "$commit"

  if git -C "$dest" remote get-url origin >/dev/null 2>&1; then
    git -C "$dest" remote remove origin
  fi

  [[ "$(git -C "$dest" rev-parse HEAD)" == "$commit" ]] || \
    die "clone não materializou commit esperado em $dest"
}

# SISTER-INFRA-CR05-COMPOSITION-BEGIN
composition_path() {
  local requested="${1:-$COMPOSITION_FILE}"

  [[ -n "$requested" ]] || die "arquivo de composição não informado"
  [[ -f "$requested" ]] || die "composição ausente: $requested"

  (
    cd "$(dirname "$requested")"
    printf '%s/%s\n' "$PWD" "$(basename "$requested")"
  )
}

safe_component_id() {
  local component_id="$1"

  [[ "$component_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
    die "component_id inseguro para materialização: $component_id"
}

safe_relative_artifact_path() {
  local relpath="$1"

  [[ -n "$relpath" ]] || die "artefato sem path"

  case "$relpath" in
    /*|..|../*|*/../*|*/..)
      die "path de artefato inseguro: $relpath"
      ;;
  esac
}

materialize_qualified_artifact() {
  local artifact_root="$1"
  local release_root="$2"
  local relpath="$3"
  local expected_hash="$4"
  local executable="$5"

  safe_relative_artifact_path "$relpath"

  local source_artifact="$artifact_root/$relpath"
  local target_artifact="$release_root/$relpath"

  [[ -f "$source_artifact" ]] || \
    die "artefato qualificado ausente na fonte: $source_artifact"

  mkdir -p "$(dirname "$target_artifact")"

  if git -C "$release_root" \
      ls-files --error-unmatch "$relpath" >/dev/null 2>&1; then
    :
  else
    cp -p "$source_artifact" "$target_artifact"
  fi

  [[ -f "$target_artifact" ]] || \
    die "artefato não materializado: $target_artifact"

  if [[ "$executable" == "true" ]]; then
    [[ -x "$target_artifact" ]] || \
      die "artefato deveria ser executável: $target_artifact"
  fi

  local actual_hash
  actual_hash="$(sha256sum "$target_artifact" | awk '{print $1}')"

  [[ "$actual_hash" == "$expected_hash" ]] || \
    die "hash divergente ao materializar artefato: $relpath"
}

composition_candidate_integrity() {
  local candidate="$1"
  local manifest="$candidate/manifest.json"

  [[ -d "$candidate" ]] || die "candidata ausente: $candidate"
  [[ -f "$manifest" ]] || die "manifest ausente em $candidate"

  jq -e \
    '(.schema == "sister.infra.candidate/1" or .schema == "sister.infra.workstation.candidate/1")' \
    "$manifest" >/dev/null || \
    die "schema de candidata não suportado"

  jq -e \
    '.qualification.status == "PASS"' \
    "$manifest" >/dev/null || \
    die "candidata sem qualificação PASS"

  jq -e \
    '.deployment.status == "PENDING_BINDINGS"' \
    "$manifest" >/dev/null || \
    die "candidata CR-05 deve permanecer PENDING_BINDINGS"

  local evidence_rel evidence expected_evidence_hash actual_evidence_hash
  evidence_rel="$(jq -r '.qualification.evidence' "$manifest")"
  expected_evidence_hash="$(jq -r '.qualification.sha256' "$manifest")"
  evidence="$candidate/$evidence_rel"

  [[ -f "$evidence" ]] || \
    die "evidência de composição ausente: $evidence_rel"

  actual_evidence_hash="$(sha256sum "$evidence" | awk '{print $1}')"
  [[ "$actual_evidence_hash" == "$expected_evidence_hash" ]] || \
    die "hash divergente da evidência de composição"

  local infra_commit infra_repo actual_commit tracked
  infra_commit="$(jq -r '.control_plane.commit' "$manifest")"
  infra_repo="$candidate/$(jq -r '.control_plane.path' "$manifest")"

  [[ -d "$infra_repo/.git" ]] || \
    die "candidata corrompida: control plane sem .git"

  actual_commit="$(git -C "$infra_repo" rev-parse HEAD)"
  [[ "$actual_commit" == "$infra_commit" ]] || \
    die "candidata corrompida: control plane divergiu do manifesto"

  tracked="$(git -C "$infra_repo" status --porcelain --untracked-files=no)"
  [[ -z "$tracked" ]] || \
    die "candidata corrompida: control plane possui alterações rastreadas"

  local component_id component_path component_repo expected_commit
  local artifact_id relpath expected_hash executable absolute actual_hash

  while IFS=$'\t' read -r \
      component_id component_path expected_commit; do
    [[ -n "$component_id" ]] || continue

    safe_component_id "$component_id"
    component_repo="$candidate/$component_path"

    [[ -d "$component_repo/.git" ]] || \
      die "candidata corrompida: $component_id sem .git"

    actual_commit="$(git -C "$component_repo" rev-parse HEAD)"
    [[ "$actual_commit" == "$expected_commit" ]] || \
      die "candidata corrompida: $component_id HEAD divergiu"

    tracked="$(
      git -C "$component_repo" status --porcelain --untracked-files=no
    )"
    [[ -z "$tracked" ]] || \
      die "candidata corrompida: $component_id possui alterações rastreadas"

    while IFS=$'\t' read -r \
        artifact_id relpath expected_hash executable; do
      [[ -n "$artifact_id" ]] || continue

      safe_relative_artifact_path "$relpath"
      absolute="$component_repo/$relpath"

      [[ -f "$absolute" ]] || \
        die "candidata corrompida: artefato ausente: $artifact_id"

      if [[ "$executable" == "true" ]]; then
        [[ -x "$absolute" ]] || \
          die "candidata corrompida: artefato não executável: $artifact_id"
      fi

      actual_hash="$(sha256sum "$absolute" | awk '{print $1}')"
      [[ "$actual_hash" == "$expected_hash" ]] || \
        die "candidata corrompida: hash divergente: $artifact_id"
    done < <(
      jq -r \
        --arg component_id "$component_id" '
          .components[]
          | select(.component_id == $component_id)
          | .artifacts[]
          | [.id, .path, .sha256, (.executable | tostring)]
          | @tsv
        ' "$manifest"
    )
  done < <(
    jq -r '
      .components[]
      | [.component_id, .path, .commit]
      | @tsv
    ' "$manifest"
  )

  pass "integridade da candidata $(basename "$candidate")"
}

materialize_composition_candidate() {
  materialize_layout

  local composition
  composition="$(composition_path "${1:-}")"

  local infra
  infra="$(cd "$CONTROL_PLANE_SOURCE" && pwd -P)"
  require_repo_clean "$infra" "sister-infra"

  local artifact_bundle
  artifact_bundle="$CANDIDATES_ROOT/.qualified-artifacts-$$"
  rm -rf "$artifact_bundle"
  mkdir -p "$artifact_bundle"

  local qualify_cmd=(
    "$INFRA_ROOT/bin/sister-composition"
    qualify
    "$composition"
    --artifacts-root
    "$artifact_bundle"
    --json
  )

  if [[ -n "$COMPOSITION_CONTRACTS_ROOT" ]]; then
    qualify_cmd+=(
      --contracts-root
      "$COMPOSITION_CONTRACTS_ROOT"
    )
  fi

  info "qualificando composição declarativa"

  local qualification_json
  if ! qualification_json="$("${qualify_cmd[@]}")"; then
    rm -rf "$artifact_bundle"
    die "qualificação da composição falhou"
  fi

  jq -e \
    '(.schema == "sister.infra.composition.qualification/1" or .schema == "sister.infra.composition.qualification/2")
     and .status == "PASS"' \
    <<<"$qualification_json" >/dev/null || \
    die "sister-composition não produziu qualificação PASS"

  local infra_commit infra_short qualification_hash qualification_short
  infra_commit="$(repo_head "$infra")"
  infra_short="$(repo_short "$infra")"
  qualification_hash="$(
    printf '%s\n' "$qualification_json" |
      sha256sum |
      awk '{print $1}'
  )"
  qualification_short="${qualification_hash:0:12}"

  local timestamp id candidate tmp
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  id="wc-${timestamp}-${infra_short}-${qualification_short}"
  candidate="$CANDIDATES_ROOT/$id"
  tmp="$CANDIDATES_ROOT/.creating-$id-$$"

  [[ ! -e "$candidate" ]] || die "candidata já existe: $id"

  rm -rf "$tmp"
  mkdir -p \
    "$tmp/components" \
    "$tmp/evidence/composition"

  printf '%s\n' "$qualification_json" \
    > "$tmp/evidence/composition/qualification.json"

  info "materializando control plane"
  clone_component \
    "$infra" \
    "$tmp/components/sister-infra" \
    "$infra_commit"

  local component_id system_id role source_root commit destination
  local artifact_id relpath expected_hash executable

  while IFS=$'\t' read -r \
      component_id system_id role source_root commit; do
    [[ -n "$component_id" ]] || continue
    safe_component_id "$component_id"

    destination="$tmp/components/$component_id"

    info "materializando componente $component_id"
    clone_component "$source_root" "$destination" "$commit"

    while IFS=$'\t' read -r \
        artifact_id relpath expected_hash executable; do
      [[ -n "$artifact_id" ]] || continue

      materialize_qualified_artifact \
        "$artifact_bundle/$component_id" \
        "$destination" \
        "$relpath" \
        "$expected_hash" \
        "$executable"
    done < <(
      jq -r \
        --arg component_id "$component_id" '
          .components[]
          | select(.component_id == $component_id)
          | .qualification.artifacts[]
          | [.id, .path, .sha256, (.executable | tostring)]
          | @tsv
        ' "$tmp/evidence/composition/qualification.json"
    )
  done < <(
    jq -r '
      .components[]
      | [
          .component_id,
          .system_id,
          .role,
          .root,
          .qualification.source.commit
        ]
      | @tsv
    ' "$tmp/evidence/composition/qualification.json"
  )

  python3 - \
    "$tmp/manifest.json" \
    "$tmp/evidence/composition/qualification.json" \
    "$id" \
    "$timestamp" \
    "$infra_commit" \
    "$qualification_hash" <<'PY_CR05_MANIFEST'
import json
import sys
from pathlib import Path

(
    out,
    qualification_path,
    candidate_id,
    created,
    infra_commit,
    qualification_hash,
) = sys.argv[1:]

qualification = json.loads(
    Path(qualification_path).read_text(encoding="utf-8")
)

components = []
for item in qualification["components"]:
    report = item["qualification"]
    components.append(
        {
            "component_id": item["component_id"],
            "system_id": item["system_id"],
            "role": item["role"],
            "component_contract": item["component_contract"],
            "path": f"components/{item['component_id']}",
            "commit": report["source"]["commit"],
            "runtime": item["runtime"],
            "artifacts": report["artifacts"],
        }
    )

payload = {
    "schema": "sister.infra.workstation.candidate/1",
    "candidate_id": candidate_id,
    "created_at_utc": created,
    "control_plane": {
        "component_id": "infra",
        "path": "components/sister-infra",
        "commit": infra_commit,
    },
    "composition": {
        "composition_id": qualification["composition_id"],
        "schema": qualification["schema"],
    },
    "components": components,
    "qualification": {
        "status": "PASS",
        "evidence": "evidence/composition/qualification.json",
        "sha256": qualification_hash,
    },
    "deployment": {
        "status": "PENDING_BINDINGS",
    },
}
if "deployment_class" in qualification:
    payload["deployment_class"] = qualification["deployment_class"]

Path(out).write_text(
    json.dumps(payload, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY_CR05_MANIFEST

  printf '%s\n' "$id" > "$tmp/CANDIDATE_ID"
  printf '%s\n' "SISTER-INFRA-CR-05" > "$tmp/QUALIFICATION"

  composition_candidate_integrity "$tmp"

  mv "$tmp" "$candidate"
  composition_candidate_integrity "$candidate"

  rm -rf "$artifact_bundle"

  pass "candidata declarativa materializada: $id"
  info "bindings ainda não foram resolvidos; candidata não foi instalada"
  printf '%s\n' "$id"
}

candidate_verify() {

  local id="${1:-}"
  [[ -n "$id" ]] || die "candidate-verify requer id"

  composition_candidate_integrity "$CANDIDATES_ROOT/$id"
}
# SISTER-INFRA-CR05-COMPOSITION-END

sha256_path() {
  sha256sum "$1" | awk '{print $1}'
}

declarative_release_integrity() {
  local release="$1"
  local manifest="$release/manifest.json"

  jq -e '
    .schema == "sister.infra.workstation.release/3"
    and .qualification.status == "PASS"
    and .deployment.status == "READY"
    and (.components | type == "array" and length > 0)
  ' "$manifest" >/dev/null || \
    die "release declarativa não está qualificada e READY"

  local evidence expected actual
  while IFS=$'\t' read -r evidence expected; do
    [[ -n "$evidence" ]] || continue
    [[ -f "$release/$evidence" ]] || \
      die "evidência ausente na release: $evidence"
    actual="$(sha256_path "$release/$evidence")"
    [[ "$actual" == "$expected" ]] || \
      die "hash divergente da evidência: $evidence"
  done < <(
    jq -r '
      [
        [.qualification.evidence, .qualification.sha256],
        [.deployment.declaration, .deployment.declaration_sha256],
        [.deployment.evidence, .deployment.sha256]
      ][] | @tsv
    ' "$manifest"
  )

  local control_path control_commit control_repo tracked
  control_path="$(jq -r '.control_plane.path' "$manifest")"
  control_commit="$(jq -r '.control_plane.commit' "$manifest")"
  safe_relative_artifact_path "$control_path"
  control_repo="$release/$control_path"
  [[ -d "$control_repo/.git" ]] || \
    die "release declarativa sem control plane Git"
  [[ "$(git -C "$control_repo" rev-parse HEAD)" == "$control_commit" ]] || \
    die "control plane divergiu do manifesto"
  tracked="$(git --no-optional-locks -C "$control_repo" status --porcelain --untracked-files=no)"
  [[ -z "$tracked" ]] || die "control plane possui alteração rastreada"

  local component_id component_path component_repo expected_commit entrypoint
  local artifact_id relpath expected_hash executable absolute
  while IFS=$'\t' read -r \
      component_id component_path expected_commit entrypoint; do
    [[ -n "$component_id" ]] || continue
    safe_component_id "$component_id"
    safe_relative_artifact_path "$component_path"
    safe_relative_artifact_path "$entrypoint"
    component_repo="$release/$component_path"

    [[ -d "$component_repo/.git" ]] || \
      die "release declarativa: $component_id sem .git"
    [[ "$(git -C "$component_repo" rev-parse HEAD)" == "$expected_commit" ]] || \
      die "release declarativa: commit divergente para $component_id"
    tracked="$(git --no-optional-locks -C "$component_repo" status --porcelain --untracked-files=no)"
    [[ -z "$tracked" ]] || \
      die "release declarativa: alteração rastreada em $component_id"
    [[ -x "$component_repo/$entrypoint" ]] || \
      die "entrypoint ausente/não executável para $component_id"

    while IFS=$'\t' read -r \
        artifact_id relpath expected_hash executable; do
      [[ -n "$artifact_id" ]] || continue
      safe_relative_artifact_path "$relpath"
      absolute="$component_repo/$relpath"
      [[ -f "$absolute" ]] || \
        die "artefato ausente: $component_id/$artifact_id"
      if [[ "$executable" == "true" ]]; then
        [[ -x "$absolute" ]] || \
          die "artefato não executável: $component_id/$artifact_id"
      fi
      [[ "$(sha256_path "$absolute")" == "$expected_hash" ]] || \
        die "hash divergente: $component_id/$artifact_id"
    done < <(
      jq -r --arg id "$component_id" '
        .components[] | select(.component_id == $id) | .artifacts[]
        | [.id, .path, .sha256, (.executable | tostring)] | @tsv
      ' "$manifest"
    )
  done < <(
    jq -r '
      .components[]
      | [.component_id, .path, .commit, .runtime.entrypoint]
      | @tsv
    ' "$manifest"
  )

  local resolved="$release/$(jq -r '.deployment.evidence' "$manifest")"
  jq -e --slurpfile deployment "$resolved" '
    .candidate_id == $deployment[0].candidate_id
    and .composition.composition_id == $deployment[0].composition_id
    and (
      [.components[].system_id] | sort
    ) == (
      [$deployment[0].components[].system_id] | sort
    )
  ' "$manifest" >/dev/null || \
    die "deployment resolvido diverge da release"

  pass "integridade declarativa da release $(basename "$release")"
}

declarative_source_files() {
  local control_plane
  control_plane="$(cd "$CONTROL_PLANE_SOURCE" && pwd -P)"
  require_repo_clean "$control_plane" "sister-infra"

  local composition="$COMPOSITION_FILE"
  local deployment="$DEPLOYMENT_FILE"

  [[ -f "$composition" ]] || die "composição oficial ausente: $composition"
  [[ -f "$deployment" ]] || die "deployment oficial ausente: $deployment"
  printf '%s\t%s\n' "$composition" "$deployment"
}

release_create_declarative() {
  materialize_layout

  local composition deployment
  IFS=$'\t' read -r composition deployment < <(declarative_source_files)

  local candidate_output candidate_id candidate
  candidate_output="$(materialize_composition_candidate "$composition")"
  printf '%s\n' "$candidate_output"
  candidate_id="$(printf '%s\n' "$candidate_output" | tail -n1)"
  candidate="$CANDIDATES_ROOT/$candidate_id"
  composition_candidate_integrity "$candidate"

  local id release tmp
  id="wr-${candidate_id#wc-}"
  release="$RELEASES_ROOT/$id"
  tmp="$RELEASES_ROOT/.creating-$id-$$"
  [[ ! -e "$release" ]] || die "release já existe: $id"

  mkdir -p "$tmp"
  trap 'rm -rf "$tmp" 2>/dev/null || true' EXIT
  cp -a "$candidate/." "$tmp/"
  mkdir -p "$tmp/evidence/deployment"
  cp -p "$deployment" "$tmp/evidence/deployment/declaration.json"

  "$tmp/components/sister-infra/bin/sister-deployment" resolve \
    "$tmp/manifest.json" \
    "$tmp/evidence/deployment/declaration.json" \
    --json > "$tmp/evidence/deployment/resolved.json" || {
      find "$tmp" -depth -delete
      die "deployment da release não resolveu READY"
    }

  local declaration_hash resolved_hash
  declaration_hash="$(sha256_path "$tmp/evidence/deployment/declaration.json")"
  resolved_hash="$(sha256_path "$tmp/evidence/deployment/resolved.json")"

  python3 - \
    "$tmp/manifest.json" \
    "$id" \
    "$declaration_hash" \
    "$resolved_hash" <<'PY_RELEASE_V3'
import json
import sys
from pathlib import Path

manifest_path, release_id, declaration_hash, resolved_hash = sys.argv[1:]
path = Path(manifest_path)
manifest = json.loads(path.read_text(encoding="utf-8"))
resolved = json.loads(
    (path.parent / "evidence/deployment/resolved.json").read_text(
        encoding="utf-8"
    )
)

manifest["schema"] = "sister.infra.workstation.release/3"
manifest["release_id"] = release_id
manifest["deployment"] = {
    "status": "READY",
    "deployment_id": resolved["deployment_id"],
    "declaration": "evidence/deployment/declaration.json",
    "declaration_sha256": declaration_hash,
    "evidence": "evidence/deployment/resolved.json",
    "sha256": resolved_hash,
}

path.write_text(
    json.dumps(manifest, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY_RELEASE_V3

  printf '%s\n' "$id" > "$tmp/RELEASE_ID"
  printf '%s\n' "SISTER-INFRA-DECLARATIVE-RELEASE-3" > "$tmp/QUALIFICATION"
  declarative_release_integrity "$tmp"
  mv "$tmp" "$release"
  trap - EXIT
  declarative_release_integrity "$release"
  printf '%s\n' "$id" > "$STATE_ROOT/last-created-release"
  pass "release declarativa READY criada: $id"
  printf '%s\n' "$id"
}

release_resolved_deployment() {
  local release="$1"
  printf '%s/%s\n' \
    "$release" \
    "$(jq -r '.deployment.evidence' "$release/manifest.json")"
}

invoke_component_action() {
  local release="$1"
  local component_id="$2"
  local component_path="$3"
  local entrypoint="$4"
  local action="$5"
  local resolved="$6"
  local root="$release/$component_path"
  local config="$CONFIG_ROOT/${component_id}.env"

  mkdir -p \
    "$STATE_ROOT/components/$component_id" \
    "$STATE_ROOT/run/$component_id"

  (
    cd "$root"
    export SISTER_RESOLVED_DEPLOYMENT_FILE="$resolved"
    export SISTER_COMPONENT_CONFIG_FILE="$config"
    export SISTER_RUNTIME_STATE_DIR="$STATE_ROOT/components/$component_id"
    export SISTER_RUNTIME_RUN_DIR="$STATE_ROOT/run/$component_id"
    "$root/$entrypoint" "$action"
  )
}

component_rows() {
  jq -r '
    .components[]
    | [.component_id, .path, .runtime.entrypoint]
    | @tsv
  ' "$1/manifest.json"
}

components_action_forward() {
  local release="$1"
  local action="$2"
  local resolved
  resolved="$(release_resolved_deployment "$release")"

  local component_id component_path entrypoint
  while IFS=$'\t' read -r component_id component_path entrypoint; do
    [[ -n "$component_id" ]] || continue
    info "$action: $component_id"
    invoke_component_action \
      "$release" "$component_id" "$component_path" \
      "$entrypoint" "$action" "$resolved" || return 1
  done < <(component_rows "$release")
}

components_action_reverse() {
  local release="$1"
  local action="$2"
  local resolved
  resolved="$(release_resolved_deployment "$release")"

  local -a rows=()
  mapfile -t rows < <(component_rows "$release")
  local index component_id component_path entrypoint
  for ((index=${#rows[@]} - 1; index >= 0; index--)); do
    IFS=$'\t' read -r component_id component_path entrypoint \
      <<<"${rows[$index]}"
    [[ -n "$component_id" ]] || continue
    info "$action: $component_id"
    invoke_component_action \
      "$release" "$component_id" "$component_path" \
      "$entrypoint" "$action" "$resolved" || \
      warn "$component_id reportou falha em $action"
  done
}

declarative_gateway_action() {
  local release="$1"
  local action="$2"
  local resolved
  resolved="$(release_resolved_deployment "$release")"

  if [[ "$TEST_MODE" == "1" ]]; then
    info "TEST_MODE gateway declarativo: $action"
    local pid_file="$STATE_ROOT/control-plane/gateway/haproxy-lan.pid"
    if [[ "$action" == "up" ]]; then
      mkdir -p "$(dirname "$pid_file")"
      echo "$$" > "$pid_file"
    elif [[ "$action" == "down" ]]; then
      rm -f "$pid_file"
    fi
    return 0
  fi

  local control_plane
  control_plane="$release/$(jq -r '.control_plane.path' "$release/manifest.json")"
  local runtime_gateway="$control_plane/libexec/sister-infra/runtime-gateway"
  [[ -x "$runtime_gateway" ]] || \
    die "adapter privado de runtime ausente ou não executável: $runtime_gateway"
  mkdir -p "$TLS_CONFIG" "$STATE_ROOT/control-plane"

  SISTER_RESOLVED_DEPLOYMENT_FILE="$resolved" \
  SISTER_INFRA_RUN_ROOT="$STATE_ROOT/control-plane" \
  TLS_PEM="$TLS_CONFIG/ecosystem-lab.pem" \
  CA_CERT="$TLS_CONFIG/ecosystem-lab-ca.crt" \
  CA_KEY="$TLS_CONFIG/ecosystem-lab-ca.key" \
    "$runtime_gateway" "$action" --profile lan
}

runtime_start() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_release_integrity "$release"

  if ! components_action_forward "$release" start; then
    warn "start declarativo falhou; parando participantes já acionados"
    components_action_reverse "$release" stop
    die "runtime declarativo não iniciou"
  fi
  components_action_forward "$release" health || {
    components_action_reverse "$release" stop
    die "participante falhou no health após start"
  }
  declarative_gateway_action "$release" up || {
    declarative_gateway_action "$release" down || true
    components_action_reverse "$release" stop
    die "gateway declarativo não iniciou"
  }
  pass "runtime declarativo iniciado"
}

runtime_stop() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_gateway_action "$release" down || \
    warn "gateway declarativo reportou falha ao parar"
  components_action_reverse "$release" stop
  pass "runtime declarativo parado"
}

runtime_status() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_release_integrity "$release"
  components_action_forward "$release" status
  declarative_gateway_action "$release" status
}

runtime_verify() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_release_integrity "$release"
  components_action_forward "$release" health
  declarative_gateway_action "$release" verify
  pass "workstation declarativa verificada"
}

require_release_build_qualified() {
  local release="$1"
  local status
  status="$(jq -r '
    if .qualification.status == "PASS" and .deployment.status == "READY"
    then "PASS" else "UNQUALIFIED" end
  ' "$(manifest_path "$release")")"
  [[ "$status" == "PASS" ]] || \
    die "release não possui qualification PASS e deployment READY: $(basename "$release")"
}

release_verify() {
  local release_dir="" json_output=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_output=1; shift ;;
      -*) die "opção desconhecida para release-verify: $1" ;;
      *)
        if [[ -z "$release_dir" ]]; then
          release_dir="$1"
        else
          die "argumento extra inesperado: $1"
        fi
        shift
        ;;
    esac
  done

  [[ -n "$release_dir" ]] || die "release-verify requer o caminho do diretório da release"
  [[ -d "$release_dir" ]] || die "diretório de release inexistente: $release_dir"

  declarative_release_integrity "$release_dir" >/dev/null

  local id
  id="$(jq -r '.release_id // empty' "$release_dir/manifest.json")"
  [[ -n "$id" ]] || id="$(basename "$release_dir")"

  if [[ "$json_output" -eq 1 ]]; then
    printf '{"status":"VALID","release_id":"%s","release_path":"%s"}\n' "$id" "$release_dir"
  else
    pass "release válida: $id ($release_dir)"
  fi
}

atomic_replace_symlink() {
  local target="$1" link="$2"
  local link_dir tmp_link

  link_dir="$(dirname "$link")"
  tmp_link="${link}.tmp.$$-$(date +%s%N)"

  rm -f "$tmp_link" 2>/dev/null || true

  if ! ln -s "$target" "$tmp_link"; then
    rm -f "$tmp_link" 2>/dev/null || true
    die "falha ao criar symlink temporário para $link -> $target"
  fi

  if ! mv -T -f "$tmp_link" "$link"; then
    rm -f "$tmp_link" 2>/dev/null || true
    die "falha ao comutar symlink atômico $link -> $target"
  fi
}

LIFECYCLE_LOCK_FD=9

acquire_lifecycle_lock() {
  materialize_layout
  mkdir -p "$STATE_ROOT/locks"

  local lock_file="$STATE_ROOT/locks/workstation-lifecycle.lock"
  touch "$lock_file"
  local canonical_lock_file
  canonical_lock_file="$(readlink -f "$lock_file")"

  if [[ -n "${SISTER_WORKSTATION_LOCK_FD:-}" ]]; then
    local fd_target=""
    if [[ -e "/proc/$$/fd/${SISTER_WORKSTATION_LOCK_FD}" ]]; then
      fd_target="$(readlink -f "/proc/$$/fd/${SISTER_WORKSTATION_LOCK_FD}" 2>/dev/null || true)"
    fi
    if [[ -n "$fd_target" && "$fd_target" == "$canonical_lock_file" ]]; then
      if (exec <&"${SISTER_WORKSTATION_LOCK_FD}") 2>/dev/null; then
        return 0
      fi
    fi
  fi

  eval "exec $LIFECYCLE_LOCK_FD>\"\$lock_file\""
  if ! flock -n "$LIFECYCLE_LOCK_FD"; then
    die "outra operação de lifecycle está em execução (lock ativo em $lock_file)"
  fi

  trap 'flock -u '$LIFECYCLE_LOCK_FD' 2>/dev/null || true; eval "exec '$LIFECYCLE_LOCK_FD'>&-" 2>/dev/null || true' EXIT
}

release_switch() {
  local target=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target) target="$2"; shift 2 ;;
      *) die "opção desconhecida para release-switch: $1" ;;
    esac
  done

  [[ -n "$target" ]] || die "release-switch requer --target <release>"
  materialize_layout

  acquire_lifecycle_lock

  local target_path
  if [[ -f "$target" && "$(basename "$target")" == "manifest.json" ]]; then
    target_path="$(cd "$(dirname "$target")" && pwd -P)"
  elif [[ -d "$target" ]]; then
    target_path="$(cd "$target" && pwd -P)"
  elif [[ -d "$RELEASES_ROOT/$target" ]]; then
    target_path="$RELEASES_ROOT/$target"
  else
    die "release target inexistente: $target"
  fi

  # 1. Validação prévia de TARGET pela autoridade release-verify
  declarative_release_integrity "$target_path" >/dev/null || die "target release falhou na verificação de integridade"

  # 2. Se current existir, valida OLD também
  local old_current=""
  if [[ -L "$CURRENT_LINK" ]] && [[ -e "$CURRENT_LINK" ]]; then
    old_current="$(readlink -f "$CURRENT_LINK")"
    declarative_release_integrity "$old_current" >/dev/null || die "old release falhou na verificação de integridade"
  fi

  # 3. Comutação atômica dos links usando symlink temporário no mesmo diretório e rename(2)
  # Ordem estrita:
  # previous -> OLD
  # current  -> TARGET (ponto de commit da transição)
  if [[ -n "$old_current" ]]; then
    atomic_replace_symlink "$old_current" "$PREVIOUS_LINK"
  fi

  atomic_replace_symlink "$target_path" "$CURRENT_LINK"

  pass "release-switch concluído com sucesso: current -> $(basename "$target_path")"
}

release_create() {
  if [[ $# -eq 0 ]]; then
    release_create_declarative
    return
  fi

  local candidate="" deployment="" json_output=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --candidate) candidate="$2"; shift 2 ;;
      --deployment) deployment="$2"; shift 2 ;;
      --json) json_output=1; shift ;;
      *) die "opção desconhecida para release-create: $1" ;;
    esac
  done

  if [[ -z "$candidate" || -z "$deployment" ]]; then
    die "--candidate e --deployment devem ser fornecidos conjuntamente"
  fi

  materialize_layout

  local candidate_path
  if [[ -f "$candidate" && "$(basename "$candidate")" == "manifest.json" ]]; then
    candidate_path="$(cd "$(dirname "$candidate")" && pwd -P)"
  elif [[ -d "$candidate" ]]; then
    candidate_path="$(cd "$candidate" && pwd -P)"
  else
    die "diretório de candidata inexistente: $candidate"
  fi

  local deployment_path
  if [[ -f "$deployment" ]]; then
    deployment_path="$(cd "$(dirname "$deployment")" && pwd -P)/$(basename "$deployment")"
  else
    die "arquivo de deployment inexistente: $deployment"
  fi

  # 1. Validação autoritativa da candidata
  local candidate_manifest="$candidate_path/manifest.json"
  [[ -f "$candidate_manifest" ]] || die "manifest.json ausente na candidata: $candidate_path"

  if [[ -x "$INFRA_ROOT/bin/sister-candidate" ]]; then
    "${PYTHON:-python3}" "$INFRA_ROOT/bin/sister-candidate" verify "$candidate_path" --json >/dev/null || \
      die "candidata falhou na verificação autoritativa"
  else
    composition_candidate_integrity "$candidate_path"
  fi

  local candidate_id
  candidate_id="$(jq -r '.candidate_id // empty' "$candidate_manifest")"
  [[ -n "$candidate_id" ]] || die "manifesto de candidata sem candidate_id"

  local id release tmp
  id="wr-${candidate_id#wc-}"
  release="$RELEASES_ROOT/$id"
  tmp="$RELEASES_ROOT/.creating-$id-$$"
  [[ ! -e "$release" ]] || die "release já existe: $id"

  mkdir -p "$tmp"
  trap 'rm -rf "$tmp" 2>/dev/null || true' EXIT
  cp -a "$candidate_path/." "$tmp/"
  mkdir -p "$tmp/evidence/deployment"

  if [[ "$(jq -r '.control_plane // empty' "$tmp/manifest.json")" == "" ]]; then
    local infra_source="${CONTROL_PLANE_SOURCE:-$INFRA_ROOT}"
    if is_git_repo "$infra_source"; then
      local infra_commit
      infra_commit="$(git -C "$infra_source" rev-parse HEAD)"
      clone_component "$infra_source" "$tmp/components/sister-infra" "$infra_commit"
      "${PYTHON:-python3}" - "$tmp/manifest.json" "$infra_commit" <<'PY_INFRA'
import json, sys, pathlib
p = pathlib.Path(sys.argv[1])
m = json.loads(p.read_text(encoding="utf-8"))
m["control_plane"] = {
    "component_id": "infra",
    "path": "components/sister-infra",
    "commit": sys.argv[2],
}
p.write_text(json.dumps(m, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY_INFRA
    fi
  fi

  # 2. Resolução do deployment declarativo
  local dep_schema
  dep_schema="$(jq -r '.schema // empty' "$deployment_path")"

  if [[ "$dep_schema" != "sister.infra.deployment/1.0.0" ]]; then
    die "release-create requer deployment declarativo 'sister.infra.deployment/1.0.0' (obtido: ${dep_schema:-vazio})"
  fi

  cp -p "$deployment_path" "$tmp/evidence/deployment/declaration.json"
  "${PYTHON:-python3}" "$INFRA_ROOT/bin/sister-deployment" resolve \
    "$tmp/manifest.json" \
    "$tmp/evidence/deployment/declaration.json" \
    --json > "$tmp/evidence/deployment/resolved.json" || {
      find "$tmp" -depth -delete
      die "deployment da release não resolveu READY"
    }

  local declaration_hash resolved_hash
  declaration_hash="$(sha256_path "$tmp/evidence/deployment/declaration.json")"
  resolved_hash="$(sha256_path "$tmp/evidence/deployment/resolved.json")"

  python3 - \
    "$tmp/manifest.json" \
    "$id" \
    "$declaration_hash" \
    "$resolved_hash" <<'PY_RELEASE_V3'
import json
import sys
from pathlib import Path

manifest_path, release_id, declaration_hash, resolved_hash = sys.argv[1:]
path = Path(manifest_path)
manifest = json.loads(path.read_text(encoding="utf-8"))
resolved = json.loads(
    (path.parent / "evidence/deployment/resolved.json").read_text(
        encoding="utf-8"
    )
)

manifest["schema"] = "sister.infra.workstation.release/3"
manifest["release_id"] = release_id
manifest["deployment"] = {
    "status": "READY",
    "deployment_id": resolved["deployment_id"],
    "declaration": "evidence/deployment/declaration.json",
    "declaration_sha256": declaration_hash,
    "evidence": "evidence/deployment/resolved.json",
    "sha256": resolved_hash,
}

path.write_text(
    json.dumps(manifest, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY_RELEASE_V3

  printf '%s\n' "$id" > "$tmp/RELEASE_ID"
  printf '%s\n' "SISTER-INFRA-DECLARATIVE-RELEASE-3" > "$tmp/QUALIFICATION"
  if [[ "$json_output" -eq 1 ]]; then
    declarative_release_integrity "$tmp" >/dev/null
    mv "$tmp" "$release"
    trap - EXIT
    declarative_release_integrity "$release" >/dev/null
    printf '{"status":"READY","release_id":"%s","release_path":"%s"}\n' "$id" "$release"
  else
    declarative_release_integrity "$tmp"
    mv "$tmp" "$release"
    trap - EXIT
    declarative_release_integrity "$release"
    pass "release declarativa READY criada: $id"
    printf '%s\n' "$id"
  fi
}

render_unit() {
  materialize_layout

  # SISTER-INFRA-OPS001E-SYSTEMD-SINGLE-SOURCE
  #
  # A unit instalada deriva exclusivamente do template pertencente à
  # release selecionada. O control plane não mantém uma segunda
  # representação do contrato systemd.
  local template
  template="${CURRENT_LINK}/components/sister-infra/templates/systemd/sister-workstation.service.in"

  [[ -f "$template" ]] || \
    die "template systemd ausente na release current: $template"

  python3 - "$template" "$UNIT_FILE" "$HOME_DIR" <<'PY_RENDER_UNIT'
from pathlib import Path
import sys

source = Path(sys.argv[1])
target = Path(sys.argv[2])
home = sys.argv[3]

text = source.read_text()

required = "Environment=SISTER_INFRA_RUNTIME_MODE=installed"

if required not in text:
    raise SystemExit(
        f"template workstation sem contrato installed obrigatório: {source}"
    )

# O template usa %h para representar HOME.
# A unit materializada usa caminhos absolutos para facilitar auditoria.
text = text.replace("%h", home)

target.write_text(text)
PY_RENDER_UNIT

  grep -Fxq \
    'Environment=SISTER_INFRA_RUNTIME_MODE=installed' \
    "$UNIT_FILE" || \
    die "unit renderizada perdeu SISTER_INFRA_RUNTIME_MODE=installed"

  chmod 644 "$UNIT_FILE"
}

systemctl_user() {
  if [[ "$TEST_MODE" == "1" ]]; then
    info "TEST_MODE systemctl --user $*"
    return 0
  fi

  systemctl --user "$@"
}

install_release() {
  materialize_layout
  acquire_lifecycle_lock

  local id="${1:-}"

  if [[ -z "$id" ]]; then
    [[ -f "$STATE_ROOT/last-created-release" ]] || \
      die "nenhuma release indicada nem last-created-release"
    id="$(cat "$STATE_ROOT/last-created-release")"
  fi

  local release
  release="$(release_path_by_id "$id")"

  release_integrity "$release"
  require_release_build_qualified "$release"

  local old_current=""

  if [[ -L "$CURRENT_LINK" ]]; then
    old_current="$(readlink -f "$CURRENT_LINK")"
  fi

  if [[ -n "$old_current" && "$old_current" != "$release" ]]; then
    ln -sfn "$old_current" "$PREVIOUS_LINK"
  fi

  ln -sfn "$release" "$CURRENT_LINK"

  render_unit
  sync_runtime_env
  ln -sfn "$CURRENT_LINK/components/sister-infra/bin/sister-infra" "$CLI_LINK"

  systemctl_user daemon-reload

  pass "release instalada como current: $id"
  info "serviço instalado, mas permanece desabilitado e não iniciado"
}

verify_installed() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"

  release_integrity "$release"
  require_release_build_qualified "$release"

  runtime_verify
  pass "workstation verificado"
}

service_active() {
  if [[ "$TEST_MODE" == "1" ]]; then
    return 1
  fi

  systemctl --user is-active --quiet "$UNIT_NAME"
}

start_service() {
  local release
  release="$(current_release_path)" || die "nenhuma release instalada"

  release_integrity "$release"
  systemctl_user start "$UNIT_NAME"
}

stop_service() {
  systemctl_user stop "$UNIT_NAME"
}

restart_service() {
  local release
  release="$(current_release_path)" || die "nenhuma release instalada"

  release_integrity "$release"
  systemctl_user restart "$UNIT_NAME"
}

activate_workstation() {
  local release
  release="$(current_release_path)" || die "instale uma release antes de activate"

  release_integrity "$release"
  require_release_build_qualified "$release"

  if service_active; then
    info "workstation já está ativo"
    verify_installed
    systemctl_user enable "$UNIT_NAME" >/dev/null
    return 0
  fi

  if systemctl_user start "$UNIT_NAME"; then
    if verify_installed; then
      systemctl_user enable "$UNIT_NAME" >/dev/null
      pass "workstation assumiu o runtime e autostart foi habilitado"
      return 0
    fi
  fi

  warn "ativação workstation falhou; tentando restaurar runtime anterior"
  systemctl_user disable "$UNIT_NAME" >/dev/null 2>&1 || true
  systemctl_user stop "$UNIT_NAME" >/dev/null 2>&1 || true

  die "ativação falhou"
}

promote_release() {
  acquire_lifecycle_lock
  local new_id="$1"
  local new_release
  new_release="$(release_path_by_id "$new_id")"

  release_integrity "$new_release"

  local old_release=""

  if [[ -L "$CURRENT_LINK" ]]; then
    old_release="$(readlink -f "$CURRENT_LINK")"
  fi

  local was_active=0

  if service_active; then
    was_active=1
    systemctl_user stop "$UNIT_NAME"
  fi

  if [[ -n "$old_release" && "$old_release" != "$new_release" ]]; then
    ln -sfn "$old_release" "$PREVIOUS_LINK"
  fi

  ln -sfn "$new_release" "$CURRENT_LINK"

  render_unit
  sync_runtime_env
  ln -sfn "$CURRENT_LINK/components/sister-infra/bin/sister-infra" "$CLI_LINK"
  systemctl_user daemon-reload

  if [[ "$was_active" -eq 1 ]]; then
    if systemctl_user start "$UNIT_NAME" && verify_installed; then
      pass "release promovida: $new_id"
      return 0
    fi

    warn "nova release falhou; executando rollback automático"
    systemctl_user stop "$UNIT_NAME" >/dev/null 2>&1 || true

    if [[ -n "$old_release" ]]; then
      ln -sfn "$old_release" "$CURRENT_LINK"
      ln -sfn "$new_release" "$PREVIOUS_LINK"
      render_unit
      systemctl_user daemon-reload

      if systemctl_user start "$UNIT_NAME" && verify_installed; then
        warn "rollback automático concluído para $(basename "$old_release")"
      else
        die "nova release falhou e rollback automático também falhou"
      fi
    fi

    die "promoção recusada; release anterior restaurada"
  fi

  pass "release selecionada: $new_id"
  info "serviço estava parado e permaneceu parado"
}

update_workstation() {
  local output id
  output="$(release_create)"
  printf '%s\n' "$output"
  id="$(printf '%s\n' "$output" | tail -n1)"

  promote_release "$id"
}

rollback_workstation() {
  acquire_lifecycle_lock
  [[ -L "$PREVIOUS_LINK" ]] || die "nenhuma release previous"

  local target current
  target="$(readlink -f "$PREVIOUS_LINK")"
  current="$(current_release_path)" || die "nenhuma release current"

  release_integrity "$target"

  local was_active=0

  if service_active; then
    was_active=1
    systemctl_user stop "$UNIT_NAME"
  fi

  ln -sfn "$target" "$CURRENT_LINK"
  ln -sfn "$current" "$PREVIOUS_LINK"

  render_unit
  sync_runtime_env
  systemctl_user daemon-reload

  if [[ "$was_active" -eq 1 ]]; then
    if systemctl_user start "$UNIT_NAME" && verify_installed; then
      pass "rollback concluído: $(basename "$target")"
      return 0
    fi

    warn "rollback não ficou saudável; restaurando release que estava ativa"
    systemctl_user stop "$UNIT_NAME" >/dev/null 2>&1 || true

    ln -sfn "$current" "$CURRENT_LINK"
    ln -sfn "$target" "$PREVIOUS_LINK"

    render_unit
    systemctl_user daemon-reload
    systemctl_user start "$UNIT_NAME" || true

    die "rollback recusado"
  fi

  pass "current alterado para $(basename "$target"); serviço permanece parado"
}

workstation_check() {
  local failures=0

  if ! layout_check; then
    failures=$((failures + 1))
  fi

  if [[ -f "$COMPOSITION_FILE" ]]; then
    pass "composição canônica: $COMPOSITION_FILE"
  else
    printf '[FAIL] composição canônica ausente: %s\n' "$COMPOSITION_FILE" >&2
    failures=$((failures + 1))
  fi

  if [[ -f "$DEPLOYMENT_FILE" ]]; then
    pass "deployment canônico: $DEPLOYMENT_FILE"
  else
    printf '[FAIL] deployment canônico ausente: %s\n' "$DEPLOYMENT_FILE" >&2
    failures=$((failures + 1))
  fi

  [[ "$failures" -eq 0 ]] || \
    die "workstation check encontrou $failures falha(s)"

  pass "workstation check READY"
}

workstation_bootstrap() {
  workstation_bootstrap_preflight
  materialize_layout
  pass "workstation bootstrap READY"
  if [[ ! -f "$COMPOSITION_FILE" || ! -f "$DEPLOYMENT_FILE" ]]; then
    info "autoridade da instalação ainda não materializada"
    info "composition esperado: $COMPOSITION_FILE"
    info "deployment esperado: $DEPLOYMENT_FILE"
  fi
}

doctor() {
  local failures=0
  local cmd

  if ! layout_check; then
    failures=$((failures + 1))
  fi

  for cmd in bash git python3 jq systemctl openssl curl; do
    if command -v "$cmd" >/dev/null 2>&1; then
      pass "$cmd"
    else
      printf '[FAIL] dependência ausente: %s\n' "$cmd" >&2
      failures=$((failures + 1))
    fi
  done

  if is_git_repo "$CONTROL_PLANE_SOURCE"; then
    if [[ -z "$(git -C "$CONTROL_PLANE_SOURCE" status --porcelain)" ]]; then
      pass "control plane clean @ $(repo_short "$CONTROL_PLANE_SOURCE")"
    else
      warn "control plane possui alterações; release-create será bloqueado"
    fi
  else
    printf '[FAIL] control plane ausente: %s\n' "$CONTROL_PLANE_SOURCE" >&2
    failures=$((failures + 1))
  fi

  local composition="$COMPOSITION_FILE"
  local resolved=""
  if resolved="$("$INFRA_ROOT/bin/sister-composition" resolve "$composition" --json)"; then
    local component_id root
    while IFS=$'\t' read -r component_id root; do
      if is_git_repo "$root" && [[ -z "$(git -C "$root" status --porcelain)" ]]; then
        pass "$component_id clean @ $(repo_short "$root")"
      else
        warn "$component_id ausente ou dirty: $root"
        failures=$((failures + 1))
      fi
    done < <(jq -r '.components[] | [.component_id,.root] | @tsv' <<<"$resolved")
  else
    failures=$((failures + 1))
  fi

  if [[ "$TEST_MODE" == "1" ]] || systemctl --user show-environment >/dev/null 2>&1; then
    pass "systemd --user"
  else
    printf '[FAIL] systemd --user indisponível\n' >&2
    failures=$((failures + 1))
  fi

  printf '\nInstall root: %s\n' "$INSTALL_ROOT"
  printf 'Config root:  %s\n' "$CONFIG_ROOT"
  printf 'State root:   %s\n' "$STATE_ROOT"

  [[ "$failures" -eq 0 ]] || die "doctor encontrou $failures falha(s)"
  pass "doctor READY"
}

plan() {
  printf 'Current release:  %s\n' "$(current_release_id)"
  printf 'Previous release: %s\n' "$(previous_release_id)"
  printf '\n%-10s %-12s %-12s %s\n' "component" "source" "current" "change"

  local release=""
  release="$(current_release_path || true)"

  local composition resolved component_id repo source_short current_short change
  composition="$COMPOSITION_FILE"
  resolved="$("$INFRA_ROOT/bin/sister-composition" resolve "$composition" --json)"

  while IFS=$'\t' read -r component_id repo; do
    source_short="$(git -C "$repo" rev-parse --short=12 HEAD)"
    current_short="-"
    change="NEW"

    if [[ -n "$release" && -f "$release/manifest.json" ]]; then
      current_short="$(jq -r --arg id "$component_id" \
        '.components[] | select(.component_id == $id) | .commit' \
        "$release/manifest.json" | cut -c1-12)"

      if [[ "$source_short" == "$current_short" ]]; then
        change="SAME"
      else
        change="UPDATE"
      fi
    fi

    printf '%-10s %-12s %-12s %s\n' "$component_id" "$source_short" "$current_short" "$change"
  done < <(jq -r '.components[] | [.component_id,.root] | @tsv' <<<"$resolved")

  printf '\nNo changes performed.\n'
}

workstation_repair() {
  local plan_only=0
  local json_output=0

  for arg in "$@"; do
    case "$arg" in
      --plan|--dry-run) plan_only=1 ;;
      --json) json_output=1 ;;
      *) die "opção desconhecida para repair: $arg" ;;
    esac
  done

  if [[ "$plan_only" -eq 0 ]]; then
    mkdir -p "$STATE_ROOT/locks"
    acquire_lifecycle_lock
  fi

  python3 - \
    "$INSTALL_ROOT" \
    "$CONFIG_ROOT" \
    "$STATE_ROOT" \
    "$SYSTEMD_USER_ROOT" \
    "$UNIT_NAME" \
    "$BIN_ROOT" \
    "$CURRENT_LINK" \
    "$HOME_DIR" \
    "$TEST_MODE" \
    "$plan_only" \
    "$json_output" <<'PY_WORKSTATION_REPAIR'
import hashlib
import json
import os
import socket
import stat
import subprocess
import sys
from pathlib import Path

(
    install_root_s,
    config_root_s,
    state_root_s,
    systemd_user_root_s,
    unit_name,
    bin_root_s,
    current_link_s,
    home_dir_s,
    test_mode_s,
    plan_only_s,
    json_output_s,
) = sys.argv[1:12]

install_root = Path(install_root_s).resolve()
config_root = Path(config_root_s).resolve()
state_root = Path(state_root_s).resolve()
systemd_user_root = Path(systemd_user_root_s).resolve()
bin_root = Path(bin_root_s).resolve()
current_link = Path(current_link_s)
home_dir = Path(home_dir_s).resolve()
test_mode = (test_mode_s == "1")
plan_only = (plan_only_s == "1")
json_output = (json_output_s == "1")

def fail_closed(code: str, reason: str) -> None:
    if json_output:
        doc = {
            "schema": "sister.infra.workstation.repair/1.0.0",
            "status": "FAIL_CLOSED",
            "code": code,
            "error": reason,
        }
        sys.stdout.write(json.dumps(doc, indent=2, sort_keys=True) + "\n")
    else:
        sys.stderr.write(f"[FAIL] repair recusado (FAIL-CLOSED: {code}): {reason}\n")
    sys.exit(1)

# 1. Validação de current e integridade da release
if not current_link.is_symlink():
    fail_closed("CURRENT_RELEASE_MISSING", f"link current ausente ou não é symlink: {current_link}")

try:
    release_path = current_link.resolve(strict=True)
except Exception as exc:
    fail_closed("CURRENT_RELEASE_MISSING", f"link current aponta para destino inexistente: {exc}")

if not release_path.is_dir():
    fail_closed("CURRENT_RELEASE_MISSING", f"release current não é diretório: {release_path}")

manifest_path = release_path / "manifest.json"
if not manifest_path.is_file():
    fail_closed("RELEASE_CORRUPTED", f"manifest.json ausente na release current: {manifest_path}")

try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except Exception as exc:
    fail_closed("RELEASE_CORRUPTED", f"manifest.json corrompido: {exc}")

if manifest.get("schema") != "sister.infra.workstation.release/3":
    fail_closed("RELEASE_CORRUPTED", f"schema de release incompatível: {manifest.get('schema')}")

release_id = manifest.get("release_id", release_path.name)

# Evidências e integridade estrutural
qual = manifest.get("qualification", {})
if qual.get("status") != "PASS":
    fail_closed("RELEASE_CORRUPTED", "qualification.status != PASS no manifesto")
qual_ev = release_path / qual.get("evidence", "")
if not qual_ev.is_file() or hashlib.sha256(qual_ev.read_bytes()).hexdigest() != qual.get("sha256"):
    fail_closed("RELEASE_CORRUPTED", "evidência de qualificação ausente ou com hash divergente")

dep = manifest.get("deployment", {})
if dep.get("status") != "READY":
    fail_closed("RELEASE_CORRUPTED", "deployment.status != READY no manifesto")
decl_ev = release_path / dep.get("declaration", "")
if not decl_ev.is_file() or hashlib.sha256(decl_ev.read_bytes()).hexdigest() != dep.get("declaration_sha256"):
    fail_closed("RELEASE_CORRUPTED", "declaração de deployment ausente ou com hash divergente")

res_ev = release_path / dep.get("evidence", "")
if not res_ev.is_file() or hashlib.sha256(res_ev.read_bytes()).hexdigest() != dep.get("sha256"):
    fail_closed("RELEASE_CORRUPTED", "evidência de deployment resolvido ausente ou com hash divergente")

try:
    resolved_deployment = json.loads(res_ev.read_text(encoding="utf-8"))
except Exception as exc:
    fail_closed("DEPLOYMENT_DIVERGENT", f"deployment resolvido corrompido: {exc}")

if resolved_deployment.get("schema") != "sister.infra.deployment.resolved/1" or resolved_deployment.get("status") != "READY":
    fail_closed("DEPLOYMENT_DIVERGENT", "deployment resolvido sem schema/status READY")

# Git control plane e componentes na release
ctrl = manifest.get("control_plane", {})
ctrl_path = release_path / ctrl.get("path", "")
if not (ctrl_path / ".git").is_dir():
    fail_closed("RELEASE_CORRUPTED", f"control plane Git ausente em {ctrl_path}")
r_head = subprocess.run(["git", "-C", str(ctrl_path), "rev-parse", "HEAD"], stdout=subprocess.PIPE, text=True)
if r_head.returncode != 0 or r_head.stdout.strip() != ctrl.get("commit"):
    fail_closed("RELEASE_CORRUPTED", "commit do control plane na release diverge do manifesto")
r_st = subprocess.run(["git", "--no-optional-locks", "-C", str(ctrl_path), "status", "--porcelain", "--untracked-files=no"], stdout=subprocess.PIPE, text=True)
if r_st.stdout.strip():
    fail_closed("RELEASE_CORRUPTED", "control plane possui alterações rastreadas na release")

for comp in manifest.get("components", []):
    c_root = release_path / comp.get("path", "")
    if not (c_root / ".git").is_dir():
        fail_closed("RELEASE_CORRUPTED", f"componente Git ausente: {comp.get('component_id')}")
    r_c_head = subprocess.run(["git", "-C", str(c_root), "rev-parse", "HEAD"], stdout=subprocess.PIPE, text=True)
    if r_c_head.returncode != 0 or r_c_head.stdout.strip() != comp.get("commit"):
        fail_closed("RELEASE_CORRUPTED", f"commit do componente {comp.get('component_id')} diverge do manifesto")
    r_c_st = subprocess.run(["git", "--no-optional-locks", "-C", str(c_root), "status", "--porcelain", "--untracked-files=no"], stdout=subprocess.PIPE, text=True)
    if r_c_st.stdout.strip():
        fail_closed("RELEASE_CORRUPTED", f"componente {comp.get('component_id')} possui alterações rastreadas na release")
    if comp.get("runtime"):
        entrypoint = c_root / comp.get("runtime", {}).get("entrypoint", "")
        if not os.access(entrypoint, os.X_OK):
            fail_closed("RELEASE_CORRUPTED", f"entrypoint de {comp.get('component_id')} não é executável")
    for art in comp.get("artifacts", []):
        art_p = c_root / art.get("path", "")
        if not art_p.is_file() or hashlib.sha256(art_p.read_bytes()).hexdigest() != art.get("sha256"):
            fail_closed("RELEASE_CORRUPTED", f"artefato {art.get('id')} corrompido ou ausente")

# 2. Dados persistentes
for comp in resolved_deployment.get("components", []):
    cid = comp.get("component_id")
    p_dir = state_root / "components" / cid
    if p_dir.exists() and not p_dir.is_dir():
        fail_closed("PERSISTENT_DATA_CORRUPTED", f"caminho de estado persistente de {cid} existe e não é diretório: {p_dir}")

# 3. Autoridade TLS
has_gateway = any(c.get("gateway") for c in resolved_deployment.get("components", []))
tls_dir = config_root / "tls"
ca_cert = tls_dir / "ecosystem-lab-ca.crt"
leaf_pem = tls_dir / "ecosystem-lab.pem"

if has_gateway:
    if not ca_cert.is_file():
        fail_closed("TLS_AUTHORITY_INVALID", f"CA de laboratório ausente em {ca_cert} (repair não cria CA)")
    if not leaf_pem.is_file():
        fail_closed("TLS_AUTHORITY_INVALID", f"Certificado leaf ausente em {leaf_pem} (repair não emite folha)")

    r_ca = subprocess.run(["openssl", "x509", "-in", str(ca_cert), "-noout"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r_ca.returncode != 0:
        fail_closed("TLS_AUTHORITY_INVALID", f"CA de laboratório corrompida ou não parseável: {ca_cert}")

    r_leaf = subprocess.run(["openssl", "x509", "-in", str(leaf_pem), "-noout"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r_leaf.returncode != 0:
        fail_closed("TLS_AUTHORITY_INVALID", f"Certificado leaf corrompido ou não parseável: {leaf_pem}")

    r_verify = subprocess.run(["openssl", "verify", "-CAfile", str(ca_cert), str(leaf_pem)], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r_verify.returncode != 0:
        fail_closed("TLS_AUTHORITY_INVALID", f"Certificado leaf não valida contra a CA corrente: {leaf_pem}")

# 4. Portas e colisão com processos externos
def check_port_in_use(host: str, port: int) -> bool:
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
            sock.settimeout(0.3)
            return sock.connect_ex((host, port)) == 0
    except Exception:
        return False

comp_status = {}
for comp in resolved_deployment.get("components", []):
    cid = comp.get("component_id")
    rt = comp.get("runtime", {})
    if not rt:
        continue
    host = rt.get("listen", "127.0.0.1")
    port = rt.get("port")
    c_path = release_path / comp.get("component_path", "")
    entrypoint = comp.get("runtime", {}).get("entrypoint", "")
    if not entrypoint:
        for mc in manifest.get("components", []):
            if mc.get("component_id") == cid:
                entrypoint = mc.get("runtime", {}).get("entrypoint", "")
                break

    env = os.environ.copy()
    env["SISTER_RESOLVED_DEPLOYMENT_FILE"] = str(res_ev)
    env["SISTER_COMPONENT_CONFIG_FILE"] = str(config_root / f"{cid}.env")
    env["SISTER_RUNTIME_STATE_DIR"] = str(state_root / "components" / cid)
    env["SISTER_RUNTIME_RUN_DIR"] = str(state_root / "run" / cid)

    r_status = subprocess.run([str(c_path / entrypoint), "status"], cwd=str(c_path), env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    is_running = (r_status.returncode == 0)

    port_used = check_port_in_use(host, port) if (port and rt.get("transport") == "tcp") else False
    if port_used and not is_running:
        fail_closed("PORT_COLLISION_EXTERNAL", f"porta {port} declarada para {cid} ocupada por processo externo não gerenciado")

    comp_status[cid] = {
        "comp": comp,
        "c_path": c_path,
        "entrypoint": entrypoint,
        "env": env,
        "is_running": is_running,
        "port_used": port_used,
        "port": port,
        "host": host,
    }

gw_pid_file = state_root / "control-plane" / "gateway" / f"haproxy-{os.environ.get('PROFILE', 'lan')}.pid"
gw_running = False
if gw_pid_file.is_file():
    if test_mode:
        gw_running = True
    else:
        try:
            pid = int(gw_pid_file.read_text().strip())
            os.kill(pid, 0)
            gw_running = True
        except (ValueError, OSError):
            gw_running = False

gateway = resolved_deployment.get("gateway") or {}
gw_port_value = os.environ.get("GATEWAY_LISTEN_PORT", "").strip() or gateway.get("port")
gw_addr = os.environ.get("GATEWAY_LISTEN_ADDRESS", "").strip() or gateway.get("listen")
if not gw_port_value or not gw_addr:
    fail_closed("GATEWAY_AUTHORITY_MISSING", "gateway.listen/port ausente no deployment resolvido")
gw_port = int(gw_port_value)
if test_mode:
    gw_port_used = (os.environ.get("SISTER_TEST_GATEWAY_PORT_COLLISION") == "1")
else:
    gw_port_used = check_port_in_use(gw_addr, gw_port)

if gw_port_used and not gw_running:
    fail_closed("PORT_COLLISION_EXTERNAL", f"porta {gw_port} do gateway ocupada por processo externo não gerenciado")

# 5. Detecção de Drift e Construção do Plano
plan_items = []

# Categoria 1: Symlink CLI
cli_link = bin_root / "sister-infra"
expected_cli_target = (
    current_link
    / "components"
    / "sister-infra"
    / "bin"
    / "sister-infra"
)
cli_drift = False
cli_actual = "valid"
if not cli_link.is_symlink():
    cli_drift = True
    cli_actual = "absent" if not cli_link.exists() else "not_a_symlink"
else:
    try:
        if cli_link.resolve() != expected_cli_target.resolve():
            cli_drift = True
            cli_actual = str(cli_link.resolve())
    except Exception:
        cli_drift = True
        cli_actual = "broken_symlink"

if cli_drift:
    plan_items.append({
        "category": "symlink",
        "resource": str(cli_link),
        "divergence": f"symlink do CLI sister-infra aponta para destino incorreto ou ausente ({cli_actual})",
        "expected": str(expected_cli_target),
        "actual": cli_actual,
        "action": f"atualizar symlink {cli_link} -> {expected_cli_target}",
        "action_type": "RESTORE_CLI_SYMLINK",
    })

# Categoria 2: Permissões de Runtime
unit_file = systemd_user_root / unit_name
expected_file_modes = [
    (config_root / "runtime.env", 0o600, "arquivo runtime.env"),
    (unit_file, 0o644, "unit systemd"),
    (config_root / "tls", 0o700, "diretório tls"),
    (config_root / "tls" / "ecosystem-lab-ca.key", 0o600, "chave CA"),
    (config_root / "tls" / "ecosystem-lab-ca.crt", 0o644, "certificado CA"),
    (config_root / "tls" / "ecosystem-lab.key", 0o600, "chave leaf"),
    (config_root / "tls" / "ecosystem-lab.pem", 0o600, "bundle PEM leaf"),
]

for path_target, exp_mode, desc in expected_file_modes:
    if path_target.exists() and not path_target.is_symlink():
        act_mode = stat.S_IMODE(path_target.stat().st_mode)
        if act_mode != exp_mode:
            plan_items.append({
                "category": "permission",
                "resource": str(path_target),
                "divergence": f"permissão de {desc} diverge ({oct(act_mode)} != {oct(exp_mode)})",
                "expected": oct(exp_mode),
                "actual": oct(act_mode),
                "action": f"ajustar permissões de {path_target} para {oct(exp_mode)}",
                "action_type": "CHMOD",
                "target_mode": exp_mode,
            })

runtime_dirs = [
    (config_root, "diretório config_root"),
    (state_root, "diretório state_root"),
    (state_root / "control-plane", "diretório control-plane"),
    (state_root / "run", "diretório run"),
    (state_root / "components", "diretório components"),
]
for dir_target, desc in runtime_dirs:
    if dir_target.exists() and dir_target.is_dir() and not dir_target.is_symlink():
        act_mode = stat.S_IMODE(dir_target.stat().st_mode)
        if (act_mode & 0o002 != 0) or act_mode == 0o777:
            plan_items.append({
                "category": "permission",
                "resource": str(dir_target),
                "divergence": f"permissão insegura em {desc} ({oct(act_mode)} possui escrita global)",
                "expected": "0o700",
                "actual": oct(act_mode),
                "action": f"restringir permissões de {dir_target} para 0o700",
                "action_type": "CHMOD",
                "target_mode": 0o700,
            })

# Categoria 3: Unit Systemd Derivável
unit_template = release_path / "components" / "sister-infra" / "templates" / "systemd" / "sister-workstation.service.in"
if not unit_template.is_file():
    fail_closed("RELEASE_CORRUPTED", f"template systemd ausente na release current: {unit_template}")

expected_unit_content = unit_template.read_text(encoding="utf-8").replace("%h", str(home_dir))
unit_drift = False
unit_actual_desc = "valid"
if not unit_file.is_file():
    unit_drift = True
    unit_actual_desc = "absent"
else:
    try:
        if unit_file.read_text(encoding="utf-8") != expected_unit_content:
            unit_drift = True
            unit_actual_desc = "content_diverged"
    except Exception:
        unit_drift = True
        unit_actual_desc = "unreadable"

if unit_drift:
    plan_items.append({
        "category": "systemd_unit",
        "resource": str(unit_file),
        "divergence": f"arquivo de serviço systemd ausente ou divergente do template ({unit_actual_desc})",
        "expected": "renderizado a partir do template da release current",
        "actual": unit_actual_desc,
        "action": f"re-renderizar {unit_file} a partir do template e executar daemon-reload",
        "action_type": "RESTORE_SYSTEMD_UNIT",
        "content": expected_unit_content,
    })

# Categoria 4: Participantes Gerenciados Parados
for cid, info in comp_status.items():
    if not info["is_running"] and not info["port_used"]:
        plan_items.append({
            "category": "component_process",
            "resource": cid,
            "divergence": f"participante gerenciado {cid} está parado (porta {info['port']} livre)",
            "expected": "running",
            "actual": "stopped",
            "action": f"iniciar participante {cid} via entrypoint da release current e validar health",
            "action_type": "START_COMPONENT",
            "comp_info": info,
        })

# Categoria 5: Gateway Gerenciado Parado
if has_gateway and not gw_running and not gw_port_used:
    plan_items.append({
        "category": "gateway_process",
        "resource": "gateway",
        "divergence": "gateway declarativo está parado (porta livre e autoridade íntegra)",
        "expected": "running",
        "actual": "stopped",
        "action": "iniciar gateway pelo adapter privado de runtime do control plane",
        "action_type": "START_GATEWAY",
    })

# 6. Modo Plan-Only
clean_plan = [{k: v for k, v in item.items() if not k.endswith("_info") and k != "content" and k != "target_mode"} for item in plan_items]

if plan_only:
    if not plan_items:
        if json_output:
            doc = {
                "schema": "sister.infra.workstation.repair/1.0.0",
                "status": "NO_OP",
                "release_id": release_id,
                "plan": [],
                "actions_applied": [],
                "verification": {"status": "PASS", "details": "workstation íntegra; nenhum drift detectado"},
            }
            sys.stdout.write(json.dumps(doc, indent=2, sort_keys=True) + "\n")
        else:
            sys.stderr.write("[PASS] workstation íntegra; nenhum drift detectado (NO_OP)\n")
    else:
        if json_output:
            doc = {
                "schema": "sister.infra.workstation.repair/1.0.0",
                "status": "PLANNED",
                "release_id": release_id,
                "plan": clean_plan,
                "actions_applied": [],
                "verification": {"status": "PENDING"},
            }
            sys.stdout.write(json.dumps(doc, indent=2, sort_keys=True) + "\n")
        else:
            print(f"=== REPAIR PLAN ({release_id}) ===")
            for item in clean_plan:
                print(f"[PLAN] {item['category']}: {item['resource']} -> {item['action']}")
            print(f"Total: {len(clean_plan)} ação(ões) planejada(s). Nenhuma alteração realizada (--plan).")
    sys.exit(0)

# 7. Execução de Ações Mínimas
if not plan_items:
    if json_output:
        doc = {
            "schema": "sister.infra.workstation.repair/1.0.0",
            "status": "NO_OP",
            "release_id": release_id,
            "plan": [],
            "actions_applied": [],
            "verification": {"status": "PASS", "details": "workstation íntegra; nenhuma ação de repair necessária"},
        }
        sys.stdout.write(json.dumps(doc, indent=2, sort_keys=True) + "\n")
    else:
        sys.stderr.write("[PASS] workstation íntegra; nenhuma ação de repair necessária (NO_OP)\n")
    sys.exit(0)

actions_applied = []
for item in plan_items:
    atype = item["action_type"]
    if atype == "RESTORE_CLI_SYMLINK":
        bin_root.mkdir(parents=True, exist_ok=True)
        tmp_link = bin_root / f".tmp-cli-{os.getpid()}"
        if tmp_link.exists() or tmp_link.is_symlink():
            tmp_link.unlink()
        os.symlink(expected_cli_target, tmp_link)
        tmp_link.replace(cli_link)
        actions_applied.append({"category": "symlink", "resource": str(cli_link), "status": "APPLIED"})
        if not json_output:
            sys.stderr.write(f"[REPAIR] symlink restaurado: {cli_link} -> {expected_cli_target}\n")

    elif atype == "CHMOD":
        path_target = Path(item["resource"])
        os.chmod(path_target, item["target_mode"])
        actions_applied.append({"category": "permission", "resource": str(path_target), "status": "APPLIED"})
        if not json_output:
            sys.stderr.write(f"[REPAIR] permissão corrigida: {path_target} -> {item['expected']}\n")

    elif atype == "RESTORE_SYSTEMD_UNIT":
        unit_file.parent.mkdir(parents=True, exist_ok=True)
        unit_file.write_text(item["content"], encoding="utf-8")
        os.chmod(unit_file, 0o644)
        if not test_mode:
            subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        actions_applied.append({"category": "systemd_unit", "resource": str(unit_file), "status": "APPLIED"})
        if not json_output:
            sys.stderr.write(f"[REPAIR] unit systemd re-renderizada: {unit_file}\n")

    elif atype == "START_COMPONENT":
        cinfo = item["comp_info"]
        r_start = subprocess.run([str(cinfo["c_path"] / cinfo["entrypoint"]), "start"], cwd=str(cinfo["c_path"]), env=cinfo["env"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r_start.returncode != 0:
            fail_closed("REPAIR_FAILED", f"falha ao iniciar participante {item['resource']}: {r_start.stderr.decode('utf-8', errors='replace')}")
        r_health = subprocess.run([str(cinfo["c_path"] / cinfo["entrypoint"]), "health"], cwd=str(cinfo["c_path"]), env=cinfo["env"], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r_health.returncode != 0:
            fail_closed("REPAIR_FAILED", f"participante {item['resource']} não passou no health após start")
        actions_applied.append({"category": "component_process", "resource": item["resource"], "status": "APPLIED"})
        if not json_output:
            sys.stderr.write(f"[REPAIR] participante reiniciado e verificado: {item['resource']}\n")

    elif atype == "START_GATEWAY":
        if test_mode:
            gw_pid_file = state_root / "control-plane" / "gateway" / f"haproxy-{os.environ.get('PROFILE', 'lan')}.pid"
            gw_pid_file.parent.mkdir(parents=True, exist_ok=True)
            gw_pid_file.write_text(str(os.getpid()))
            actions_applied.append({"category": "gateway_process", "resource": "gateway", "status": "APPLIED"})
        else:
            env_gw = os.environ.copy()
            env_gw["SISTER_RESOLVED_DEPLOYMENT_FILE"] = str(res_ev)
            env_gw["SISTER_INFRA_RUN_ROOT"] = str(state_root / "control-plane")
            env_gw["TLS_PEM"] = str(config_root / "tls" / "ecosystem-lab.pem")
            env_gw["CA_CERT"] = str(config_root / "tls" / "ecosystem-lab-ca.crt")
            env_gw["CA_KEY"] = str(config_root / "tls" / "ecosystem-lab-ca.key")
            ctrl_bin = release_path / ctrl.get("path", "") / "bin" / "sister-infra"
            r_gw = subprocess.run([str(ctrl_bin), "up", "--profile", os.environ.get("PROFILE", "lan")], env=env_gw, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            if r_gw.returncode != 0:
                fail_closed("REPAIR_FAILED", f"falha ao iniciar gateway: {r_gw.stderr.decode('utf-8', errors='replace')}")
            actions_applied.append({"category": "gateway_process", "resource": "gateway", "status": "APPLIED"})
        if not json_output:
            sys.stderr.write("[REPAIR] gateway declarativo reiniciado com sucesso\n")

# 8. Pós-Verificação
if not cli_link.is_symlink() or cli_link.resolve() != expected_cli_target.resolve():
    fail_closed("POST_VERIFY_FAILED", f"symlink do CLI {cli_link} permaneceu inválido após repair")

if not unit_file.is_file() or unit_file.read_text(encoding="utf-8") != expected_unit_content:
    fail_closed("POST_VERIFY_FAILED", f"unit systemd {unit_file} permaneceu inválida após repair")

for path_target, exp_mode, desc in expected_file_modes:
    if path_target.exists() and not path_target.is_symlink():
        if stat.S_IMODE(path_target.stat().st_mode) != exp_mode:
            fail_closed("POST_VERIFY_FAILED", f"permissão de {desc} permaneceu divergente após repair")

# 9. Relatório Final
if json_output:
    doc = {
        "schema": "sister.infra.workstation.repair/1.0.0",
        "status": "REPAIRED",
        "release_id": release_id,
        "plan": clean_plan,
        "actions_applied": actions_applied,
        "verification": {"status": "PASS", "details": "todas as verificações pós-repair passaram com sucesso"},
    }
    sys.stdout.write(json.dumps(doc, indent=2, sort_keys=True) + "\n")
else:
    sys.stderr.write(f"[PASS] workstation repair concluído com sucesso ({len(actions_applied)} ação(ões) aplicada(s))\n")
    print(f"repair={release_id} actions={len(actions_applied)} status=REPAIRED")
PY_WORKSTATION_REPAIR
}

status() {
  printf 'Current:  %s\n' "$(current_release_id)"
  printf 'Previous: %s\n' "$(previous_release_id)"
  printf 'Unit:     %s\n' "$UNIT_NAME"
  printf 'Authority root: %s\n' "$CONFIG_ROOT"
  "$AUTHORITY_CLI" resolve --target lab --allow-missing

  if [[ "$TEST_MODE" == "1" ]]; then
    printf 'Service:  TEST_MODE\n'
  else
    printf 'Service:  %s\n' "$(systemctl --user is-active "$UNIT_NAME" 2>/dev/null || true)"
  fi

  local release=""
  release="$(current_release_path || true)"

  if [[ -n "$release" ]]; then
    printf 'Path:     %s\n' "$release"
    release_integrity "$release"

    printf '\n--- ecosystem status ---\n'
    runtime_status || true
  fi
}

release_list() {

  local d

  for d in "$RELEASES_ROOT"/wr-*; do
    [[ -d "$d" ]] || continue

    local id marker=""
    id="$(basename "$d")"

    [[ "$(current_release_id)" == "$id" ]] && marker="${marker} current"
    [[ "$(previous_release_id)" == "$id" ]] && marker="${marker} previous"

    printf '%s%s\n' "$id" "$marker"
  done
}

logs_cmd() {
  if [[ "$TEST_MODE" == "1" ]]; then
    info "TEST_MODE: logs indisponíveis"
    return 0
  fi

  journalctl --user -u "$UNIT_NAME" -n "${SISTER_WORKSTATION_LOG_LINES:-120}" --no-pager
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    check) workstation_check ;;
    bootstrap) workstation_bootstrap ;;
    doctor) doctor ;;
    repair) workstation_repair "$@" ;;
    plan) plan ;;
    candidate-create) materialize_composition_candidate "${1:-}" ;;
    candidate-verify) candidate_verify "${1:-}" ;;
    release-create) release_create "$@" ;;
    release-verify) release_verify "$@" ;;
    release-switch) release_switch "$@" ;;
    runtime-start) runtime_start ;;
    runtime-stop) runtime_stop ;;
    runtime-status) runtime_status ;;
    runtime-verify) runtime_verify ;;
    release-list) release_list ;;
    install) install_release "${1:-}" ;;
    promote)
      [[ -n "${1:-}" ]] || die "promote requer id"
      promote_release "$1"
      ;;
    activate) activate_workstation ;;
    start) start_service ;;
    stop) stop_service ;;
    restart) restart_service ;;
    status) status ;;
    verify) verify_installed ;;
    update) update_workstation ;;
    rollback) rollback_workstation ;;
    logs) logs_cmd ;;
    client-env) cmd_client_env ;;
    hosts-line|hosts) cmd_hosts_line ;;
    current)
      printf 'current=%s\n' "$(current_release_id)"
      printf 'previous=%s\n' "$(previous_release_id)"
      ;;
    help|-h|--help) usage ;;
    *) die "comando workstation desconhecido: $command" ;;
  esac
}

main "$@"
