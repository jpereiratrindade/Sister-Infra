#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
INFRA_ROOT="$(cd "$SELF_DIR/.." && pwd -P)"

HOME_DIR="${HOME:?HOME não definido}"
INSTALL_ROOT="${SISTER_WORKSTATION_INSTALL_ROOT:-$HOME_DIR/.local/share/sister}"
RELEASES_ROOT="$INSTALL_ROOT/releases"
CANDIDATES_ROOT="$INSTALL_ROOT/candidates"
CURRENT_LINK="$INSTALL_ROOT/current"
PREVIOUS_LINK="$INSTALL_ROOT/previous"

CONFIG_ROOT="${SISTER_WORKSTATION_CONFIG_ROOT:-$HOME_DIR/.config/sister/workstation}"
STATE_ROOT="${SISTER_WORKSTATION_STATE_ROOT:-$HOME_DIR/.local/state/sister/workstation}"
SYSTEMD_USER_ROOT="${SISTER_WORKSTATION_SYSTEMD_ROOT:-$HOME_DIR/.config/systemd/user}"
UNIT_NAME="${SISTER_WORKSTATION_UNIT_NAME:-sister-workstation.service}"
UNIT_FILE="$SYSTEMD_USER_ROOT/$UNIT_NAME"
BIN_ROOT="${SISTER_WORKSTATION_BIN_ROOT:-$HOME_DIR/.local/bin}"
CLI_LINK="$BIN_ROOT/sister-infra"

SOURCE_WORKSPACE_FILE="$CONFIG_ROOT/source-workspace"
RUNTIME_ENV="$CONFIG_ROOT/runtime.env"
TLS_CONFIG="$CONFIG_ROOT/tls"
NEXO_ENV="$CONFIG_ROOT/nexo.env"
SISTER_ENV="$CONFIG_ROOT/sister.env"

COMPOSITION_FILE="${SISTER_WORKSTATION_COMPOSITION_FILE:-$CONFIG_ROOT/composition.json}"
DEPLOYMENT_FILE="${SISTER_WORKSTATION_DEPLOYMENT_FILE:-$CONFIG_ROOT/deployment.json}"
COMPOSITION_CONTRACTS_ROOT="${SISTER_WORKSTATION_CONTRACTS_ROOT:-}"

TEST_MODE="${SISTER_WORKSTATION_TEST_MODE:-0}"

pass() { printf '[PASS] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
info() { printf '[INFO] %s\n' "$*"; }
die()  { printf '[FAIL] %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
SisTer Infra — workstation deployment control plane

Uso:
  sister-infra workstation <comando>

Comandos:
  doctor          valida host, fontes, Git, systemd e layout
  plan            mostra diferença entre release atual e fontes, sem mutar
  release-create  cria release declarativa qualificada e READY
  release-create-legacy  cria release pelo caminho concreto de transição
  release-create-composition [arquivo]  materializa candidata declarativa
  candidate-verify <id>  verifica candidata declarativa materializada
  runtime-start   inicia participantes e gateway da release declarativa
  runtime-stop    para gateway e participantes da release declarativa
  runtime-status  observa participantes da release declarativa
  runtime-verify  verifica participantes e gateway declarativos
  release-list    lista releases instaladas
  install [id]    seleciona release e instala unidade systemd (não inicia)
  promote <id>    promove release já verificada com rollback automático
  activate        migra o runtime atual para o serviço workstation
  start           inicia a instalação workstation
  stop            para a instalação workstation
  restart         reinicia a instalação workstation
  status          mostra release, serviço e saúde agregada
  verify          verifica integridade da release e endpoints
  update          cria release das fontes, promove e verifica; rollback em falha
  rollback        retorna para previous e verifica
  logs            mostra journal do serviço
  current         mostra release current/previous
  help            esta ajuda
EOF
}

ensure_dirs() {
  mkdir -p \
    "$RELEASES_ROOT" \
    "$CANDIDATES_ROOT" \
    "$CONFIG_ROOT" \
    "$STATE_ROOT" \
    "$SYSTEMD_USER_ROOT" \
    "$BIN_ROOT"
}

source_workspace_guess() {
  if [[ -n "${SISTER_SOURCE_WORKSPACE:-}" ]]; then
    printf '%s\n' "$SISTER_SOURCE_WORKSPACE"
    return 0
  fi

  if [[ -f "$SOURCE_WORKSPACE_FILE" ]]; then
    cat "$SOURCE_WORKSPACE_FILE"
    return 0
  fi

  local parent
  parent="$(dirname "$INFRA_ROOT")"

  if [[ -d "$parent/SisTer/.git" &&
        -d "$parent/sister-nexo/.git" &&
        -d "$parent/sister-praxis/.git" &&
        -d "$parent/sister-infra/.git" ]]; then
    printf '%s\n' "$parent"
    return 0
  fi

  return 1
}

repo_path() {
  local workspace="$1"
  local kind="$2"

  case "$kind" in
    infra)  printf '%s\n' "$workspace/sister-infra" ;;
    sister) printf '%s\n' "$workspace/SisTer" ;;
    nexo)   printf '%s\n' "$workspace/sister-nexo" ;;
    praxis) printf '%s\n' "$workspace/sister-praxis" ;;
    *) die "componente desconhecido: $kind" ;;
  esac
}

require_repo_clean() {
  local repo="$1"
  local name="$2"

  [[ -d "$repo/.git" ]] || die "$name não localizado: $repo"

  local dirty
  dirty="$(git -C "$repo" status --porcelain)"
  [[ -z "$dirty" ]] || {
    printf '%s\n' "$dirty" >&2
    die "$name possui alterações locais; release recusada"
  }
}

repo_head() {
  git -C "$1" rev-parse HEAD
}

repo_short() {
  git -C "$1" rev-parse --short=7 HEAD
}

release_path_by_id() {
  printf '%s\n' "$RELEASES_ROOT/$1"
}

link_target_id() {
  local link="$1"
  if [[ -L "$link" ]]; then
    basename "$(readlink -f "$link")"
  else
    printf '%s\n' "-"
  fi
}

current_release_path() {
  [[ -L "$CURRENT_LINK" ]] || return 1
  readlink -f "$CURRENT_LINK"
}

current_release_id() {
  link_target_id "$CURRENT_LINK"
}

previous_release_id() {
  link_target_id "$PREVIOUS_LINK"
}

manifest_path() {
  printf '%s\n' "$1/manifest.json"
}

manifest_value() {
  local release="$1"
  local jq_expr="$2"
  jq -r "$jq_expr" "$(manifest_path "$release")"
}

release_integrity() {
  local release="$1"

  [[ -d "$release" ]] || die "release ausente: $release"
  [[ -f "$(manifest_path "$release")" ]] || die "manifest ausente em $release"

  if jq -e \
      '.schema == "sister.infra.workstation.release/3"' \
      "$(manifest_path "$release")" >/dev/null; then
    declarative_release_integrity "$release"
    return
  fi

  local component repo expected actual tracked

  for component in infra sister nexo praxis; do
    case "$component" in
      infra) repo="$release/components/sister-infra" ;;
      sister) repo="$release/components/SisTer" ;;
      nexo) repo="$release/components/sister-nexo" ;;
      praxis) repo="$release/components/sister-praxis" ;;
    esac

    [[ -d "$repo/.git" ]] || die "release corrompida: $component sem .git"

    expected="$(manifest_value "$release" ".components.$component.commit")"
    actual="$(git -C "$repo" rev-parse HEAD)"

    [[ "$expected" == "$actual" ]] || \
      die "release corrompida: $component HEAD divergiu do manifesto"

    tracked="$(git -C "$repo" status --porcelain --untracked-files=no)"
    [[ -z "$tracked" ]] || {
      printf '%s\n' "$tracked" >&2
      die "release corrompida: arquivos rastreados de $component foram alterados"
    }
  done

  local build_status
  build_status="$(jq -r '.qualification.build.status // "UNQUALIFIED"' "$(manifest_path "$release")")"

  if [[ "$build_status" == "PASS" ]]; then
    local artifact component_name relpath expected_hash actual_hash absolute

    while IFS=$'\t' read -r artifact component_name relpath expected_hash; do
      [[ -n "$artifact" ]] || continue

      case "$component_name" in
        sister) absolute="$release/components/SisTer/$relpath" ;;
        nexo) absolute="$release/components/sister-nexo/$relpath" ;;
        praxis) absolute="$release/components/sister-praxis/$relpath" ;;
        *) die "manifesto contém componente de artefato desconhecido: $component_name" ;;
      esac

      [[ -x "$absolute" ]] || \
        die "release corrompida: artefato ausente/não executável: $artifact"

      actual_hash="$(sha256sum "$absolute" | awk '{print $1}')"

      [[ "$actual_hash" == "$expected_hash" ]] || \
        die "release corrompida: hash divergente para $artifact"
    done < <(
      jq -r '
        .qualification.build.artifacts
        | to_entries[]
        | [.key, .value.component, .value.path, .value.sha256]
        | @tsv
      ' "$(manifest_path "$release")"
    )
  fi

  pass "integridade da release $(basename "$release")"
}

write_source_workspace() {
  local workspace="$1"

  ensure_dirs
  printf '%s\n' "$(cd "$workspace" && pwd -P)" > "$SOURCE_WORKSPACE_FILE"
  chmod 600 "$SOURCE_WORKSPACE_FILE"
}

ensure_runtime_env() {
  ensure_dirs

  if [[ ! -f "$RUNTIME_ENV" ]]; then
    cat > "$RUNTIME_ENV" <<'EOF'
NO_PROXY=localhost,127.0.0.1,::1,10.163.80.176,sister-gateway.test,nexo-gateway.test,praxis-gateway.test
no_proxy=localhost,127.0.0.1,::1,10.163.80.176,sister-gateway.test,nexo-gateway.test,praxis-gateway.test
EOF
    chmod 600 "$RUNTIME_ENV"
  fi
}

copy_operational_config() {
  local workspace="$1"
  local release="$2"

  ensure_runtime_env

  local source_infra source_nexo source_sister
  source_infra="$(repo_path "$workspace" infra)"
  source_nexo="$(repo_path "$workspace" nexo)"
  source_sister="$(repo_path "$workspace" sister)"

  # TLS é configuração persistente de implantação.
  #
  # Preserve o diretório Git-tracked secrets/ da release, inclusive
  # secrets/.gitkeep. Material TLS entra arquivo a arquivo por symlink.
  mkdir -p "$TLS_CONFIG"
  chmod 700 "$TLS_CONFIG"

  if [[ -d "$source_infra/secrets" ]]; then
    if [[ -z "$(find "$TLS_CONFIG" -mindepth 1 -maxdepth 1 ! -name '.gitkeep' -print -quit 2>/dev/null)" ]]; then
      local source_secret
      local secret_name

      while IFS= read -r -d '' source_secret; do
        secret_name="$(basename "$source_secret")"
        [[ "$secret_name" != ".gitkeep" ]] || continue
        cp -p "$source_secret" "$TLS_CONFIG/$secret_name"
      done < <(
        find "$source_infra/secrets" \
          -mindepth 1 \
          -maxdepth 1 \
          -type f \
          -print0
      )

      chmod 700 "$TLS_CONFIG"
      find "$TLS_CONFIG" -type f -name '*.key' -exec chmod 600 {} +
      find "$TLS_CONFIG" -type f -name '*.pem' -exec chmod 600 {} +
    fi
  fi

  local release_secrets="$release/components/sister-infra/secrets"
  mkdir -p "$release_secrets"

  local persisted_secret
  local persisted_name
  local tracked_path

  while IFS= read -r -d '' persisted_secret; do
    persisted_name="$(basename "$persisted_secret")"
    [[ "$persisted_name" != ".gitkeep" ]] || continue

    tracked_path="secrets/$persisted_name"

    if git -C "$release/components/sister-infra" \
        ls-files --error-unmatch "$tracked_path" >/dev/null 2>&1; then
      die "configuração TLS colide com arquivo rastreado: $tracked_path"
    fi

    rm -f "$release_secrets/$persisted_name"
    ln -s "$persisted_secret" "$release_secrets/$persisted_name"
  done < <(
    find "$TLS_CONFIG" \
      -mindepth 1 \
      -maxdepth 1 \
      -type f \
      ! -name '.gitkeep' \
      -print0
  )

  # Nexo exige .env atualmente. Persista-o fora da release.
  if [[ ! -f "$NEXO_ENV" ]]; then
    if [[ -f "$source_nexo/.env" ]]; then
      cp -p "$source_nexo/.env" "$NEXO_ENV"
      chmod 600 "$NEXO_ENV"
    elif [[ -f "$source_nexo/.env.example" ]]; then
      cp -p "$source_nexo/.env.example" "$NEXO_ENV"
      chmod 600 "$NEXO_ENV"
      warn "Nexo não possuía .env; copiado .env.example para $NEXO_ENV"
    fi
  fi

  if [[ -f "$NEXO_ENV" ]]; then
    rm -f "$release/components/sister-nexo/.env"
    ln -s "$NEXO_ENV" "$release/components/sister-nexo/.env"
  fi

  # SisTer segue a mesma política se existir .env local.
  if [[ ! -f "$SISTER_ENV" && -f "$source_sister/.env" ]]; then
    cp -p "$source_sister/.env" "$SISTER_ENV"
    chmod 600 "$SISTER_ENV"
  fi

  if [[ -f "$SISTER_ENV" ]]; then
    rm -f "$release/components/SisTer/.env"
    ln -s "$SISTER_ENV" "$release/components/SisTer/.env"
  fi
}

clone_component() {
  local source="$1"
  local dest="$2"
  local commit="$3"

  git clone --no-hardlinks --quiet "$source" "$dest"
  git -C "$dest" checkout --quiet --detach "$commit"

  if git -C "$dest" remote get-url origin >/dev/null 2>&1; then
    git -C "$dest" remote remove origin
  fi

  [[ "$(git -C "$dest" rev-parse HEAD)" == "$commit" ]] || \
    die "clone não materializou commit esperado em $dest"
}

# SISTER-INFRA-CR05-COMPOSITION-BEGIN
composition_path() {
  local requested="${1:-$COMPOSITION_FILE}"

  [[ -n "$requested" ]] || die "arquivo de composição não informado"
  [[ -f "$requested" ]] || die "composição ausente: $requested"

  (
    cd "$(dirname "$requested")"
    printf '%s/%s\n' "$PWD" "$(basename "$requested")"
  )
}

safe_component_id() {
  local component_id="$1"

  [[ "$component_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
    die "component_id inseguro para materialização: $component_id"
}

safe_relative_artifact_path() {
  local relpath="$1"

  [[ -n "$relpath" ]] || die "artefato sem path"

  case "$relpath" in
    /*|..|../*|*/../*|*/..)
      die "path de artefato inseguro: $relpath"
      ;;
  esac
}

materialize_qualified_artifact() {
  local artifact_root="$1"
  local release_root="$2"
  local relpath="$3"
  local expected_hash="$4"
  local executable="$5"

  safe_relative_artifact_path "$relpath"

  local source_artifact="$artifact_root/$relpath"
  local target_artifact="$release_root/$relpath"

  [[ -f "$source_artifact" ]] || \
    die "artefato qualificado ausente na fonte: $source_artifact"

  mkdir -p "$(dirname "$target_artifact")"

  if git -C "$release_root" \
      ls-files --error-unmatch "$relpath" >/dev/null 2>&1; then
    :
  else
    cp -p "$source_artifact" "$target_artifact"
  fi

  [[ -f "$target_artifact" ]] || \
    die "artefato não materializado: $target_artifact"

  if [[ "$executable" == "true" ]]; then
    [[ -x "$target_artifact" ]] || \
      die "artefato deveria ser executável: $target_artifact"
  fi

  local actual_hash
  actual_hash="$(sha256sum "$target_artifact" | awk '{print $1}')"

  [[ "$actual_hash" == "$expected_hash" ]] || \
    die "hash divergente ao materializar artefato: $relpath"
}

composition_candidate_integrity() {
  local candidate="$1"
  local manifest="$candidate/manifest.json"

  [[ -d "$candidate" ]] || die "candidata ausente: $candidate"
  [[ -f "$manifest" ]] || die "manifest ausente em $candidate"

  jq -e \
    '.schema == "sister.infra.workstation.candidate/1"' \
    "$manifest" >/dev/null || \
    die "schema de candidata não suportado"

  jq -e \
    '.qualification.status == "PASS"' \
    "$manifest" >/dev/null || \
    die "candidata sem qualificação PASS"

  jq -e \
    '.deployment.status == "PENDING_BINDINGS"' \
    "$manifest" >/dev/null || \
    die "candidata CR-05 deve permanecer PENDING_BINDINGS"

  local evidence_rel evidence expected_evidence_hash actual_evidence_hash
  evidence_rel="$(jq -r '.qualification.evidence' "$manifest")"
  expected_evidence_hash="$(jq -r '.qualification.sha256' "$manifest")"
  evidence="$candidate/$evidence_rel"

  [[ -f "$evidence" ]] || \
    die "evidência de composição ausente: $evidence_rel"

  actual_evidence_hash="$(sha256sum "$evidence" | awk '{print $1}')"
  [[ "$actual_evidence_hash" == "$expected_evidence_hash" ]] || \
    die "hash divergente da evidência de composição"

  local infra_commit infra_repo actual_commit tracked
  infra_commit="$(jq -r '.control_plane.commit' "$manifest")"
  infra_repo="$candidate/$(jq -r '.control_plane.path' "$manifest")"

  [[ -d "$infra_repo/.git" ]] || \
    die "candidata corrompida: control plane sem .git"

  actual_commit="$(git -C "$infra_repo" rev-parse HEAD)"
  [[ "$actual_commit" == "$infra_commit" ]] || \
    die "candidata corrompida: control plane divergiu do manifesto"

  tracked="$(git -C "$infra_repo" status --porcelain --untracked-files=no)"
  [[ -z "$tracked" ]] || \
    die "candidata corrompida: control plane possui alterações rastreadas"

  local component_id component_path component_repo expected_commit
  local artifact_id relpath expected_hash executable absolute actual_hash

  while IFS=$'\t' read -r \
      component_id component_path expected_commit; do
    [[ -n "$component_id" ]] || continue

    safe_component_id "$component_id"
    component_repo="$candidate/$component_path"

    [[ -d "$component_repo/.git" ]] || \
      die "candidata corrompida: $component_id sem .git"

    actual_commit="$(git -C "$component_repo" rev-parse HEAD)"
    [[ "$actual_commit" == "$expected_commit" ]] || \
      die "candidata corrompida: $component_id HEAD divergiu"

    tracked="$(
      git -C "$component_repo" status --porcelain --untracked-files=no
    )"
    [[ -z "$tracked" ]] || \
      die "candidata corrompida: $component_id possui alterações rastreadas"

    while IFS=$'\t' read -r \
        artifact_id relpath expected_hash executable; do
      [[ -n "$artifact_id" ]] || continue

      safe_relative_artifact_path "$relpath"
      absolute="$component_repo/$relpath"

      [[ -f "$absolute" ]] || \
        die "candidata corrompida: artefato ausente: $artifact_id"

      if [[ "$executable" == "true" ]]; then
        [[ -x "$absolute" ]] || \
          die "candidata corrompida: artefato não executável: $artifact_id"
      fi

      actual_hash="$(sha256sum "$absolute" | awk '{print $1}')"
      [[ "$actual_hash" == "$expected_hash" ]] || \
        die "candidata corrompida: hash divergente: $artifact_id"
    done < <(
      jq -r \
        --arg component_id "$component_id" '
          .components[]
          | select(.component_id == $component_id)
          | .artifacts[]
          | [.id, .path, .sha256, (.executable | tostring)]
          | @tsv
        ' "$manifest"
    )
  done < <(
    jq -r '
      .components[]
      | [.component_id, .path, .commit]
      | @tsv
    ' "$manifest"
  )

  pass "integridade da candidata $(basename "$candidate")"
}

release_create_composition() {
  ensure_dirs

  local composition
  composition="$(composition_path "${1:-}")"

  local workspace
  workspace="$(source_workspace_guess)" || \
    die "source workspace desconhecido; defina SISTER_SOURCE_WORKSPACE"
  workspace="$(cd "$workspace" && pwd -P)"

  local infra
  infra="$(repo_path "$workspace" infra)"
  require_repo_clean "$infra" "sister-infra"

  local artifact_bundle
  artifact_bundle="$CANDIDATES_ROOT/.qualified-artifacts-$$"
  rm -rf "$artifact_bundle"
  mkdir -p "$artifact_bundle"

  local qualify_cmd=(
    "$INFRA_ROOT/bin/sister-composition"
    qualify
    "$composition"
    --artifacts-root
    "$artifact_bundle"
    --json
  )

  if [[ -n "$COMPOSITION_CONTRACTS_ROOT" ]]; then
    qualify_cmd+=(
      --contracts-root
      "$COMPOSITION_CONTRACTS_ROOT"
    )
  fi

  info "qualificando composição declarativa"

  local qualification_json
  if ! qualification_json="$("${qualify_cmd[@]}")"; then
    rm -rf "$artifact_bundle"
    die "qualificação da composição falhou"
  fi

  jq -e \
    '.schema == "sister.infra.composition.qualification/1"
     and .status == "PASS"' \
    <<<"$qualification_json" >/dev/null || \
    die "sister-composition não produziu qualificação PASS"

  local infra_commit infra_short qualification_hash qualification_short
  infra_commit="$(repo_head "$infra")"
  infra_short="$(repo_short "$infra")"
  qualification_hash="$(
    printf '%s\n' "$qualification_json" |
      sha256sum |
      awk '{print $1}'
  )"
  qualification_short="${qualification_hash:0:12}"

  local timestamp id candidate tmp
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  id="wc-${timestamp}-${infra_short}-${qualification_short}"
  candidate="$CANDIDATES_ROOT/$id"
  tmp="$CANDIDATES_ROOT/.creating-$id-$$"

  [[ ! -e "$candidate" ]] || die "candidata já existe: $id"

  rm -rf "$tmp"
  mkdir -p \
    "$tmp/components" \
    "$tmp/evidence/composition"

  printf '%s\n' "$qualification_json" \
    > "$tmp/evidence/composition/qualification.json"

  info "materializando control plane"
  clone_component \
    "$infra" \
    "$tmp/components/sister-infra" \
    "$infra_commit"

  local component_id system_id role source_root commit destination
  local artifact_id relpath expected_hash executable

  while IFS=$'\t' read -r \
      component_id system_id role source_root commit; do
    [[ -n "$component_id" ]] || continue
    safe_component_id "$component_id"

    destination="$tmp/components/$component_id"

    info "materializando componente $component_id"
    clone_component "$source_root" "$destination" "$commit"

    while IFS=$'\t' read -r \
        artifact_id relpath expected_hash executable; do
      [[ -n "$artifact_id" ]] || continue

      materialize_qualified_artifact \
        "$artifact_bundle/$component_id" \
        "$destination" \
        "$relpath" \
        "$expected_hash" \
        "$executable"
    done < <(
      jq -r \
        --arg component_id "$component_id" '
          .components[]
          | select(.component_id == $component_id)
          | .qualification.artifacts[]
          | [.id, .path, .sha256, (.executable | tostring)]
          | @tsv
        ' "$tmp/evidence/composition/qualification.json"
    )
  done < <(
    jq -r '
      .components[]
      | [
          .component_id,
          .system_id,
          .role,
          .root,
          .qualification.source.commit
        ]
      | @tsv
    ' "$tmp/evidence/composition/qualification.json"
  )

  python3 - \
    "$tmp/manifest.json" \
    "$tmp/evidence/composition/qualification.json" \
    "$id" \
    "$timestamp" \
    "$infra_commit" \
    "$qualification_hash" <<'PY_CR05_MANIFEST'
import json
import sys
from pathlib import Path

(
    out,
    qualification_path,
    candidate_id,
    created,
    infra_commit,
    qualification_hash,
) = sys.argv[1:]

qualification = json.loads(
    Path(qualification_path).read_text(encoding="utf-8")
)

components = []
for item in qualification["components"]:
    report = item["qualification"]
    components.append(
        {
            "component_id": item["component_id"],
            "system_id": item["system_id"],
            "role": item["role"],
            "component_contract": item["component_contract"],
            "path": f"components/{item['component_id']}",
            "commit": report["source"]["commit"],
            "runtime": item["runtime"],
            "artifacts": report["artifacts"],
        }
    )

payload = {
    "schema": "sister.infra.workstation.candidate/1",
    "candidate_id": candidate_id,
    "created_at_utc": created,
    "deployment_class": qualification["deployment_class"],
    "control_plane": {
        "component_id": "infra",
        "path": "components/sister-infra",
        "commit": infra_commit,
    },
    "composition": {
        "composition_id": qualification["composition_id"],
        "schema": qualification["schema"],
    },
    "components": components,
    "qualification": {
        "status": "PASS",
        "evidence": "evidence/composition/qualification.json",
        "sha256": qualification_hash,
    },
    "deployment": {
        "status": "PENDING_BINDINGS",
    },
}

Path(out).write_text(
    json.dumps(payload, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY_CR05_MANIFEST

  printf '%s\n' "$id" > "$tmp/CANDIDATE_ID"
  printf '%s\n' "SISTER-INFRA-CR-05" > "$tmp/QUALIFICATION"

  composition_candidate_integrity "$tmp"

  mv "$tmp" "$candidate"
  composition_candidate_integrity "$candidate"

  rm -rf "$artifact_bundle"

  pass "candidata declarativa materializada: $id"
  info "bindings ainda não foram resolvidos; candidata não foi instalada"
  printf '%s\n' "$id"
}

candidate_verify() {
  ensure_dirs

  local id="${1:-}"
  [[ -n "$id" ]] || die "candidate-verify requer id"

  composition_candidate_integrity "$CANDIDATES_ROOT/$id"
}
# SISTER-INFRA-CR05-COMPOSITION-END

sha256_path() {
  sha256sum "$1" | awk '{print $1}'
}

declarative_release_integrity() {
  local release="$1"
  local manifest="$release/manifest.json"

  jq -e '
    .schema == "sister.infra.workstation.release/3"
    and .qualification.status == "PASS"
    and .deployment.status == "READY"
    and (.components | type == "array" and length > 0)
  ' "$manifest" >/dev/null || \
    die "release declarativa não está qualificada e READY"

  local evidence expected actual
  while IFS=$'\t' read -r evidence expected; do
    [[ -n "$evidence" ]] || continue
    [[ -f "$release/$evidence" ]] || \
      die "evidência ausente na release: $evidence"
    actual="$(sha256_path "$release/$evidence")"
    [[ "$actual" == "$expected" ]] || \
      die "hash divergente da evidência: $evidence"
  done < <(
    jq -r '
      [
        [.qualification.evidence, .qualification.sha256],
        [.deployment.declaration, .deployment.declaration_sha256],
        [.deployment.evidence, .deployment.sha256]
      ][] | @tsv
    ' "$manifest"
  )

  local control_path control_commit control_repo tracked
  control_path="$(jq -r '.control_plane.path' "$manifest")"
  control_commit="$(jq -r '.control_plane.commit' "$manifest")"
  safe_relative_artifact_path "$control_path"
  control_repo="$release/$control_path"
  [[ -d "$control_repo/.git" ]] || \
    die "release declarativa sem control plane Git"
  [[ "$(git -C "$control_repo" rev-parse HEAD)" == "$control_commit" ]] || \
    die "control plane divergiu do manifesto"
  tracked="$(git -C "$control_repo" status --porcelain --untracked-files=no)"
  [[ -z "$tracked" ]] || die "control plane possui alteração rastreada"

  local component_id component_path component_repo expected_commit entrypoint
  local artifact_id relpath expected_hash executable absolute
  while IFS=$'\t' read -r \
      component_id component_path expected_commit entrypoint; do
    [[ -n "$component_id" ]] || continue
    safe_component_id "$component_id"
    safe_relative_artifact_path "$component_path"
    safe_relative_artifact_path "$entrypoint"
    component_repo="$release/$component_path"

    [[ -d "$component_repo/.git" ]] || \
      die "release declarativa: $component_id sem .git"
    [[ "$(git -C "$component_repo" rev-parse HEAD)" == "$expected_commit" ]] || \
      die "release declarativa: commit divergente para $component_id"
    tracked="$(git -C "$component_repo" status --porcelain --untracked-files=no)"
    [[ -z "$tracked" ]] || \
      die "release declarativa: alteração rastreada em $component_id"
    [[ -x "$component_repo/$entrypoint" ]] || \
      die "entrypoint ausente/não executável para $component_id"

    while IFS=$'\t' read -r \
        artifact_id relpath expected_hash executable; do
      [[ -n "$artifact_id" ]] || continue
      safe_relative_artifact_path "$relpath"
      absolute="$component_repo/$relpath"
      [[ -f "$absolute" ]] || \
        die "artefato ausente: $component_id/$artifact_id"
      if [[ "$executable" == "true" ]]; then
        [[ -x "$absolute" ]] || \
          die "artefato não executável: $component_id/$artifact_id"
      fi
      [[ "$(sha256_path "$absolute")" == "$expected_hash" ]] || \
        die "hash divergente: $component_id/$artifact_id"
    done < <(
      jq -r --arg id "$component_id" '
        .components[] | select(.component_id == $id) | .artifacts[]
        | [.id, .path, .sha256, (.executable | tostring)] | @tsv
      ' "$manifest"
    )
  done < <(
    jq -r '
      .components[]
      | [.component_id, .path, .commit, .runtime.entrypoint]
      | @tsv
    ' "$manifest"
  )

  local resolved="$release/$(jq -r '.deployment.evidence' "$manifest")"
  jq -e --slurpfile deployment "$resolved" '
    .candidate_id == $deployment[0].candidate_id
    and .composition.composition_id == $deployment[0].composition_id
    and (
      [.components[].system_id] | sort
    ) == (
      [$deployment[0].components[].system_id] | sort
    )
  ' "$manifest" >/dev/null || \
    die "deployment resolvido diverge da release"

  pass "integridade declarativa da release $(basename "$release")"
}

declarative_source_files() {
  local workspace
  workspace="$(source_workspace_guess)" || \
    die "source workspace desconhecido; defina SISTER_SOURCE_WORKSPACE"
  workspace="$(cd "$workspace" && pwd -P)"
  write_source_workspace "$workspace"

  local control_plane
  control_plane="$(repo_path "$workspace" infra)"
  require_repo_clean "$control_plane" "sister-infra"

  local composition="${SISTER_WORKSTATION_COMPOSITION_FILE:-}"
  local deployment="${SISTER_WORKSTATION_DEPLOYMENT_FILE:-}"
  [[ -n "$composition" ]] || \
    composition="$control_plane/config/compositions/workstation.json"
  [[ -n "$deployment" ]] || \
    deployment="$control_plane/config/deployments/workstation-lab.json"

  [[ -f "$composition" ]] || die "composição oficial ausente: $composition"
  [[ -f "$deployment" ]] || die "deployment oficial ausente: $deployment"
  printf '%s\t%s\n' "$composition" "$deployment"
}

release_create_declarative() {
  ensure_dirs

  local composition deployment
  IFS=$'\t' read -r composition deployment < <(declarative_source_files)

  local candidate_output candidate_id candidate
  candidate_output="$(release_create_composition "$composition")"
  printf '%s\n' "$candidate_output"
  candidate_id="$(printf '%s\n' "$candidate_output" | tail -n1)"
  candidate="$CANDIDATES_ROOT/$candidate_id"
  composition_candidate_integrity "$candidate"

  local id release tmp
  id="wr-${candidate_id#wc-}"
  release="$RELEASES_ROOT/$id"
  tmp="$RELEASES_ROOT/.creating-$id-$$"
  [[ ! -e "$release" ]] || die "release já existe: $id"

  mkdir -p "$tmp"
  cp -a "$candidate/." "$tmp/"
  mkdir -p "$tmp/evidence/deployment"
  cp -p "$deployment" "$tmp/evidence/deployment/declaration.json"

  "$tmp/components/sister-infra/bin/sister-deployment" resolve \
    "$tmp/manifest.json" \
    "$tmp/evidence/deployment/declaration.json" \
    --json > "$tmp/evidence/deployment/resolved.json" || {
      find "$tmp" -depth -delete
      die "deployment da release não resolveu READY"
    }

  local declaration_hash resolved_hash
  declaration_hash="$(sha256_path "$tmp/evidence/deployment/declaration.json")"
  resolved_hash="$(sha256_path "$tmp/evidence/deployment/resolved.json")"

  python3 - \
    "$tmp/manifest.json" \
    "$id" \
    "$declaration_hash" \
    "$resolved_hash" <<'PY_RELEASE_V3'
import json
import sys
from pathlib import Path

manifest_path, release_id, declaration_hash, resolved_hash = sys.argv[1:]
path = Path(manifest_path)
manifest = json.loads(path.read_text(encoding="utf-8"))
resolved = json.loads(
    (path.parent / "evidence/deployment/resolved.json").read_text(
        encoding="utf-8"
    )
)

manifest["schema"] = "sister.infra.workstation.release/3"
manifest["release_id"] = release_id
manifest["deployment"] = {
    "status": "READY",
    "deployment_id": resolved["deployment_id"],
    "declaration": "evidence/deployment/declaration.json",
    "declaration_sha256": declaration_hash,
    "evidence": "evidence/deployment/resolved.json",
    "sha256": resolved_hash,
}

path.write_text(
    json.dumps(manifest, indent=2, sort_keys=True) + "\n",
    encoding="utf-8",
)
PY_RELEASE_V3

  printf '%s\n' "$id" > "$tmp/RELEASE_ID"
  printf '%s\n' "SISTER-INFRA-DECLARATIVE-RELEASE-3" > "$tmp/QUALIFICATION"
  declarative_release_integrity "$tmp"
  mv "$tmp" "$release"
  declarative_release_integrity "$release"
  printf '%s\n' "$id" > "$STATE_ROOT/last-created-release"
  pass "release declarativa READY criada: $id"
  printf '%s\n' "$id"
}

release_resolved_deployment() {
  local release="$1"
  printf '%s/%s\n' \
    "$release" \
    "$(jq -r '.deployment.evidence' "$release/manifest.json")"
}

invoke_component_action() {
  local release="$1"
  local component_id="$2"
  local component_path="$3"
  local entrypoint="$4"
  local action="$5"
  local resolved="$6"
  local root="$release/$component_path"
  local config="$CONFIG_ROOT/${component_id}.env"

  mkdir -p \
    "$STATE_ROOT/components/$component_id" \
    "$STATE_ROOT/run/$component_id"

  (
    cd "$root"
    export SISTER_RESOLVED_DEPLOYMENT_FILE="$resolved"
    export SISTER_COMPONENT_CONFIG_FILE="$config"
    export SISTER_RUNTIME_STATE_DIR="$STATE_ROOT/components/$component_id"
    export SISTER_RUNTIME_RUN_DIR="$STATE_ROOT/run/$component_id"
    "$root/$entrypoint" "$action"
  )
}

component_rows() {
  jq -r '
    .components[]
    | [.component_id, .path, .runtime.entrypoint]
    | @tsv
  ' "$1/manifest.json"
}

components_action_forward() {
  local release="$1"
  local action="$2"
  local resolved
  resolved="$(release_resolved_deployment "$release")"

  local component_id component_path entrypoint
  while IFS=$'\t' read -r component_id component_path entrypoint; do
    [[ -n "$component_id" ]] || continue
    info "$action: $component_id"
    invoke_component_action \
      "$release" "$component_id" "$component_path" \
      "$entrypoint" "$action" "$resolved" || return 1
  done < <(component_rows "$release")
}

components_action_reverse() {
  local release="$1"
  local action="$2"
  local resolved
  resolved="$(release_resolved_deployment "$release")"

  local -a rows=()
  mapfile -t rows < <(component_rows "$release")
  local index component_id component_path entrypoint
  for ((index=${#rows[@]} - 1; index >= 0; index--)); do
    IFS=$'\t' read -r component_id component_path entrypoint \
      <<<"${rows[$index]}"
    [[ -n "$component_id" ]] || continue
    info "$action: $component_id"
    invoke_component_action \
      "$release" "$component_id" "$component_path" \
      "$entrypoint" "$action" "$resolved" || \
      warn "$component_id reportou falha em $action"
  done
}

declarative_gateway_action() {
  local release="$1"
  local action="$2"
  local resolved
  resolved="$(release_resolved_deployment "$release")"

  if [[ "$TEST_MODE" == "1" ]]; then
    info "TEST_MODE gateway declarativo: $action"
    return 0
  fi

  local control_plane
  control_plane="$release/$(jq -r '.control_plane.path' "$release/manifest.json")"
  mkdir -p "$TLS_CONFIG" "$STATE_ROOT/control-plane"

  SISTER_RESOLVED_DEPLOYMENT_FILE="$resolved" \
  SISTER_INFRA_RUN_ROOT="$STATE_ROOT/control-plane" \
  TLS_PEM="$TLS_CONFIG/ecosystem-lab.pem" \
  CA_CERT="$TLS_CONFIG/ecosystem-lab-ca.crt" \
  CA_KEY="$TLS_CONFIG/ecosystem-lab-ca.key" \
    "$control_plane/bin/sister-infra" "$action" --profile lan
}

runtime_start() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_release_integrity "$release"

  if ! components_action_forward "$release" start; then
    warn "start declarativo falhou; parando participantes já acionados"
    components_action_reverse "$release" stop
    die "runtime declarativo não iniciou"
  fi
  components_action_forward "$release" health || {
    components_action_reverse "$release" stop
    die "participante falhou no health após start"
  }
  declarative_gateway_action "$release" declarative-up || {
    declarative_gateway_action "$release" declarative-down || true
    components_action_reverse "$release" stop
    die "gateway declarativo não iniciou"
  }
  pass "runtime declarativo iniciado"
}

runtime_stop() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_gateway_action "$release" declarative-down || \
    warn "gateway declarativo reportou falha ao parar"
  components_action_reverse "$release" stop
  pass "runtime declarativo parado"
}

runtime_status() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_release_integrity "$release"
  components_action_forward "$release" status
  declarative_gateway_action "$release" declarative-status
}

runtime_verify() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"
  declarative_release_integrity "$release"
  components_action_forward "$release" health
  declarative_gateway_action "$release" declarative-verify
  pass "workstation declarativa verificada"
}

release_build_qualification() {
  local workspace="$1"
  local sister_commit="$2"
  local nexo_commit="$3"
  local praxis_commit="$4"
  local evidence_dir="$5"

  mkdir -p "$evidence_dir"

  local short_root
  short_root="$(mktemp -d /tmp/si-wsqual.XXXXXX)"

  local component source commit clone build log

  for component in sister nexo praxis; do
    case "$component" in
      sister)
        source="$(repo_path "$workspace" sister)"
        commit="$sister_commit"
        ;;
      nexo)
        source="$(repo_path "$workspace" nexo)"
        commit="$nexo_commit"
        ;;
      praxis)
        source="$(repo_path "$workspace" praxis)"
        commit="$praxis_commit"
        ;;
    esac

    clone="$short_root/$component"
    build="$clone/build"
    log="$evidence_dir/${component}.log"

    if ! {
      git clone --no-hardlinks --quiet "$source" "$clone"
      git -C "$clone" checkout --quiet --detach "$commit"
      cmake -S "$clone" -B "$build" -G Ninja -DCMAKE_BUILD_TYPE=Release
      cmake --build "$build"
      ctest --test-dir "$build" --output-on-failure
    } > >(tee "$log") 2>&1; then
      rm -rf "$short_root"
      die "build/test qualification falhou para $component"
    fi

    pass "source qualification: $component"
  done

  rm -rf "$short_root"
}

find_runtime_artifact() {
  local component="$1"
  local root="$2"
  local candidate=""

  case "$component" in
    sister)
      for candidate in "$root/build/apps/sisterd/sisterd" "$root/build/sisterd"; do
        [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
      done
      find "$root/build" -type f -name sisterd -perm -u+x -print -quit 2>/dev/null
      ;;
    nexo)
      for candidate in "$root/build/sister-nexo"; do
        [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
      done
      find "$root/build" -type f -name sister-nexo -perm -u+x -print -quit 2>/dev/null
      ;;
    praxis)
      for candidate in "$root/build/sister-praxis-http"; do
        [[ -x "$candidate" ]] && { printf '%s\n' "$candidate"; return 0; }
      done
      find "$root/build" -type f -name sister-praxis-http -perm -u+x -print -quit 2>/dev/null
      ;;
    *)
      return 1
      ;;
  esac
}

materialize_release_build() {
  local release="$1"
  local component root

  for component in sister nexo praxis; do
    case "$component" in
      sister) root="$release/components/SisTer" ;;
      nexo) root="$release/components/sister-nexo" ;;
      praxis) root="$release/components/sister-praxis" ;;
    esac

    cmake -S "$root" -B "$root/build" -G Ninja -DCMAKE_BUILD_TYPE=Release
    cmake --build "$root/build"
    pass "release build: $component"
  done
}

require_release_build_qualified() {
  local release="$1"
  local status

  if jq -e '.schema == "sister.infra.workstation.release/3"' \
      "$(manifest_path "$release")" >/dev/null; then
    status="$(jq -r '
      if .qualification.status == "PASS" and .deployment.status == "READY"
      then "PASS" else "UNQUALIFIED" end
    ' "$(manifest_path "$release")")"
    [[ "$status" == "PASS" ]] || \
      die "release declarativa não possui qualification PASS e deployment READY: $(basename "$release")"
    return
  fi

  status="$(jq -r '.qualification.build.status // "UNQUALIFIED"' "$(manifest_path "$release")")"

  [[ "$status" == "PASS" ]] || \
    die "release não possui build qualification PASS: $(basename "$release")"
}

release_create_legacy() {
  ensure_dirs

  local workspace
  workspace="$(source_workspace_guess)" || \
    die "source workspace desconhecido; defina SISTER_SOURCE_WORKSPACE"

  workspace="$(cd "$workspace" && pwd -P)"
  write_source_workspace "$workspace"

  local infra sister nexo praxis
  infra="$(repo_path "$workspace" infra)"
  sister="$(repo_path "$workspace" sister)"
  nexo="$(repo_path "$workspace" nexo)"
  praxis="$(repo_path "$workspace" praxis)"

  require_repo_clean "$infra" "sister-infra"
  require_repo_clean "$sister" "SisTer"
  require_repo_clean "$nexo" "Nexo"
  require_repo_clean "$praxis" "Praxis"

  local infra_commit sister_commit nexo_commit praxis_commit
  local infra_short sister_short nexo_short praxis_short

  infra_commit="$(repo_head "$infra")"
  sister_commit="$(repo_head "$sister")"
  nexo_commit="$(repo_head "$nexo")"
  praxis_commit="$(repo_head "$praxis")"

  infra_short="$(repo_short "$infra")"
  sister_short="$(repo_short "$sister")"
  nexo_short="$(repo_short "$nexo")"
  praxis_short="$(repo_short "$praxis")"

  local timestamp id release tmp
  timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
  id="ws-${timestamp}-${infra_short}-${sister_short}-${nexo_short}-${praxis_short}"
  release="$RELEASES_ROOT/$id"
  tmp="$RELEASES_ROOT/.creating-$id-$$"

  [[ ! -e "$release" ]] || die "release já existe: $id"

  rm -rf "$tmp"
  mkdir -p "$tmp/components" "$tmp/evidence/build"

  info "qualificando fontes da release $id"

  release_build_qualification \
    "$workspace" \
    "$sister_commit" \
    "$nexo_commit" \
    "$praxis_commit" \
    "$tmp/evidence/build"

  info "materializando release $id"

  clone_component "$infra" "$tmp/components/sister-infra" "$infra_commit"
  clone_component "$sister" "$tmp/components/SisTer" "$sister_commit"
  clone_component "$nexo" "$tmp/components/sister-nexo" "$nexo_commit"
  clone_component "$praxis" "$tmp/components/sister-praxis" "$praxis_commit"

  copy_operational_config "$workspace" "$tmp"
  materialize_release_build "$tmp"

  local sister_artifact nexo_artifact praxis_artifact
  local sister_rel nexo_rel praxis_rel
  local sister_hash nexo_hash praxis_hash

  sister_artifact="$(find_runtime_artifact sister "$tmp/components/SisTer")"
  nexo_artifact="$(find_runtime_artifact nexo "$tmp/components/sister-nexo")"
  praxis_artifact="$(find_runtime_artifact praxis "$tmp/components/sister-praxis")"

  [[ -x "$sister_artifact" ]] || die "artefato sisterd não materializado"
  [[ -x "$nexo_artifact" ]] || die "artefato sister-nexo não materializado"
  [[ -x "$praxis_artifact" ]] || die "artefato sister-praxis-http não materializado"

  sister_rel="${sister_artifact#"$tmp/components/SisTer/"}"
  nexo_rel="${nexo_artifact#"$tmp/components/sister-nexo/"}"
  praxis_rel="${praxis_artifact#"$tmp/components/sister-praxis/"}"

  sister_hash="$(sha256sum "$sister_artifact" | awk '{print $1}')"
  nexo_hash="$(sha256sum "$nexo_artifact" | awk '{print $1}')"
  praxis_hash="$(sha256sum "$praxis_artifact" | awk '{print $1}')"

  python3 - "$tmp/manifest.json" \
    "$id" "$timestamp" "$workspace" \
    "$infra_commit" "$sister_commit" "$nexo_commit" "$praxis_commit" \
    "$sister_rel" "$sister_hash" \
    "$nexo_rel" "$nexo_hash" \
    "$praxis_rel" "$praxis_hash" <<'PY_MANIFEST_OPS001C'
import json
import sys
from pathlib import Path

(
    out, rid, created, workspace,
    infra, sister, nexo, praxis,
    sister_path, sister_hash,
    nexo_path, nexo_hash,
    praxis_path, praxis_hash,
) = sys.argv[1:]

payload = {
    "schema": "sister.infra.workstation.release/2",
    "release_id": rid,
    "created_at_utc": created,
    "source_workspace": workspace,
    "deployment_class": "workstation",
    "isolation": {
        "source_code": "independent-local-clone",
        "configuration": "persistent-outside-release",
        "data_plane": "component-entrypoints-current-contracts",
    },
    "components": {
        "infra": {"commit": infra},
        "sister": {"commit": sister},
        "nexo": {"commit": nexo},
        "praxis": {"commit": praxis},
    },
    "qualification": {
        "build": {
            "status": "PASS",
            "profile": "Release",
            "source_tests": "PASS",
            "artifacts": {
                "sisterd": {
                    "component": "sister",
                    "path": sister_path,
                    "sha256": sister_hash,
                },
                "sister-nexo": {
                    "component": "nexo",
                    "path": nexo_path,
                    "sha256": nexo_hash,
                },
                "sister-praxis-http": {
                    "component": "praxis",
                    "path": praxis_path,
                    "sha256": praxis_hash,
                },
            },
        }
    },
}

Path(out).write_text(json.dumps(payload, indent=2) + "\n")
PY_MANIFEST_OPS001C

  printf '%s\n' "$id" > "$tmp/RELEASE_ID"
  printf '%s\n' "SISTER-INFRA-OPS-001C" > "$tmp/QUALIFICATION"

  if ! ( release_integrity "$tmp" ); then
    rm -rf "$tmp"
    die "candidata de release falhou na validação de integridade"
  fi

  mv "$tmp" "$release"

  release_integrity "$release"
  require_release_build_qualified "$release"

  printf '%s\n' "$id" > "$STATE_ROOT/last-created-release"

  pass "release build-qualified criada: $id"
  printf '%s\n' "$id"
}

release_create() {
  release_create_declarative
}

render_unit() {
  ensure_dirs

  # SISTER-INFRA-OPS001E-SYSTEMD-SINGLE-SOURCE
  #
  # A unit instalada deriva exclusivamente do template pertencente à
  # release selecionada. O control plane não mantém uma segunda
  # representação do contrato systemd.
  local template schema
  schema="$(jq -r '.schema' "$CURRENT_LINK/manifest.json")"
  if [[ "$schema" == "sister.infra.workstation.release/3" ]]; then
    template="${CURRENT_LINK}/components/sister-infra/templates/systemd/sister-workstation.service.in"
  else
    template="${CURRENT_LINK}/components/sister-infra/templates/systemd/sister-workstation-legacy.service.in"
    if [[ ! -f "$template" ]]; then
      template="${CURRENT_LINK}/components/sister-infra/templates/systemd/sister-workstation.service.in"
    fi
  fi

  [[ -f "$template" ]] || \
    die "template systemd ausente na release current: $template"

  python3 - "$template" "$UNIT_FILE" "$HOME_DIR" <<'PY_RENDER_UNIT'
from pathlib import Path
import sys

source = Path(sys.argv[1])
target = Path(sys.argv[2])
home = sys.argv[3]

text = source.read_text()

required = "Environment=SISTER_INFRA_RUNTIME_MODE=installed"

if required not in text:
    raise SystemExit(
        f"template workstation sem contrato installed obrigatório: {source}"
    )

# O template usa %h para representar HOME.
# A unit materializada usa caminhos absolutos para facilitar auditoria.
text = text.replace("%h", home)

target.write_text(text)
PY_RENDER_UNIT

  grep -Fxq \
    'Environment=SISTER_INFRA_RUNTIME_MODE=installed' \
    "$UNIT_FILE" || \
    die "unit renderizada perdeu SISTER_INFRA_RUNTIME_MODE=installed"

  chmod 644 "$UNIT_FILE"
}

systemctl_user() {
  if [[ "$TEST_MODE" == "1" ]]; then
    info "TEST_MODE systemctl --user $*"
    return 0
  fi

  systemctl --user "$@"
}

install_release() {
  ensure_dirs

  local id="${1:-}"

  if [[ -z "$id" ]]; then
    [[ -f "$STATE_ROOT/last-created-release" ]] || \
      die "nenhuma release indicada nem last-created-release"
    id="$(cat "$STATE_ROOT/last-created-release")"
  fi

  local release
  release="$(release_path_by_id "$id")"

  release_integrity "$release"
  require_release_build_qualified "$release"

  local old_current=""

  if [[ -L "$CURRENT_LINK" ]]; then
    old_current="$(readlink -f "$CURRENT_LINK")"
  fi

  if [[ -n "$old_current" && "$old_current" != "$release" ]]; then
    ln -sfn "$old_current" "$PREVIOUS_LINK"
  fi

  ln -sfn "$release" "$CURRENT_LINK"

  render_unit
  ensure_runtime_env
  ln -sfn "$CURRENT_LINK/components/sister-infra/bin/sister-infra" "$CLI_LINK"

  systemctl_user daemon-reload

  pass "release instalada como current: $id"
  info "serviço instalado, mas permanece desabilitado e não iniciado"
}

verify_installed() {
  local release
  release="$(current_release_path)" || die "nenhuma release current"

  release_integrity "$release"
  require_release_build_qualified "$release"

  if jq -e '.schema == "sister.infra.workstation.release/3"' \
      "$release/manifest.json" >/dev/null; then
    runtime_verify
  else
    "$release/components/sister-infra/bin/sister-infra" verify --profile lan
  fi
  pass "workstation verificado"
}

service_active() {
  if [[ "$TEST_MODE" == "1" ]]; then
    return 1
  fi

  systemctl --user is-active --quiet "$UNIT_NAME"
}

start_service() {
  local release
  release="$(current_release_path)" || die "nenhuma release instalada"

  release_integrity "$release"
  systemctl_user start "$UNIT_NAME"
}

stop_service() {
  systemctl_user stop "$UNIT_NAME"
}

restart_service() {
  local release
  release="$(current_release_path)" || die "nenhuma release instalada"

  release_integrity "$release"
  systemctl_user restart "$UNIT_NAME"
}

activate_workstation() {
  local release
  release="$(current_release_path)" || die "instale uma release antes de activate"

  release_integrity "$release"
  require_release_build_qualified "$release"

  if service_active; then
    info "workstation já está ativo"
    verify_installed
    systemctl_user enable "$UNIT_NAME" >/dev/null
    return 0
  fi

  local workspace=""
  workspace="$(source_workspace_guess || true)"
  local source_infra=""

  if [[ -n "$workspace" && -x "$workspace/sister-infra/bin/sister-infra" ]]; then
    source_infra="$workspace/sister-infra/bin/sister-infra"
  fi

  if [[ -n "$source_infra" ]]; then
    info "handover: parando runtime LAN da árvore de desenvolvimento"
    "$source_infra" down --profile lan || \
      warn "runtime de desenvolvimento reportou falha ao parar"
  fi

  if systemctl_user start "$UNIT_NAME"; then
    if verify_installed; then
      systemctl_user enable "$UNIT_NAME" >/dev/null
      pass "workstation assumiu o runtime e autostart foi habilitado"
      return 0
    fi
  fi

  warn "ativação workstation falhou; tentando restaurar runtime anterior"
  systemctl_user disable "$UNIT_NAME" >/dev/null 2>&1 || true
  systemctl_user stop "$UNIT_NAME" >/dev/null 2>&1 || true

  if [[ -n "$source_infra" ]]; then
    "$source_infra" up --profile lan || \
      warn "não foi possível restaurar runtime de desenvolvimento automaticamente"
  fi

  die "handover falhou"
}

promote_release() {
  local new_id="$1"
  local new_release
  new_release="$(release_path_by_id "$new_id")"

  release_integrity "$new_release"

  local old_release=""

  if [[ -L "$CURRENT_LINK" ]]; then
    old_release="$(readlink -f "$CURRENT_LINK")"
  fi

  local was_active=0

  if service_active; then
    was_active=1
    systemctl_user stop "$UNIT_NAME"
  fi

  if [[ -n "$old_release" && "$old_release" != "$new_release" ]]; then
    ln -sfn "$old_release" "$PREVIOUS_LINK"
  fi

  ln -sfn "$new_release" "$CURRENT_LINK"

  render_unit
  ln -sfn "$CURRENT_LINK/components/sister-infra/bin/sister-infra" "$CLI_LINK"
  systemctl_user daemon-reload

  if [[ "$was_active" -eq 1 ]]; then
    if systemctl_user start "$UNIT_NAME" && verify_installed; then
      pass "release promovida: $new_id"
      return 0
    fi

    warn "nova release falhou; executando rollback automático"
    systemctl_user stop "$UNIT_NAME" >/dev/null 2>&1 || true

    if [[ -n "$old_release" ]]; then
      ln -sfn "$old_release" "$CURRENT_LINK"
      ln -sfn "$new_release" "$PREVIOUS_LINK"
      render_unit
      systemctl_user daemon-reload

      if systemctl_user start "$UNIT_NAME" && verify_installed; then
        warn "rollback automático concluído para $(basename "$old_release")"
      else
        die "nova release falhou e rollback automático também falhou"
      fi
    fi

    die "promoção recusada; release anterior restaurada"
  fi

  pass "release selecionada: $new_id"
  info "serviço estava parado e permaneceu parado"
}

update_workstation() {
  local output id
  output="$(release_create)"
  printf '%s\n' "$output"
  id="$(printf '%s\n' "$output" | tail -n1)"

  promote_release "$id"
}

rollback_workstation() {
  [[ -L "$PREVIOUS_LINK" ]] || die "nenhuma release previous"

  local target current
  target="$(readlink -f "$PREVIOUS_LINK")"
  current="$(current_release_path)" || die "nenhuma release current"

  release_integrity "$target"

  local was_active=0

  if service_active; then
    was_active=1
    systemctl_user stop "$UNIT_NAME"
  fi

  ln -sfn "$target" "$CURRENT_LINK"
  ln -sfn "$current" "$PREVIOUS_LINK"

  render_unit
  systemctl_user daemon-reload

  if [[ "$was_active" -eq 1 ]]; then
    if systemctl_user start "$UNIT_NAME" && verify_installed; then
      pass "rollback concluído: $(basename "$target")"
      return 0
    fi

    warn "rollback não ficou saudável; restaurando release que estava ativa"
    systemctl_user stop "$UNIT_NAME" >/dev/null 2>&1 || true

    ln -sfn "$current" "$CURRENT_LINK"
    ln -sfn "$target" "$PREVIOUS_LINK"

    render_unit
    systemctl_user daemon-reload
    systemctl_user start "$UNIT_NAME" || true

    die "rollback recusado"
  fi

  pass "current alterado para $(basename "$target"); serviço permanece parado"
}

doctor() {
  ensure_dirs

  local failures=0
  local cmd

  for cmd in bash git python3 jq systemctl podman openssl curl; do
    if command -v "$cmd" >/dev/null 2>&1; then
      pass "$cmd"
    else
      printf '[FAIL] dependência ausente: %s\n' "$cmd" >&2
      failures=$((failures + 1))
    fi
  done

  local workspace=""
  workspace="$(source_workspace_guess || true)"

  if [[ -z "$workspace" ]]; then
    warn "source workspace ainda não registrado"
  else
    pass "source workspace: $workspace"

    local kind repo

    for kind in infra sister nexo praxis; do
      repo="$(repo_path "$workspace" "$kind")"

      if [[ -d "$repo/.git" ]]; then
        if [[ -z "$(git -C "$repo" status --porcelain)" ]]; then
          pass "$kind clean @ $(git -C "$repo" rev-parse --short HEAD)"
        else
          warn "$kind possui alterações; release-create será bloqueado"
        fi
      else
        printf '[FAIL] %s ausente: %s\n' "$kind" "$repo" >&2
        failures=$((failures + 1))
      fi
    done
  fi

  if [[ "$TEST_MODE" == "1" ]] || systemctl --user show-environment >/dev/null 2>&1; then
    pass "systemd --user"
  else
    printf '[FAIL] systemd --user indisponível\n' >&2
    failures=$((failures + 1))
  fi

  printf '\nInstall root: %s\n' "$INSTALL_ROOT"
  printf 'Config root:  %s\n' "$CONFIG_ROOT"
  printf 'State root:   %s\n' "$STATE_ROOT"

  [[ "$failures" -eq 0 ]] || die "doctor encontrou $failures falha(s)"
  pass "doctor READY"
}

plan() {
  local workspace
  workspace="$(source_workspace_guess)" || die "source workspace desconhecido"

  printf 'Source workspace: %s\n' "$workspace"
  printf 'Current release:  %s\n' "$(current_release_id)"
  printf 'Previous release: %s\n' "$(previous_release_id)"
  printf '\n%-10s %-12s %-12s %s\n' "component" "source" "current" "change"

  local release=""
  release="$(current_release_path || true)"

  local kind repo source_short current_short change

  for kind in infra sister nexo praxis; do
    repo="$(repo_path "$workspace" "$kind")"
    source_short="$(git -C "$repo" rev-parse --short=12 HEAD)"
    current_short="-"
    change="NEW"

    if [[ -n "$release" && -f "$release/manifest.json" ]]; then
      current_short="$(jq -r ".components.$kind.commit" "$release/manifest.json" | cut -c1-12)"

      if [[ "$source_short" == "$current_short" ]]; then
        change="SAME"
      else
        change="UPDATE"
      fi
    fi

    printf '%-10s %-12s %-12s %s\n' "$kind" "$source_short" "$current_short" "$change"
  done

  printf '\nNo changes performed.\n'
}

status() {
  printf 'Current:  %s\n' "$(current_release_id)"
  printf 'Previous: %s\n' "$(previous_release_id)"
  printf 'Unit:     %s\n' "$UNIT_NAME"

  if [[ "$TEST_MODE" == "1" ]]; then
    printf 'Service:  TEST_MODE\n'
  else
    printf 'Service:  %s\n' "$(systemctl --user is-active "$UNIT_NAME" 2>/dev/null || true)"
  fi

  local release=""
  release="$(current_release_path || true)"

  if [[ -n "$release" ]]; then
    printf 'Path:     %s\n' "$release"
    release_integrity "$release"

    printf '\n--- ecosystem status ---\n'
    if jq -e '.schema == "sister.infra.workstation.release/3"' \
        "$release/manifest.json" >/dev/null; then
      runtime_status || true
    else
      "$release/components/sister-infra/bin/sister-infra" status --profile lan || true
    fi
  fi
}

release_list() {
  ensure_dirs

  local d

  for d in "$RELEASES_ROOT"/ws-* "$RELEASES_ROOT"/wr-*; do
    [[ -d "$d" ]] || continue

    local id marker=""
    id="$(basename "$d")"

    [[ "$(current_release_id)" == "$id" ]] && marker="${marker} current"
    [[ "$(previous_release_id)" == "$id" ]] && marker="${marker} previous"

    printf '%s%s\n' "$id" "$marker"
  done
}

logs_cmd() {
  if [[ "$TEST_MODE" == "1" ]]; then
    info "TEST_MODE: logs indisponíveis"
    return 0
  fi

  journalctl --user -u "$UNIT_NAME" -n "${SISTER_WORKSTATION_LOG_LINES:-120}" --no-pager
}

main() {
  local command="${1:-help}"
  shift || true

  case "$command" in
    doctor) doctor ;;
    plan) plan ;;
    release-create-composition) release_create_composition "${1:-}" ;;
    candidate-verify) candidate_verify "${1:-}" ;;
    release-create) release_create ;;
    release-create-legacy) release_create_legacy ;;
    runtime-start) runtime_start ;;
    runtime-stop) runtime_stop ;;
    runtime-status) runtime_status ;;
    runtime-verify) runtime_verify ;;
    release-list) release_list ;;
    install) install_release "${1:-}" ;;
    promote)
      [[ -n "${1:-}" ]] || die "promote requer id"
      promote_release "$1"
      ;;
    activate) activate_workstation ;;
    start) start_service ;;
    stop) stop_service ;;
    restart) restart_service ;;
    status) status ;;
    verify) verify_installed ;;
    update) update_workstation ;;
    rollback) rollback_workstation ;;
    logs) logs_cmd ;;
    current)
      printf 'current=%s\n' "$(current_release_id)"
      printf 'previous=%s\n' "$(previous_release_id)"
      ;;
    help|-h|--help) usage ;;
    *) die "comando workstation desconhecido: $command" ;;
  esac
}

main "$@"
