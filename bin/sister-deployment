#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path
from typing import Any

try:
    import jsonschema
except ImportError as exc:  # pragma: no cover - environment failure
    raise SystemExit(
        "[FAIL] sister-deployment requer o módulo Python jsonschema"
    ) from exc


INFRA_ROOT = Path(__file__).resolve().parents[1]
CANDIDATE_CLI = INFRA_ROOT / "bin" / "sister-candidate"
DEPLOYMENT_CONTRACT = "sister.infra.deployment"


class DeploymentError(RuntimeError):
    pass


def load_json(path: Path, label: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise DeploymentError(
            f"não foi possível ler {label}: {path}: {exc}"
        ) from exc
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            f"JSON inválido em {label}: "
            f"{path}:{exc.lineno}:{exc.colno}: {exc.msg}"
        ) from exc

    if not isinstance(value, dict):
        raise DeploymentError(f"{label} deve ser um objeto JSON: {path}")
    return value


def existing_file(value: str, label: str) -> Path:
    path = Path(value).expanduser().resolve()
    if not path.is_file():
        raise DeploymentError(f"{label} inexistente: {path}")
    return path


def schema_path(document: dict[str, Any]) -> Path:
    contract = document.get("schema")
    prefix = f"{DEPLOYMENT_CONTRACT}/"
    if not isinstance(contract, str) or not contract.startswith(prefix):
        raise DeploymentError(
            "contrato de deployment não suportado: "
            f"esperado {DEPLOYMENT_CONTRACT}/<versão>"
        )
    version = contract[len(prefix):]
    if not version or "/" in version:
        raise DeploymentError(f"versão de deployment inválida: {contract!r}")
    return (
        INFRA_ROOT
        / "contracts"
        / "deployment"
        / version
        / "deployment.schema.json"
    )


def validate_deployment(document: dict[str, Any]) -> None:
    schema = load_json(schema_path(document), "schema de deployment")
    try:
        jsonschema.Draft202012Validator.check_schema(schema)
        errors = sorted(
            jsonschema.Draft202012Validator(schema).iter_errors(document),
            key=lambda error: tuple(
                str(part) for part in error.absolute_path
            ),
        )
    except jsonschema.SchemaError as exc:
        raise DeploymentError(
            f"contrato de deployment inválido: {exc}"
        ) from exc

    if errors:
        details = []
        for error in errors:
            location = (
                ".".join(str(part) for part in error.absolute_path)
                or "<root>"
            )
            details.append(f"{location}: {error.message}")
        raise DeploymentError(
            "deployment rejeitado:\n  - " + "\n  - ".join(details)
        )


def validate_candidate(candidate: dict[str, Any]) -> list[dict[str, Any]]:
    schema = candidate.get("schema")
    if schema not in (
        "sister.infra.candidate/1",
        "sister.infra.workstation.candidate/1",
    ):
        raise DeploymentError("schema de candidata não suportado")
    if candidate.get("qualification", {}).get("status") != "PASS":
        raise DeploymentError("candidata deve possuir qualification=PASS")
    if candidate.get("deployment", {}).get("status") != "PENDING_BINDINGS":
        raise DeploymentError(
            "candidata deve possuir deployment=PENDING_BINDINGS"
        )

    components = candidate.get("components")
    if not isinstance(components, list) or not components:
        raise DeploymentError("candidata deve possuir participantes")

    component_ids: set[str] = set()
    system_ids: set[str] = set()
    for index, component in enumerate(components):
        if not isinstance(component, dict):
            raise DeploymentError(
                f"participante inválido na candidata: components.{index}"
            )
        component_id = component.get("component_id")
        system_id = component.get("system_id")
        component_path = component.get("path")
        if not all(
            isinstance(value, str) and value
            for value in (component_id, system_id, component_path)
        ):
            raise DeploymentError(
                f"participante incompleto na candidata: components.{index}"
            )
        if component_id in component_ids:
            raise DeploymentError(
                f"component_id duplicado na candidata: {component_id}"
            )
        if system_id in system_ids:
            raise DeploymentError(
                f"system_id duplicado na candidata: {system_id}"
            )
        component_ids.add(component_id)
        system_ids.add(system_id)
    return components


def validate_bindings(
    components: list[dict[str, Any]],
    deployment: dict[str, Any],
) -> dict[str, dict[str, Any]]:
    expected = {component["system_id"] for component in components}
    by_system: dict[str, dict[str, Any]] = {}
    tcp_endpoints: set[tuple[str, int]] = set()
    gateway_hosts: set[str] = set()

    gw_config = deployment.get("gateway") or {}
    base_domain = gw_config.get("domain") or gw_config.get("base_domain")

    for binding in deployment["bindings"]:
        system_id = binding["system_id"]
        if system_id in by_system:
            raise DeploymentError(
                f"system_id duplicado nos bindings: {system_id}"
            )
        if system_id not in expected:
            raise DeploymentError(f"binding desconhecido: {system_id}")
        by_system[system_id] = binding

        if base_domain:
            if binding.get("gateway") is not None or any(
                k in binding for k in ("domain", "proxy", "certificate", "tls")
            ):
                raise DeploymentError(
                    f"configuração inválida no binding '{system_id}': nenhum "
                    "sistema integrado deve conter configuração própria de "
                    "domínio, proxy ou certificado quando o domínio-base é declarado no gateway"
                )

        runtime = binding["runtime"]
        if runtime["transport"] == "tcp":
            endpoint = (runtime["listen"], runtime["port"])
            if endpoint in tcp_endpoints:
                raise DeploymentError(
                    "conflito de endpoint TCP: "
                    f"{runtime['listen']}:{runtime['port']}"
                )
            tcp_endpoints.add(endpoint)

        if not base_domain:
            gateway = binding.get("gateway")
            if gateway is not None:
                normalized_host = gateway["host"].lower()
                if normalized_host in gateway_hosts:
                    raise DeploymentError(
                        f"gateway host duplicado: {gateway['host']}"
                    )
                gateway_hosts.add(normalized_host)

    missing = sorted(expected - by_system.keys())
    if missing:
        raise DeploymentError(
            "binding faltante para: " + ", ".join(missing)
        )
    return by_system


def verify_canonical_candidate(candidate_dir: Path) -> dict[str, Any]:
    if not CANDIDATE_CLI.is_file():
        raise DeploymentError(
            f"autoridade sister-candidate não encontrada em {CANDIDATE_CLI}"
        )
    result = subprocess.run(
        [sys.executable, str(CANDIDATE_CLI), "verify", str(candidate_dir), "--json"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        err = result.stderr.strip() or result.stdout.strip()
        raise DeploymentError(
            f"verificação autoritativa da candidata falhou:\n{err}"
        )
    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise DeploymentError(
            f"saída JSON inválida de sister-candidate verify: {exc}"
        ) from exc


def resolve(
    candidate: dict[str, Any],
    deployment: dict[str, Any],
    candidate_path: Path | None = None,
) -> dict[str, Any]:
    validate_deployment(deployment)

    schema = candidate.get("schema")
    if schema == "sister.infra.candidate/1":
        if candidate_path is None:
            raise DeploymentError(
                "resolução de candidata canônica requer o caminho do manifesto"
            )
        if candidate_path.name != "manifest.json":
            raise DeploymentError(
                "manifesto de candidata canônica deve ser 'manifest.json'"
            )
        candidate = verify_canonical_candidate(candidate_path.parent)

    components = validate_candidate(candidate)

    composition = candidate.get("composition")
    composition_id = (
        composition.get("composition_id")
        if isinstance(composition, dict)
        else None
    )
    if composition_id != deployment["composition_id"]:
        raise DeploymentError(
            "composição incompatível: "
            f"candidata={composition_id!r} "
            f"deployment={deployment['composition_id']!r}"
        )

    gateway_config = deployment.get("gateway") or {}
    default_protocol = gateway_config.get("protocol", "https")
    default_port = gateway_config.get("port", 8443)
    base_domain = gateway_config.get("domain") or gateway_config.get("base_domain")

    bindings = validate_bindings(components, deployment)
    resolved_components = []
    for component in components:
        binding = bindings[component["system_id"]]
        resolved = {
            "component_id": component["component_id"],
            "system_id": component["system_id"],
            "component_path": component["path"],
            "runtime": binding["runtime"],
        }
        if "probe" in binding:
            resolved["probe"] = binding["probe"]

        if base_domain:
            identity = component["component_id"].lower().replace("_", "-")
            host = f"{identity}.{base_domain}"
            if (default_protocol == "https" and default_port == 443) or (
                default_protocol == "http" and default_port == 80
            ):
                public_url = f"{default_protocol}://{host}"
            else:
                public_url = f"{default_protocol}://{host}:{default_port}"
            resolved["gateway"] = {
                "host": host,
                "public_url": public_url,
            }
        elif "gateway" in binding:
            gw = dict(binding["gateway"])
            host = gw["host"]
            if not gw.get("public_url"):
                if (default_protocol == "https" and default_port == 443) or (
                    default_protocol == "http" and default_port == 80
                ):
                    gw["public_url"] = f"{default_protocol}://{host}"
                else:
                    gw["public_url"] = f"{default_protocol}://{host}:{default_port}"
            resolved["gateway"] = gw
        resolved_components.append(resolved)

    return {
        "schema": "sister.infra.deployment.resolved/1",
        "status": "READY",
        "deployment_id": deployment["deployment_id"],
        "candidate_id": candidate.get("candidate_id"),
        "composition_id": deployment["composition_id"],
        "gateway": gateway_config,
        "components": resolved_components,
    }


def verify_resolved_deployment(
    candidate: dict[str, Any],
    resolved: dict[str, Any],
) -> dict[str, Any]:
    if resolved.get("schema") != "sister.infra.deployment.resolved/1":
        raise DeploymentError(
            f"schema de deployment resolvido inválido: esperado sister.infra.deployment.resolved/1, obtido {resolved.get('schema')}"
        )
    if resolved.get("status") != "READY":
        raise DeploymentError(
            f"deployment resolvido não está READY: status={resolved.get('status')}"
        )

    cand_id = candidate.get("candidate_id")
    res_cand_id = resolved.get("candidate_id")
    if not cand_id:
        raise DeploymentError("manifesto de candidata inválido: candidate_id ausente")
    if not res_cand_id:
        raise DeploymentError("deployment resolvido inválido: candidate_id ausente")
    if cand_id != res_cand_id:
        raise DeploymentError(
            f"incompatibilidade: candidate_id divergente: candidata possui '{cand_id}', mas deployment indica '{res_cand_id}'"
        )

    cand_comp_id = candidate.get("composition", {}).get("composition_id")
    res_comp_id = resolved.get("composition_id")
    if not cand_comp_id:
        raise DeploymentError("manifesto de candidata inválido: composition_id ausente")
    if not res_comp_id:
        raise DeploymentError("deployment resolvido inválido: composition_id ausente")
    if cand_comp_id != res_comp_id:
        raise DeploymentError(
            f"incompatibilidade: composition_id divergente: candidata possui '{cand_comp_id}', mas deployment indica '{res_comp_id}'"
        )

    cand_components = candidate.get("components", [])
    if not isinstance(cand_components, list) or not cand_components:
        raise DeploymentError("candidata sem participantes válidos")

    res_components = resolved.get("components", [])
    if not isinstance(res_components, list) or not res_components:
        raise DeploymentError("deployment resolvido sem participantes")

    seen_cand_cids: set[str] = set()
    seen_cand_sids: set[str] = set()
    cand_pairs: list[tuple[str, str]] = []
    for c in cand_components:
        if not isinstance(c, dict):
            raise DeploymentError(f"candidata contém entrada de componente inválida: {c}")
        cid = c.get("component_id")
        sid = c.get("system_id")
        if not cid:
            raise DeploymentError(f"candidata inválida: componente sem component_id: {c}")
        if not sid:
            raise DeploymentError(f"candidata inválida: componente '{cid}' sem system_id")
        if cid in seen_cand_cids:
            raise DeploymentError(f"candidata possui component_id duplicado: '{cid}'")
        if sid in seen_cand_sids:
            raise DeploymentError(f"candidata possui system_id duplicado: '{sid}'")
        seen_cand_cids.add(cid)
        seen_cand_sids.add(sid)
        cand_pairs.append((cid, sid))

    seen_res_cids: set[str] = set()
    seen_res_sids: set[str] = set()
    res_pairs: list[tuple[str, str]] = []
    for c in res_components:
        if not isinstance(c, dict):
            raise DeploymentError(f"deployment resolvido contém entrada de componente inválida: {c}")
        cid = c.get("component_id")
        sid = c.get("system_id")
        if not cid:
            raise DeploymentError(f"deployment resolvido inválido: componente sem component_id: {c}")
        if not sid:
            raise DeploymentError(f"deployment resolvido inválido: componente '{cid}' sem system_id")
        if cid in seen_res_cids:
            raise DeploymentError(f"deployment resolvido possui component_id duplicado: '{cid}'")
        if sid in seen_res_sids:
            raise DeploymentError(f"deployment resolvido possui system_id duplicado: '{sid}'")
        seen_res_cids.add(cid)
        seen_res_sids.add(sid)
        res_pairs.append((cid, sid))

    cand_pairs.sort()
    res_pairs.sort()

    if cand_pairs != res_pairs:
        raise DeploymentError(
            f"incompatibilidade: participantes (component_id, system_id) divergentes: candidata possui {cand_pairs}, mas deployment resolvido possui {res_pairs}"
        )

    return {
        "schema": "sister.infra.deployment.verified/1",
        "status": "VALID",
        "candidate_id": cand_id,
        "deployment_id": resolved.get("deployment_id"),
        "composition_id": cand_comp_id,
        "components_count": len(cand_pairs),
    }


def generate_dev_binding(
    component_id: str,
    system_id: str,
    port: int,
    listen: str = "127.0.0.1",
    transport: str = "tcp",
    probe_path: str | None = None,
) -> dict[str, Any]:
    if not component_id or not isinstance(component_id, str) or not component_id.strip():
        raise DeploymentError("component_id não pode ser vazio")
    if not system_id or not isinstance(system_id, str) or not system_id.strip():
        raise DeploymentError("system_id não pode ser vazio")
    if transport != "tcp":
        raise DeploymentError(f"transporte não suportado no MVP: {transport} (esperado 'tcp')")
    if listen != "127.0.0.1":
        raise DeploymentError(f"endereço de escuta não suportado no MVP: {listen} (esperado '127.0.0.1')")
    if not isinstance(port, int) or port < 1 or port > 65535:
        raise DeploymentError(f"porta inválida: {port} (esperado 1..65535)")

    comp_entry: dict[str, Any] = {
        "component_id": component_id.strip(),
        "system_id": system_id.strip(),
        "runtime": {
            "transport": transport,
            "listen": listen,
            "port": port,
        },
    }
    if probe_path:
        if not probe_path.startswith("/"):
            raise DeploymentError(f"probe_path inválido: {probe_path} (deve iniciar com '/')")
        comp_entry["probe"] = {
            "health_path": probe_path,
        }

    document = {
        "schema": "sister.infra.runtime.binding/1.0.0",
        "components": [comp_entry],
    }

    schema_file = (
        INFRA_ROOT
        / "contracts"
        / "runtime-binding"
        / "1.0.0"
        / "runtime-binding.schema.json"
    )
    if schema_file.is_file():
        schema = load_json(schema_file, "schema de runtime-binding")
        try:
            validator = jsonschema.Draft202012Validator(schema)
            errors = sorted(
                validator.iter_errors(document),
                key=lambda e: tuple(str(p) for p in e.absolute_path),
            )
            if errors:
                raise DeploymentError(
                    "runtime-binding rejeitado pelo schema: "
                    + "; ".join(e.message for e in errors)
                )
        except jsonschema.SchemaError as exc:
            raise DeploymentError(f"schema de runtime-binding inválido: {exc}") from exc

    return document


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        description="Resolve e verifica bindings de deployment para uma candidata"
    )
    subcommands = result.add_subparsers(dest="command", required=True)

    resolve_parser = subcommands.add_parser(
        "resolve", help="Resolve deployment declarativo contra candidata"
    )
    resolve_parser.add_argument("candidate_manifest")
    resolve_parser.add_argument("deployment")
    resolve_parser.add_argument("--json", action="store_true")

    verify_parser = subcommands.add_parser(
        "verify", help="Verifica compatibilidade entre candidata e deployment resolvido"
    )
    verify_parser.add_argument("candidate_manifest")
    verify_parser.add_argument("resolved_deployment")
    verify_parser.add_argument("--json", action="store_true")

    dev_parser = subcommands.add_parser(
        "dev-binding",
        help="Emite runtime binding efêmero para desenvolvimento (DEV Preview)",
    )
    dev_parser.add_argument(
        "--component-id", required=True, help="Identificador do componente"
    )
    dev_parser.add_argument(
        "--system-id", required=True, help="Identificador do sistema"
    )
    dev_parser.add_argument(
        "--port", required=True, type=int, help="Porta TCP de escuta (1..65535)"
    )
    dev_parser.add_argument(
        "--listen", default="127.0.0.1", help="Endereço de escuta (padrão: 127.0.0.1)"
    )
    dev_parser.add_argument(
        "--transport", default="tcp", help="Transporte (padrão: tcp)"
    )
    dev_parser.add_argument(
        "--probe-path", help="Caminho de probe de health (opcional, ex: /api/health)"
    )
    dev_parser.add_argument(
        "--out", help="Caminho do arquivo de saída para gravar o documento JSON"
    )
    dev_parser.add_argument(
        "--json", action="store_true", help="Emite o resultado em JSON na saída padrão"
    )

    return result


def main() -> int:
    args = parser().parse_args()
    try:
        if args.command == "dev-binding":
            result = generate_dev_binding(
                component_id=args.component_id,
                system_id=args.system_id,
                port=args.port,
                listen=args.listen,
                transport=args.transport,
                probe_path=args.probe_path,
            )
            raw = json.dumps(result, indent=2, sort_keys=True) + "\n"
            if args.out:
                out_path = Path(args.out).expanduser().resolve()
                out_path.parent.mkdir(parents=True, exist_ok=True)
                out_path.write_text(raw, encoding="utf-8")
            if args.json or not args.out:
                print(raw, end="")
            else:
                print(
                    f"[PASS] runtime binding emitido: {args.system_id} -> "
                    f"{args.listen}:{args.port}"
                )
            return 0

        candidate_path = existing_file(
            args.candidate_manifest, "manifesto de candidata"
        )
        if args.command == "resolve":
            deployment_path = existing_file(args.deployment, "deployment")
            result = resolve(
                load_json(candidate_path, "manifesto de candidata"),
                load_json(deployment_path, "deployment"),
                candidate_path=candidate_path,
            )
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                print(
                    "[PASS] deployment resolvido: "
                    f"{result['deployment_id']} -> {result['candidate_id']}"
                )
                print(f"status={result['status']}")
                for component in result["components"]:
                    print(
                        f"{component['system_id']} -> "
                        f"{component['runtime']['transport']}"
                    )
            return 0

        elif args.command == "verify":
            resolved_path = existing_file(
                args.resolved_deployment, "deployment resolvido"
            )
            candidate_doc = load_json(candidate_path, "manifesto de candidata")
            resolved_doc = load_json(resolved_path, "deployment resolvido")
            result = verify_resolved_deployment(candidate_doc, resolved_doc)
            if args.json:
                print(json.dumps(result, indent=2, sort_keys=True))
            else:
                print(
                    f"[PASS] deployment resolvido compatível com a candidata: {result['deployment_id']} -> {result['candidate_id']}"
                )
            return 0

        else:
            raise DeploymentError(f"comando desconhecido: {args.command}")

    except DeploymentError as exc:
        print(f"[FAIL] {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
