#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

INFRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
RUN_ROOT="${SISTER_INFRA_RUN_ROOT:-$INFRA_ROOT/.run}"
GATEWAY_RUN="$RUN_ROOT/gateway"
LOG_ROOT="$RUN_ROOT/logs"
PROFILE="lan"
COMMAND=""

usage() {
  cat <<'USAGE'
SisTer Infra — harness operacional do ecossistema

Uso:
  ./bin/sister-infra <comando> [--profile dev|lan|production]

Comandos:
  bootstrap   prepara TLS e valida gateway do deployment resolvido
  up          inicia gateway derivado do deployment resolvido
  down        para o gateway declarativo
  status      observa bindings e gateway declarativos
  verify      valida bindings, TLS e gateway declarativos

Exemplos:
  ./bin/sister-infra bootstrap --profile lan
  ./bin/sister-infra up --profile lan
  ./bin/sister-infra status --profile lan
  ./bin/sister-infra down --profile lan

Produção exige config/production.env, PRODUCTION_APPROVED=YES e:
  SISTER_INFRA_PRODUCTION_CONFIRM=YES ./bin/sister-infra up --profile production
USAGE
}

log()  { printf '[infra] %s\n' "$*"; }
pass() { printf '[PASS] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die()  { printf '[FAIL] %s\n' "$*" >&2; exit 2; }

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "comando obrigatório ausente: $1"
}

load_profile() {
  # shellcheck disable=SC1091
  source "$INFRA_ROOT/config/common.env"

  local profile_file="$INFRA_ROOT/config/${PROFILE}.env"
  if [[ "$PROFILE" == "production" && ! -f "$profile_file" ]]; then
    die "produção não configurada. Copie config/production.env.example para config/production.env e revise."
  fi
  [[ -f "$profile_file" ]] || die "perfil inexistente: $PROFILE"
  # shellcheck disable=SC1090
  source "$profile_file"

  mkdir -p "$GATEWAY_RUN" "$LOG_ROOT" "$INFRA_ROOT/secrets"
  chmod 700 "$RUN_ROOT" "$GATEWAY_RUN" "$LOG_ROOT" "$INFRA_ROOT/secrets" 2>/dev/null || true

  TLS_PEM="${TLS_PEM:-$INFRA_ROOT/secrets/ecosystem-lab.pem}"
  CA_CERT="${CA_CERT:-$INFRA_ROOT/secrets/ecosystem-lab-ca.crt}"
  CA_KEY="${CA_KEY:-$INFRA_ROOT/secrets/ecosystem-lab-ca.key}"
  GATEWAY_CFG="$GATEWAY_RUN/haproxy-${PROFILE}.cfg"
  GATEWAY_PID="$GATEWAY_RUN/haproxy-${PROFILE}.pid"
  GATEWAY_LOG="$LOG_ROOT/haproxy-${PROFILE}.log"
}

production_preflight() {
  [[ "$PROFILE" == "production" ]] || return 0

  [[ "${PRODUCTION_APPROVED:-NO}" == "YES" ]] || \
    die "PRODUCTION_APPROVED=YES não está definido em config/production.env"

  [[ "${SISTER_INFRA_PRODUCTION_CONFIRM:-NO}" == "YES" ]] || \
    die "produção exige SISTER_INFRA_PRODUCTION_CONFIRM=YES no comando"

  [[ "${TLS_MODE:-}" == "external" ]] || die "produção exige TLS_MODE=external"
  [[ -f "$TLS_PEM" ]] || die "TLS PEM de produção não encontrado: $TLS_PEM"

  if [[ -n "${PRODUCTION_GATE_CMD:-}" ]]; then
    log "Executando gate de produção..."
    bash -lc "$PRODUCTION_GATE_CMD" || die "gate de produção bloqueou a promoção"
    pass "gate de produção"
  else
    die "PRODUCTION_GATE_CMD não definido; produção falha fechado"
  fi
}

# ---------------------------------------------------------------------------
# Lifecycle TLS de laboratório
# ---------------------------------------------------------------------------
#
# A existência dos arquivos NÃO constitui evidência de validade.
#
# Invariantes:
#   TLS-001: CA existe e é parseável.
#   TLS-002: CA possui validade residual mínima.
#   TLS-003: certificado existe e é parseável.
#   TLS-004: certificado possui validade residual mínima.
#   TLS-005: certificado valida contra a CA corrente.
#   TLS-006: certificado cobre todos os hosts configurados.
#
# Política:
#   - CA saudável + certificado saudável -> preservar bytes.
#   - CA saudável + certificado inadequado -> renovar apenas certificado.
#   - CA inadequada -> rotacionar CA + certificado.
#   - CA saudável sem chave correspondente, quando o certificado precisa
#     ser renovado -> rotacionar CA + certificado.
#
# Janela preventiva padrão: 30 dias.
TLS_RENEW_BEFORE_SECONDS="${TLS_RENEW_BEFORE_SECONDS:-2592000}"
CA_RENEW_BEFORE_SECONDS="${CA_RENEW_BEFORE_SECONDS:-2592000}"

lab_tls_expected_hosts() {
  local resolved="${SISTER_RESOLVED_DEPLOYMENT_FILE:-}"
  [[ -n "$resolved" && -f "$resolved" ]] || \
    die "deployment resolvido ausente para lifecycle TLS"

  jq -er '
    if .schema == "sister.infra.deployment.resolved/1"
       and .status == "READY"
    then
      [.components[] | select(.gateway != null) | .gateway.host]
      | unique[]
    else
      error("deployment resolvido inválido para lifecycle TLS")
    end
  ' "$resolved" || die "não foi possível derivar hosts TLS do deployment"
}

lab_tls_ca_parseable() {
  [[ -f "$CA_CERT" ]] || return 1
  openssl x509 -in "$CA_CERT" -noout >/dev/null 2>&1
}

lab_tls_ca_valid() {
  lab_tls_ca_parseable || return 1
  openssl x509 \
    -checkend "$CA_RENEW_BEFORE_SECONDS" \
    -noout \
    -in "$CA_CERT" >/dev/null 2>&1
}

lab_tls_cert_parseable() {
  [[ -f "$TLS_PEM" ]] || return 1
  openssl x509 -in "$TLS_PEM" -noout >/dev/null 2>&1
}

lab_tls_cert_valid() {
  lab_tls_cert_parseable || return 1
  openssl x509 \
    -checkend "$TLS_RENEW_BEFORE_SECONDS" \
    -noout \
    -in "$TLS_PEM" >/dev/null 2>&1
}

lab_tls_cert_signed_by_current_ca() {
  lab_tls_ca_parseable || return 1
  lab_tls_cert_parseable || return 1

  local cert_tmp
  cert_tmp="$(mktemp "$GATEWAY_RUN/tls-verify-cert.XXXXXX")"

  if ! openssl x509 -in "$TLS_PEM" -out "$cert_tmp" >/dev/null 2>&1; then
    rm -f "$cert_tmp"
    return 1
  fi

  if openssl verify -CAfile "$CA_CERT" "$cert_tmp" >/dev/null 2>&1; then
    rm -f "$cert_tmp"
    return 0
  fi

  rm -f "$cert_tmp"
  return 1
}

lab_tls_cert_has_host() {
  local host="$1"

  lab_tls_cert_parseable || return 1

  openssl x509 \
      -in "$TLS_PEM" \
      -noout \
      -ext subjectAltName 2>/dev/null |
    tr ',' '\n' |
    sed 's/^[[:space:]]*//' |
    grep -Fxq "DNS:${host}"
}

lab_tls_certificate_hosts() {
  lab_tls_cert_parseable || return 1

  openssl x509 \
      -in "$TLS_PEM" \
      -noout \
      -ext subjectAltName 2>/dev/null |
    tr ',' '\n' |
    sed 's/^[[:space:]]*//' |
    sed -n 's/^DNS://p' |
    sort -u
}

lab_tls_cert_matches_expected_hosts() {
  local actual
  local expected

  actual="$(lab_tls_certificate_hosts)" || return 1
  expected="$(lab_tls_expected_hosts | sort -u)" || return 1

  [[ -n "$expected" && "$actual" == "$expected" ]]
}

lab_tls_ca_key_matches_cert() {
  [[ -f "$CA_KEY" ]] || return 1
  lab_tls_ca_parseable || return 1

  local cert_digest
  local key_digest

  cert_digest="$(
    openssl x509 -in "$CA_CERT" -pubkey -noout 2>/dev/null |
    openssl pkey -pubin -outform DER 2>/dev/null |
    openssl dgst -sha256 2>/dev/null
  )" || return 1

  key_digest="$(
    openssl pkey -in "$CA_KEY" -pubout -outform DER 2>/dev/null |
    openssl dgst -sha256 2>/dev/null
  )" || return 1

  [[ -n "$cert_digest" && "$cert_digest" == "$key_digest" ]]
}

lab_tls_backup_current() {
  local stamp
  local dir

  stamp="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  dir="$GATEWAY_RUN/tls-backup/$stamp"

  mkdir -p "$dir"
  chmod 700 "$dir"

  [[ ! -f "$TLS_PEM" ]] || cp -p "$TLS_PEM" "$dir/"
  [[ ! -f "$CA_CERT" ]] || cp -p "$CA_CERT" "$dir/"
  [[ ! -f "$CA_KEY" ]] || cp -p "$CA_KEY" "$dir/"

  printf '%s\n' "$dir"
}

lab_tls_ca_fingerprint() {
  [[ -f "$CA_CERT" ]] || return 1
  openssl x509 \
    -in "$CA_CERT" \
    -noout \
    -fingerprint \
    -sha256 2>/dev/null
}

generate_lab_ca() {
  log "Gerando nova CA de laboratório do sister-infra..."

  openssl genrsa -out "$CA_KEY" 4096 >/dev/null 2>&1
  chmod 600 "$CA_KEY"

  openssl req \
    -x509 \
    -new \
    -nodes \
    -key "$CA_KEY" \
    -sha256 \
    -days 3650 \
    -subj "/CN=SisTer Infra Lab CA" \
    -out "$CA_CERT" >/dev/null 2>&1

  chmod 644 "$CA_CERT"

  lab_tls_ca_valid || \
    die "CA recém-gerada falhou na validação temporal"
}

generate_lab_server_certificate() {
  lab_tls_ca_valid || \
    die "não é possível emitir certificado: CA lab inválida"

  lab_tls_ca_key_matches_cert || \
    die "não é possível emitir certificado: chave da CA não corresponde à CA"

  local tmp
  local host
  local -a hosts=()

  tmp="$(mktemp -d "$GATEWAY_RUN/tls-issue.XXXXXX")"
  chmod 700 "$tmp"

  while IFS= read -r host; do
    [[ -n "$host" ]] || continue
    hosts+=("$host")
  done < <(lab_tls_expected_hosts)

  [[ "${#hosts[@]}" -gt 0 ]] || {
    rm -rf "$tmp"
    die "nenhum hostname configurado para o certificado TLS"
  }

  openssl genrsa -out "$tmp/gateway.key" 3072 >/dev/null 2>&1

  {
    cat <<CFG
[req]
prompt = no
distinguished_name = dn
req_extensions = req_ext

[dn]
CN = ${hosts[0]}

[req_ext]
subjectAltName = @alt_names

[alt_names]
CFG

    local i=1
    for host in "${hosts[@]}"; do
      printf 'DNS.%d = %s\n' "$i" "$host"
      i=$((i + 1))
    done
  } > "$tmp/openssl.cnf"

  openssl req \
    -new \
    -key "$tmp/gateway.key" \
    -out "$tmp/gateway.csr" \
    -config "$tmp/openssl.cnf" >/dev/null 2>&1

  {
    printf 'subjectAltName='

    local first=1
    for host in "${hosts[@]}"; do
      if [[ "$first" -eq 0 ]]; then
        printf ','
      fi
      printf 'DNS:%s' "$host"
      first=0
    done

    printf '\nextendedKeyUsage=serverAuth\n'
    printf 'keyUsage=digitalSignature,keyEncipherment\n'
  } > "$tmp/ext.cnf"

  openssl x509 \
    -req \
    -in "$tmp/gateway.csr" \
    -CA "$CA_CERT" \
    -CAkey "$CA_KEY" \
    -CAserial "$tmp/ca.srl" \
    -CAcreateserial \
    -out "$tmp/gateway.crt" \
    -days 825 \
    -sha256 \
    -extfile "$tmp/ext.cnf" >/dev/null 2>&1

  cat "$tmp/gateway.crt" "$tmp/gateway.key" > "$TLS_PEM"
  chmod 600 "$TLS_PEM"

  rm -rf "$tmp"

  lab_tls_cert_valid || \
    die "certificado recém-gerado falhou na validação temporal"

  lab_tls_cert_signed_by_current_ca || \
    die "certificado recém-gerado não valida contra a CA corrente"

  lab_tls_cert_matches_expected_hosts || \
    die "SANs do certificado recém-gerado divergem do deployment"
}

generate_lab_tls() {
  [[ "$PROFILE" != "production" ]] || return 0
  [[ "${TLS_MODE:-lab}" == "lab" ]] || return 0

  local ca_ok=0
  local cert_ok=0
  local rotate_ca=0
  local renew_cert=0
  local backup_dir=""
  local old_fingerprint=""

  if lab_tls_ca_valid; then
    ca_ok=1
  fi

  if [[ "$ca_ok" -eq 1 ]] &&
     lab_tls_cert_valid &&
     lab_tls_cert_signed_by_current_ca &&
     lab_tls_cert_matches_expected_hosts; then
    cert_ok=1
  fi

  if [[ "$ca_ok" -eq 1 && "$cert_ok" -eq 1 ]]; then
    return 0
  fi

  if [[ "$ca_ok" -eq 0 ]]; then
    if lab_tls_ca_parseable; then
      warn "CA lab expirada ou dentro da janela preventiva de renovação."
      old_fingerprint="$(lab_tls_ca_fingerprint || true)"
    else
      warn "CA lab ausente ou não parseável."
    fi

    rotate_ca=1
    renew_cert=1
  else
    if ! lab_tls_cert_parseable; then
      warn "certificado TLS lab ausente ou não parseável; será reemitido."
    elif ! lab_tls_cert_valid; then
      warn "certificado TLS lab expirado ou dentro da janela preventiva; será reemitido."
    elif ! lab_tls_cert_signed_by_current_ca; then
      warn "certificado TLS lab não pertence à CA corrente; será reemitido."
    elif ! lab_tls_cert_matches_expected_hosts; then
      warn "SANs do certificado TLS divergem do deployment; será reemitido."
    fi

    renew_cert=1

    if ! lab_tls_ca_key_matches_cert; then
      warn "chave privada da CA ausente ou incompatível."
      warn "não é possível renovar preservando essa CA; será necessária rotação."
      rotate_ca=1
    fi
  fi

  backup_dir="$(lab_tls_backup_current)"
  log "Backup do material TLS anterior: $backup_dir"

  if [[ "$rotate_ca" -eq 1 ]]; then
    generate_lab_ca

    warn "A CA de laboratório foi ROTACIONADA."
    warn "Clientes LAN que confiavam na CA anterior devem instalar:"
    warn "  $CA_CERT"

    if [[ -n "$old_fingerprint" ]]; then
      warn "Fingerprint anterior: $old_fingerprint"
    fi

    warn "Fingerprint atual: $(lab_tls_ca_fingerprint)"
  fi

  if [[ "$renew_cert" -eq 1 ]]; then
    generate_lab_server_certificate

    local hosts_text=""
    local host

    while IFS= read -r host; do
      [[ -n "$host" ]] || continue
      if [[ -n "$hosts_text" ]]; then
        hosts_text="${hosts_text}, "
      fi
      hosts_text="${hosts_text}${host}"
    done < <(lab_tls_expected_hosts)

    pass "TLS lab válido para: $hosts_text"
  fi
}

render_gateway() {
  [[ -f "$TLS_PEM" ]] || die "TLS PEM ausente: $TLS_PEM"

  local resolved="${SISTER_RESOLVED_DEPLOYMENT_FILE:-}"
  [[ -n "$resolved" && -f "$resolved" ]] || \
    die "deployment resolvido ausente; defina SISTER_RESOLVED_DEPLOYMENT_FILE"

  "$INFRA_ROOT/bin/sister-gateway" render \
    "$resolved" \
    --listen-address "$GATEWAY_LISTEN_ADDRESS" \
    --listen-port "$GATEWAY_LISTEN_PORT" \
    --tls-pem "$TLS_PEM" \
    > "$GATEWAY_CFG" || die "falha ao renderizar gateway declarativo"

  "$HAPROXY_BIN" -c -f "$GATEWAY_CFG" >/dev/null || die "configuração HAProxy inválida"
  pass "configuração HAProxy válida"
}

pid_alive() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  local pid
  pid="$(cat "$file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

stop_gateway() {
  if pid_alive "$GATEWAY_PID"; then
    local pid
    pid="$(cat "$GATEWAY_PID")"
    log "Parando HAProxy PID $pid..."
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "HAProxy não encerrou graciosamente; enviando TERM novamente"
      kill -TERM "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$GATEWAY_PID"
}

start_gateway() {
  stop_gateway
  render_gateway
  log "Subindo gateway $GATEWAY_LISTEN_ADDRESS:$GATEWAY_LISTEN_PORT..."
  "$HAPROXY_BIN" -D -f "$GATEWAY_CFG" -p "$GATEWAY_PID" >>"$GATEWAY_LOG" 2>&1
  sleep 0.4
  pid_alive "$GATEWAY_PID" || die "HAProxy não permaneceu ativo; veja $GATEWAY_LOG"
  pass "gateway ativo"
}

bootstrap() {
  runtime_preflight
  if [[ "$PROFILE" == "production" ]]; then
    [[ "${TLS_MODE:-}" == "external" ]] || die "produção exige TLS_MODE=external"
    [[ -f "$TLS_PEM" ]] || die "TLS de produção ausente: $TLS_PEM"
  else
    generate_lab_tls
  fi
  render_gateway

  echo
  pass "bootstrap concluído ($PROFILE)"
  if [[ "$PROFILE" != "production" ]]; then
    echo "CA de laboratório: $CA_CERT"
  fi
}

runtime_preflight() {
  require_command curl
  require_command jq
  require_command openssl

  if [[ -z "${SISTER_RESOLVED_DEPLOYMENT_FILE:-}" || ! -f "$SISTER_RESOLVED_DEPLOYMENT_FILE" ]]; then
    local current_link="${SISTER_WORKSTATION_INSTALL_ROOT:-$HOME/.local/share/sister}/current"
    if [[ -L "$current_link" ]]; then
      local current_path
      current_path="$(readlink -f "$current_link")/evidence/deployment/resolved.json"
      if [[ -f "$current_path" ]]; then
        export SISTER_RESOLVED_DEPLOYMENT_FILE="$current_path"
      fi
    fi
  fi

  local resolved="${SISTER_RESOLVED_DEPLOYMENT_FILE:-}"
  [[ -n "$resolved" && -f "$resolved" ]] || \
    die "deployment resolvido ausente; defina SISTER_RESOLVED_DEPLOYMENT_FILE"
  jq -e '
    .schema == "sister.infra.deployment.resolved/1"
    and .status == "READY"
    and (.components | type == "array" and length > 0)
  ' "$resolved" >/dev/null || die "deployment resolvido inválido"

  if [[ ! -x "$HAPROXY_BIN" ]]; then
    local detected
    detected="$(command -v haproxy 2>/dev/null || true)"
    [[ -n "$detected" ]] || die "HAProxy não encontrado em $HAPROXY_BIN nem no PATH"
    HAPROXY_BIN="$detected"
  fi
  "$HAPROXY_BIN" -vv >/dev/null 2>&1 || \
    die "HAProxy não executável: $HAPROXY_BIN"
}

component_health() {
  local component_id="$1"
  local transport="$2"
  local endpoint_a="$3"
  local endpoint_b="$4"
  local health_path="$5"

  [[ -n "$health_path" && "$health_path" != "null" ]] || return 0

  case "$transport" in
    tcp)
      curl --noproxy '*' -fsS --max-time 5 \
        "http://${endpoint_a}:${endpoint_b}${health_path}" >/dev/null
      ;;
    unix)
      curl --noproxy '*' -fsS --max-time 5 \
        --unix-socket "$endpoint_a" \
        "http://localhost${health_path}" >/dev/null
      ;;
    *) die "transport desconhecido para $component_id: $transport" ;;
  esac
}

verify_components() {
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local component_id transport endpoint_a endpoint_b health_path
  while IFS=$'\t' read -r \
      component_id transport endpoint_a endpoint_b health_path; do
    [[ -n "$component_id" ]] || continue
    component_health \
      "$component_id" "$transport" "$endpoint_a" "$endpoint_b" "$health_path" \
      && pass "$component_id saudável" \
      || die "$component_id não respondeu ao probe declarativo"
  done < <(
    jq -r '
      .components[]
      | [
          .component_id,
          .runtime.transport,
          (if .runtime.transport == "tcp" then .runtime.listen else .runtime.socket end),
          (if .runtime.transport == "tcp" then (.runtime.port | tostring) else "-" end),
          (.probe.health_path // "")
        ] | @tsv
    ' "$resolved"
  )
}

verify_gateway_urls() {
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local -a cacert_args=()
  if [[ "$PROFILE" != "production" && -f "$CA_CERT" ]]; then
    cacert_args=(--cacert "$CA_CERT")
  fi

  local component_id host health_path
  while IFS=$'\t' read -r component_id host health_path; do
    [[ -n "$component_id" ]] || continue
    curl --noproxy '*' -fsS --max-time 5 \
      "${cacert_args[@]}" \
      --resolve "$host:$GATEWAY_LISTEN_PORT:$GATEWAY_LISTEN_ADDRESS" \
      "https://$host:$GATEWAY_LISTEN_PORT$health_path" >/dev/null \
      && pass "$component_id via gateway" \
      || die "$component_id não respondeu via gateway"
  done < <(
    jq -r '
      .components[]
      | select(.gateway != null and (.probe.health_path // "") != "")
      | [.component_id, .gateway.host, .probe.health_path] | @tsv
    ' "$resolved"
  )
}

cmd_up() {
  runtime_preflight
  production_preflight
  [[ "$PROFILE" == "production" ]] || generate_lab_tls
  start_gateway
  if ! verify_components || ! verify_gateway_urls; then
    stop_gateway
    die "verificação após start do gateway declarativo falhou"
  fi
  pass "gateway declarativo ativo"
}

cmd_down() {
  runtime_preflight
  stop_gateway
  pass "gateway declarativo parado"
}

cmd_status() {
  runtime_preflight
  verify_components
  pid_alive "$GATEWAY_PID" || die "gateway declarativo OFFLINE"
  pass "gateway declarativo PID $(cat "$GATEWAY_PID")"
}

cmd_verify() {
  runtime_preflight
  production_preflight
  [[ "$PROFILE" == "production" ]] || generate_lab_tls
  render_gateway
  verify_components
  pid_alive "$GATEWAY_PID" || die "gateway declarativo não está ativo"
  verify_gateway_urls
  pass "deployment declarativo verificado"
}

parse_args() {
  [[ $# -ge 1 ]] || { usage; exit 2; }
  COMMAND="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        [[ $# -ge 2 ]] || die "--profile exige valor"
        PROFILE="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "opção desconhecida: $1"
        ;;
    esac
  done

  case "$PROFILE" in
    dev|lan|production) ;;
    *) die "perfil inválido: $PROFILE" ;;
  esac
}

cmd_client_env() {
  runtime_preflight
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local values
  values="$(jq -r --arg gw_ip "${GATEWAY_LISTEN_ADDRESS:-}" '
    ["localhost", "127.0.0.0/8", "127.0.0.1", "::1"]
    + (if $gw_ip != "" then [$gw_ip] else [] end)
    + [.components[] | select(.runtime.transport == "tcp") | .runtime.listen]
    + [.components[] | select(.gateway != null) | .gateway.host]
    | unique | join(",")
  ' "$resolved")"
  printf 'export NO_PROXY="%s"\n' "$values"
  printf 'export no_proxy="%s"\n' "$values"
}

cmd_hosts_line() {
  runtime_preflight
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local hosts_list
  hosts_list="$(jq -r '
    [.components[] | select(.gateway != null) | .gateway.host]
    | unique | join(" ")
  ' "$resolved")"
  printf '%s %s\n' "${GATEWAY_LISTEN_ADDRESS:-127.0.0.1}" "$hosts_list"
}

main() {
  parse_args "$@"
  load_profile

  case "$COMMAND" in
    bootstrap) bootstrap ;;
    up)        cmd_up ;;
    down)      cmd_down ;;
    status)    cmd_status ;;
    verify)    cmd_verify ;;
    client-env) cmd_client_env ;;
    hosts-line|hosts) cmd_hosts_line ;;
    help|-h|--help) usage ;;
    *) die "comando desconhecido: $COMMAND" ;;
  esac
}

# SISTER-INFRA-DISPATCH
if [[ "${1:-}" == "candidate" ]]; then
  shift
  exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/sister-candidate" "$@"
fi

if [[ "${1:-}" == "workstation" ]]; then
  shift
  exec "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/sister-workstation" "$@"
fi

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
