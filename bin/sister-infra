#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

INFRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
RUNTIME_GATEWAY="$INFRA_ROOT/libexec/sister-infra/runtime-gateway"
PROFILE="lan"
COMMAND=""

usage() {
  cat <<'USAGE'
SisTer Infra — control plane operacional do ecossistema

Uso:
  sister-infra dev <comando> [opções]
  sister-infra lab <comando> [opções]
  sister-infra production <comando> [opções]
  sister-infra lifecycle <comando> [opções]
  sister-infra workstation <comando> [opções]
  sister-infra authority <comando> [opções]

Ambientes:
  dev           operações efêmeras de desenvolvimento (preview)
  lab           operações do ambiente LAB (plan, apply, tls)
  production    operações governadas de produção (plan, apply, verify)

Orquestração:
  lifecycle     orquestração end-to-end do ciclo de vida (plan, run, status, maintain, evidence)

Administração:
  workstation   gerenciador de releases e manutenção da workstation
  authority     resolução e migração de autoridade institucional

Exemplos:
  sister-infra dev preview <component> [--port <porta>] [--duration <seg>]
  sister-infra lab plan
  sister-infra lab apply
  sister-infra lab tls status
  sister-infra production plan --desired-candidate <cand> --desired-deployment <dep> --json
  sister-infra production apply --plan <plano> --plan-digest <digest>
  sister-infra production verify
  sister-infra lifecycle plan
  sister-infra lifecycle status
  sister-infra workstation doctor
  sister-infra workstation repair
USAGE
}

die()  { printf '[FAIL] %s\n' "$*" >&2; exit 2; }

bootstrap() {
  die "O comando 'bootstrap' top-level histórico foi aposentado (OPS-07A2).
Fluxo canônico:
  1. sister-infra workstation bootstrap   # layout estrutural local
  2. sister-infra lab tls status/init-ca  # autoridade CA explícita
  3. sister-infra lab apply               # materialização declarativa e runtime"
}

# 1. Canonical namespaces dispatch (fast path)
case "${1:-}" in
  dev)
    shift
    exec "$INFRA_ROOT/bin/sister-dev" "$@"
    ;;
  lab)
    shift
    exec "$INFRA_ROOT/bin/sister-lab" "$@"
    ;;
  production)
    shift
    exec "$INFRA_ROOT/bin/sister-production" "$@"
    ;;
  lifecycle)
    shift
    exec "$INFRA_ROOT/bin/sister-lifecycle" "$@"
    ;;
  workstation)
    shift
    exec "$INFRA_ROOT/bin/sister-workstation" "$@"
    ;;
  authority)
    shift
    exec "$INFRA_ROOT/bin/sister-authority" "$@"
    ;;
  candidate)
    shift
    exec "$INFRA_ROOT/bin/sister-candidate" "$@"
    ;;
  bootstrap)
    bootstrap
    ;;
  -h|--help|help)
    usage
    exit 0
    ;;
  "")
    usage >&2
    exit 2
    ;;
esac

# 2. Historical top-level compatibility parsing
COMMAND="$1"
shift

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      [[ $# -ge 2 ]] || die "--profile exige valor"
      PROFILE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "opção desconhecida: $1"
      ;;
  esac
done

case "$PROFILE" in
  dev|lan|production) ;;
  *) die "perfil inválido: $PROFILE" ;;
esac

# 3. Route legacy production profile
if [[ "$PROFILE" == "production" ]]; then
  case "$COMMAND" in
    up|down)
      die "'$COMMAND --profile production' foi retirado pelo OPS-10: produção exige o fluxo governado 'sister-infra production plan' seguido de 'sister-infra production apply --plan <plano> --plan-digest <digest>'"
      ;;
    verify)
      printf '[DEPRECATED] use sister-infra production verify\n' >&2
      exec "$INFRA_ROOT/bin/sister-production" verify
      ;;
    status)
      die "'status --profile production' foi retirado pelo OPS-10; use 'sister-infra production verify' até 'production status' estar disponível"
      ;;
    *)
      die "--profile production não é suportado por '$COMMAND'; use sister-infra production"
      ;;
  esac
fi

# 4. Route legacy runtime-gateway commands
case "$COMMAND" in
  up|down|status|verify|client-env|hosts-line|hosts)
    [[ -x "$RUNTIME_GATEWAY" ]] || \
      die "adapter privado de runtime ausente ou não executável: $RUNTIME_GATEWAY"
    printf '[DEPRECATED] sister-infra %s é um comando histórico de runtime; use a interface canônica (dev, lab, workstation) ou libexec/sister-infra/runtime-gateway diretamente\n' "$COMMAND" >&2
    exec "$RUNTIME_GATEWAY" "$COMMAND" --profile "$PROFILE"
    ;;
  *)
    die "comando desconhecido: $COMMAND (consulte sister-infra --help)"
    ;;
esac
