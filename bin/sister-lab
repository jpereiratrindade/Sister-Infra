#!/usr/bin/env python3
"""LAB UX resolver for sister-infra (OPS-06)."""

from __future__ import annotations

import argparse
import os
from datetime import datetime, timezone
import fcntl
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from typing import Any

INFRA_ROOT = Path(__file__).resolve().parent.parent
AUTHORITY_CLI = INFRA_ROOT / "bin" / "sister-authority"

class LabUxError(RuntimeError):
    pass


def resolve_installation_lock_path(locks_dir: Path) -> Path:
    locks_dir.mkdir(parents=True, exist_ok=True)
    canonical = locks_dir / "installation.lock"
    legacy = locks_dir / "workstation-lifecycle.lock"

    canonical_exists = canonical.exists()
    canonical_is_symlink = canonical.is_symlink()
    legacy_exists = legacy.exists()
    legacy_is_symlink = legacy.is_symlink()

    # Caso 1: Conflito de dual-regular files com inodes distintos
    if canonical_exists and not canonical_is_symlink and legacy_exists and not legacy_is_symlink:
        if canonical.stat().st_ino != legacy.stat().st_ino:
            raise LabUxError(
                f"INSTALLATION_LOCK_IDENTITY_CONFLICT: foram encontrados dois arquivos regulares de lock "
                f"com inodes distintos ({canonical} != {legacy}). A migração requer intervenção administrativa."
            )

    # Caso 2: Symlink apontando para terceiro target inesperado
    if canonical_is_symlink:
        target = canonical.resolve()
        if target != legacy.resolve() and target != canonical:
            if not target.is_relative_to(locks_dir) or (target.name != "workstation-lifecycle.lock" and target.name != "installation.lock"):
                raise LabUxError(
                    f"INSTALLATION_LOCK_IDENTITY_CONFLICT: link simbólico de lock {canonical} aponta para "
                    f"alvo não reconhecido: {target}"
                )
    if legacy_is_symlink:
        target = legacy.resolve()
        if target != canonical.resolve() and target != legacy:
            if not target.is_relative_to(locks_dir) or (target.name != "workstation-lifecycle.lock" and target.name != "installation.lock"):
                raise LabUxError(
                    f"INSTALLATION_LOCK_IDENTITY_CONFLICT: link simbólico de lock legado {legacy} aponta para "
                    f"alvo não reconhecido: {target}"
                )

    # Caso 3: Upgraded install — apenas legacy existe como arquivo regular
    if legacy_exists and not legacy_is_symlink and not canonical_exists:
        try:
            canonical.symlink_to("workstation-lifecycle.lock")
        except OSError:
            pass
        return legacy.resolve()

    # Caso 4: Fresh install ou canonical já existente
    if not canonical_exists:
        canonical.touch(mode=0o600, exist_ok=True)

    if not legacy_exists:
        try:
            legacy.symlink_to("installation.lock")
        except OSError:
            pass

    return canonical.resolve()


class LabInstallationLock:
    def __init__(self, locks_dir: Path):
        self.locks_dir = locks_dir
        self.lock_target = resolve_installation_lock_path(locks_dir)
        self._fd: int | None = None
        self._inherited: bool = False

    def __enter__(self) -> "LabInstallationLock":
        inherited_fd_str = os.environ.get("SISTER_INSTALLATION_LOCK_FD") or os.environ.get("SISTER_WORKSTATION_LOCK_FD")
        if inherited_fd_str:
            try:
                inherited_fd = int(inherited_fd_str)
                fd_path = Path(f"/proc/{os.getpid()}/fd/{inherited_fd}")
                if fd_path.exists() and fd_path.resolve() == self.lock_target:
                    self._fd = inherited_fd
                    self._inherited = True
                    return self
            except (ValueError, OSError):
                pass

        try:
            self._fd = os.open(str(self.lock_target), os.O_CREAT | os.O_RDWR, 0o600)
            fcntl.flock(self._fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            os.set_inheritable(self._fd, True)
            os.environ["SISTER_INSTALLATION_LOCK_FD"] = str(self._fd)
            os.environ["SISTER_WORKSTATION_LOCK_FD"] = str(self._fd)
        except (BlockingIOError, OSError) as exc:
            if self._fd is not None:
                try:
                    os.close(self._fd)
                except OSError:
                    pass
                self._fd = None
            raise LabUxError(
                f"outra operação de lifecycle está em execução (lock ativo em {self.lock_target})"
            ) from exc
        return self

    def __exit__(self, exc_type: Any, exc_val: Any, exc_tb: Any) -> None:
        if not self._inherited and self._fd is not None:
            if os.environ.get("SISTER_INSTALLATION_LOCK_FD") == str(self._fd):
                del os.environ["SISTER_INSTALLATION_LOCK_FD"]
            if os.environ.get("SISTER_WORKSTATION_LOCK_FD") == str(self._fd):
                del os.environ["SISTER_WORKSTATION_LOCK_FD"]
            try:
                fcntl.flock(self._fd, fcntl.LOCK_UN)
            except OSError:
                pass
            try:
                os.close(self._fd)
            except OSError:
                pass
            self._fd = None

def authority_context(
    composition: Path | None = None,
    deployment: Path | None = None,
    allow_missing: bool = True,
) -> dict[str, Any]:
    cmd = [str(AUTHORITY_CLI), "resolve", "--target", "lab"]
    if composition:
        cmd.extend(["--composition", str(composition)])
    if deployment:
        cmd.extend(["--deployment", str(deployment)])
    if allow_missing:
        cmd.append("--allow-missing")
    proc = subprocess.run(
        cmd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        raise LabUxError(proc.stderr.strip() or "falha ao resolver installation authority")
    return json.loads(proc.stdout)


def canonical_paths() -> tuple[Path, Path]:
    context = authority_context()
    return (
        Path(context["composition"]["path"]),
        Path(context["deployment"]["path"]),
    )

def candidate_cli() -> Path:
    return Path(
        os.environ.get(
            "SISTER_LAB_CANDIDATE_CLI",
            str(INFRA_ROOT / "bin" / "sister-candidate"),
        )
    ).expanduser()

def reconcile_cli() -> Path:
    return Path(
        os.environ.get(
            "SISTER_LAB_RECONCILE_CLI",
            str(INFRA_ROOT / "bin" / "sister-reconcile"),
        )
    ).expanduser()

def existing_path(value: str, label: str) -> Path:
    path = Path(value).expanduser()
    if not path.exists():
        raise LabUxError(f"{label} ausente: {path}")
    return path.resolve()

def create_ephemeral_candidate(composition: Path, out_dir: Path) -> Path:
    cli = candidate_cli()
    if not cli.is_file():
        raise LabUxError(f"autoridade sister-candidate não encontrada: {cli}")

    cmd = [
        str(cli),
        "create",
        str(composition),
        "--out",
        str(out_dir),
    ]

    contracts_root = os.environ.get("SISTER_WORKSTATION_CONTRACTS_ROOT", "").strip()
    if contracts_root:
        cmd.extend(["--contracts-root", contracts_root])

    proc = subprocess.run(
        cmd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )

    if proc.returncode != 0:
        detail = proc.stderr.strip() or proc.stdout.strip() or f"exit={proc.returncode}"
        raise LabUxError(
            "não foi possível derivar candidata da composição canônica: "
            f"{detail}"
        )

    manifest = out_dir / "manifest.json"
    if not manifest.is_file():
        raise LabUxError(
            "sister-candidate retornou sucesso sem materializar manifest.json"
        )

    return out_dir.resolve()

def lab_config_root() -> Path:
    return Path(
        os.environ.get(
            "SISTER_WORKSTATION_CONFIG_ROOT",
            str(Path.home() / ".config" / "sister" / "workstation"),
        )
    ).expanduser().resolve()

def lab_tls_dir() -> Path:
    return lab_config_root() / "tls"

def cleanup_abandoned_staging(config_root: Path) -> None:
    if not config_root.is_dir():
        return
    for entry in config_root.iterdir():
        if entry.is_dir() and entry.name.startswith(".tls-init-"):
            try:
                shutil.rmtree(entry, ignore_errors=True)
            except OSError:
                pass

def parse_openssl_date(date_str: str) -> datetime | None:
    for fmt in (
        "%b %d %H:%M:%S %Y GMT",
        "%b  %d %H:%M:%S %Y GMT",
        "%b %d %H:%M:%S %Y",
        "%b  %d %H:%M:%S %Y",
        "%Y-%m-%d %H:%M:%S",
    ):
        try:
            return datetime.strptime(date_str.strip(), fmt).replace(tzinfo=timezone.utc)
        except ValueError:
            pass
    return None

def get_ca_status(
    tls_dir: Path,
    ca_cert: Path,
    ca_key: Path,
    renew_before_sec: int = 2592000,
) -> dict[str, Any]:
    if not ca_cert.is_file() and not ca_key.is_file():
        return {
            "status": "ABSENT",
            "ca_cert_path": str(ca_cert),
            "ca_key_path": str(ca_key),
            "detail": "arquivos de autoridade CA ausentes",
        }
    if not ca_cert.is_file() or not ca_key.is_file():
        detail = (
            "chave privada ausente"
            if not ca_key.is_file()
            else "certificado CA ausente"
        )
        return {
            "status": "INVALID",
            "ca_cert_path": str(ca_cert),
            "ca_key_path": str(ca_key),
            "detail": f"estado parcial: {detail}",
        }

    # 1. Parse do certificado
    cmd = [
        "openssl", "x509",
        "-in", str(ca_cert),
        "-noout",
        "-subject", "-dates", "-fingerprint", "-sha256",
    ]
    res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if res.returncode != 0:
        return {
            "status": "INVALID",
            "ca_cert_path": str(ca_cert),
            "ca_key_path": str(ca_key),
            "detail": "certificado CA não parseável via openssl x509",
        }

    subject = ""
    not_before_str = ""
    not_after_str = ""
    fingerprint = ""
    for line in res.stdout.splitlines():
        if line.startswith("subject="):
            subject = line[len("subject="):].strip()
        elif line.startswith("notBefore="):
            not_before_str = line[len("notBefore="):].strip()
        elif line.startswith("notAfter="):
            not_after_str = line[len("notAfter="):].strip()
        elif "Fingerprint=" in line:
            fingerprint = line.split("Fingerprint=", 1)[1].strip()

    # 2. Chave corresponde ao certificado
    res1 = subprocess.run(["openssl", "x509", "-in", str(ca_cert), "-pubkey", "-noout"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    res2 = subprocess.run(["openssl", "pkey", "-in", str(ca_key), "-pubout"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if res1.returncode != 0 or res2.returncode != 0 or not res1.stdout.strip() or res1.stdout.strip() != res2.stdout.strip():
        return {
            "status": "INVALID",
            "ca_cert_path": str(ca_cert),
            "ca_key_path": str(ca_key),
            "subject": subject,
            "fingerprint": fingerprint,
            "detail": "chave privada incompatível com o certificado CA",
        }

    # 3. Extensões CA: basicConstraints deve conter CA:TRUE
    res_ext = subprocess.run(["openssl", "x509", "-in", str(ca_cert), "-noout", "-text"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if "CA:TRUE" not in res_ext.stdout:
        return {
            "status": "INVALID",
            "ca_cert_path": str(ca_cert),
            "ca_key_path": str(ca_key),
            "subject": subject,
            "fingerprint": fingerprint,
            "detail": "certificado não possui basicConstraints CA:TRUE",
        }

    # 4. Validade e expiração
    dt_end = parse_openssl_date(not_after_str)
    dt_start = parse_openssl_date(not_before_str)
    now = datetime.now(timezone.utc)

    days_remaining = None
    if dt_end:
        days_remaining = int((dt_end - now).total_seconds() // 86400)

    # Checa expiração via openssl -checkend 0
    res_exp = subprocess.run(["openssl", "x509", "-in", str(ca_cert), "-noout", "-checkend", "0"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if res_exp.returncode != 0 or (days_remaining is not None and days_remaining <= 0):
        return {
            "status": "EXPIRED",
            "ca_cert_path": str(ca_cert),
            "ca_key_path": str(ca_key),
            "subject": subject,
            "fingerprint": fingerprint,
            "not_before": dt_start.isoformat() if dt_start else not_before_str,
            "not_after": dt_end.isoformat() if dt_end else not_after_str,
            "days_remaining": days_remaining,
            "detail": "CA expirada",
        }

    # Checa janela preventiva via openssl -checkend renew_before_sec
    res_renew = subprocess.run(["openssl", "x509", "-in", str(ca_cert), "-noout", "-checkend", str(renew_before_sec)], stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    if res_renew.returncode != 0:
        return {
            "status": "EXPIRING",
            "ca_cert_path": str(ca_cert),
            "ca_key_path": str(ca_key),
            "subject": subject,
            "fingerprint": fingerprint,
            "not_before": dt_start.isoformat() if dt_start else not_before_str,
            "not_after": dt_end.isoformat() if dt_end else not_after_str,
            "days_remaining": days_remaining,
            "detail": f"CA na janela preventiva de renovação ({days_remaining} dias restantes)",
        }

    return {
        "status": "VALID",
        "ca_cert_path": str(ca_cert),
        "ca_key_path": str(ca_key),
        "subject": subject,
        "fingerprint": fingerprint,
        "not_before": dt_start.isoformat() if dt_start else not_before_str,
        "not_after": dt_end.isoformat() if dt_end else not_after_str,
        "days_remaining": days_remaining,
        "detail": "CA válida e operacional",
    }

def cmd_tls_status(args: argparse.Namespace) -> int:
    tls_dir = lab_tls_dir()
    ca_cert = tls_dir / "ecosystem-lab-ca.crt"
    ca_key = tls_dir / "ecosystem-lab-ca.key"

    status_info = get_ca_status(tls_dir, ca_cert, ca_key)

    if args.json:
        print(json.dumps(status_info, indent=2, sort_keys=True))
    else:
        st = status_info["status"]
        if st == "ABSENT":
            print(f"Status CA:       ABSENT ({status_info.get('detail')})")
            print(f"Caminho esperado:{ca_cert}")
        else:
            print(f"Status CA:       {st}")
            print(f"Certificado:     {status_info.get('ca_cert_path')}")
            if "subject" in status_info and status_info["subject"]:
                print(f"Subject:         {status_info['subject']}")
            if "fingerprint" in status_info and status_info["fingerprint"]:
                print(f"Fingerprint:     {status_info['fingerprint']}")
            if "not_before" in status_info and status_info["not_before"]:
                print(f"Válido desde:    {status_info['not_before']}")
            if "not_after" in status_info and status_info["not_after"]:
                print(f"Válido até:      {status_info['not_after']}")
            if status_info.get("days_remaining") is not None:
                print(f"Dias restantes:  {status_info['days_remaining']}")
            if status_info.get("detail"):
                print(f"Diagnóstico:     {status_info['detail']}")

    return 0

def cmd_tls_init_ca(args: argparse.Namespace) -> int:
    config_root = lab_config_root()
    tls_dir = config_root / "tls"
    ca_cert = tls_dir / "ecosystem-lab-ca.crt"
    ca_key = tls_dir / "ecosystem-lab-ca.key"

    config_root.mkdir(mode=0o700, parents=True, exist_ok=True)
    lock_path = config_root / ".lab-tls-authority.lock"

    with open(lock_path, "a+") as lock_file:
        try:
            os.chmod(lock_path, 0o600)
        except OSError:
            pass
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        try:
            # 1. TLSA-015: RE-OBSERVE autoridade obrigatoriamente sob o lock
            status_info = get_ca_status(tls_dir, ca_cert, ca_key)
            st = status_info["status"]

            if st == "VALID":
                payload = {
                    "status": "NO_OP",
                    "ca_cert_path": str(ca_cert),
                    "fingerprint": status_info["fingerprint"],
                    "subject": status_info["subject"],
                    "message": "autoridade CA existente e válida",
                }
                if args.json:
                    print(json.dumps(payload, indent=2, sort_keys=True))
                else:
                    print(f"[PASS] autoridade CA já existente e válida: {ca_cert} (NO_OP)")
                return 0

            if st != "ABSENT":
                detail = status_info.get("detail", "material CA inconsistente")
                raise LabUxError(
                    f"init-ca recusado: autoridade existente em estado {st}: {detail} (FAIL-CLOSED)"
                )

            # 2. TLSA-017: CA ausente não autoriza substituir conteúdo preexistente de tls/
            if tls_dir.exists():
                entries = sorted([p.name for p in tls_dir.iterdir()])
                if entries:
                    raise LabUxError(
                        f"init-ca recusado: diretório {tls_dir} já existe e não está vazio "
                        f"(contém {len(entries)} entrada(s), ex: {entries[0]}). "
                        "Nenhum conteúdo preexistente pode ser substituído implicitamente (FAIL-CLOSED)"
                    )

            # 3. TLSA-018: Limpeza segura de staging abandonado anterior (.tls-init-*) sob lock
            cleanup_abandoned_staging(config_root)

            # 4. TLSA-016: Geração do bundle inteiro em diretório staging irmão de tls/
            staging_dir = Path(tempfile.mkdtemp(dir=config_root, prefix=".tls-init-"))
            staging_dir.chmod(0o700)
            staging_key = staging_dir / "ecosystem-lab-ca.key"
            staging_crt = staging_dir / "ecosystem-lab-ca.crt"

            try:
                # 4a. Gera chave privada 4096-bit
                res_key = subprocess.run(
                    ["openssl", "genrsa", "-out", str(staging_key), "4096"],
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
                if res_key.returncode != 0:
                    raise LabUxError(f"falha ao gerar chave privada da CA: {res_key.stderr.decode('utf-8', 'replace')}")
                os.chmod(staging_key, 0o600)

                # 4b. Gera certificado auto-assinado da CA
                cmd_req = [
                    "openssl", "req", "-x509", "-new", "-nodes",
                    "-key", str(staging_key),
                    "-sha256",
                    "-days", "3650",
                    "-subj", "/CN=SisTer Infra Lab CA",
                    "-addext", "basicConstraints=critical,CA:TRUE",
                    "-addext", "keyUsage=critical,keyCertSign,cRLSign",
                    "-addext", "subjectKeyIdentifier=hash",
                    "-out", str(staging_crt),
                ]
                res_req = subprocess.run(
                    cmd_req,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    check=False,
                )
                if res_req.returncode != 0:
                    raise LabUxError(f"falha ao gerar certificado da CA: {res_req.stderr.decode('utf-8', 'replace')}")
                os.chmod(staging_crt, 0o644)

                # 4c. Validação prévia completa do material em staging
                staged_info = get_ca_status(staging_dir, staging_crt, staging_key)
                if staged_info["status"] != "VALID":
                    raise LabUxError(f"material CA em staging falhou na validação: {staged_info.get('detail')}")

                # 4d. Publicação atômica do bundle em operação única (rename/replace do diretório)
                os.replace(staging_dir, tls_dir)
                os.chmod(tls_dir, 0o700)
                os.chmod(tls_dir / "ecosystem-lab-ca.key", 0o600)
                os.chmod(tls_dir / "ecosystem-lab-ca.crt", 0o644)

            finally:
                if staging_dir.exists():
                    shutil.rmtree(staging_dir, ignore_errors=True)

            # 5. Re-observação final da autoridade publicada
            final_info = get_ca_status(tls_dir, ca_cert, ca_key)
            if final_info["status"] != "VALID":
                raise LabUxError("autoridade CA publicada falhou na verificação final")

            payload = {
                "status": "CREATE",
                "ca_cert_path": str(ca_cert),
                "fingerprint": final_info["fingerprint"],
                "subject": final_info["subject"],
                "message": "autoridade CA de laboratório criada com sucesso",
            }
            if args.json:
                print(json.dumps(payload, indent=2, sort_keys=True))
            else:
                print(f"[PASS] autoridade CA de laboratório criada: {ca_cert} (CREATE)")

            return 0

        finally:
            try:
                fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
            except OSError:
                pass

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="sister-lab",
        description="Resolvedor de intenção canônica de LAB para a workstation.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    plan = sub.add_parser(
        "plan",
        help="projeta o plano de reconciliação para a intenção LAB",
    )
    plan.add_argument(
        "--desired-candidate",
        help=(
            "override: candidata desejada verificada; se omitido, uma candidata "
            "efêmera é derivada da composition canônica"
        ),
    )
    plan.add_argument(
        "--desired-deployment",
        help=(
            "override: deployment desejado; se omitido, usa o deployment "
            "canônico da workstation"
        ),
    )
    plan.add_argument(
        "--current-release",
        help="override opcional da release atual; se omitido, o reconciliador autodetecta",
    )
    plan.add_argument(
        "--probe-runtime",
        action=argparse.BooleanOptionalAction,
        default=None,
        help="ativa/desativa sondagem factual; padrão permanece o do reconciliador",
    )
    plan.add_argument(
        "--json",
        action="store_true",
        help="emite o plano JSON do reconciliador",
    )

    apply = sub.add_parser(
        "apply",
        help="aplica transacionalmente a intenção LAB canônica ou overrides explícitos",
    )
    apply.add_argument(
        "--desired-candidate",
        help=(
            "override: candidata desejada verificada; se omitido, uma candidata "
            "efêmera é derivada da composition canônica"
        ),
    )
    apply.add_argument(
        "--desired-deployment",
        help=(
            "override: deployment desejado; se omitido, usa o deployment "
            "canônico da workstation"
        ),
    )
    apply.add_argument(
        "--current-release",
        help="override opcional da release atual; se omitido, o reconciliador autodetecta",
    )
    apply.add_argument(
        "--json",
        action="store_true",
        help="emite o resultado JSON do reconciliador",
    )

    tls = sub.add_parser(
        "tls",
        help="gerenciamento de autoridade TLS do LAB",
    )
    tls_sub = tls.add_subparsers(dest="tls_command", required=True)

    tls_status_p = tls_sub.add_parser(
        "status",
        help="inspeção estritamente observacional da autoridade CA de laboratório",
    )
    tls_status_p.add_argument(
        "--json",
        action="store_true",
        help="emite o resultado em JSON puro",
    )

    tls_init_p = tls_sub.add_parser(
        "init-ca",
        help="inicializa a autoridade CA de laboratório em ambiente novo",
    )
    tls_init_p.add_argument(
        "--json",
        action="store_true",
        help="emite o resultado em JSON puro",
    )

    return parser

def invoke_reconcile(
    args: argparse.Namespace,
    desired_candidate: Path,
    desired_deployment: Path,
    context: dict[str, Any],
) -> int:
    cli = reconcile_cli()
    if not cli.is_file():
        raise LabUxError(f"motor sister-reconcile não encontrado: {cli}")

    cmd = [
        str(cli),
        args.command,
        "--mode",
        "lab",
        "--desired-candidate",
        str(desired_candidate),
        "--desired-deployment",
        str(desired_deployment),
    ]

    if args.current_release:
        cmd.extend(["--current-release", args.current_release])

    if args.command == "plan" and args.probe_runtime is not None:
        cmd.append("--probe-runtime" if args.probe_runtime else "--no-probe-runtime")

    if args.json:
        cmd.append("--json")

    if args.command == "apply":
        state_root = Path(
            os.environ.get("SISTER_WORKSTATION_STATE_ROOT", "~/.local/state/sister/workstation")
        ).expanduser().resolve()
        locks_dir = state_root / "locks"
        with LabInstallationLock(locks_dir) as lock:
            pass_fds = (lock._fd,) if lock._fd is not None else ()
            proc = subprocess.run(
                cmd,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                pass_fds=pass_fds,
                check=False,
            )
    else:
        proc = subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
    if proc.stderr:
        sys.stderr.write(proc.stderr)
    if args.command == "plan" and proc.returncode == 0:
        if args.json:
            try:
                document = json.loads(proc.stdout)
            except json.JSONDecodeError as exc:
                raise LabUxError(f"reconciliador produziu JSON inválido: {exc}") from exc
            document["authority"] = context
            print(json.dumps(document, ensure_ascii=False, sort_keys=True))
        else:
            print(f"Authority root: {context['config_root']}")
            print(f"Composition: {context['composition']['path']} {context['composition']['digest']}")
            print(f"Deployment: {context['deployment']['path']} {context['deployment']['digest']}")
            if proc.stdout:
                sys.stdout.write(proc.stdout)
    elif proc.stdout:
        sys.stdout.write(proc.stdout)
    return proc.returncode

def run(args: argparse.Namespace) -> int:
    if args.command == "tls":
        if args.tls_command == "status":
            return cmd_tls_status(args)
        elif args.tls_command == "init-ca":
            return cmd_tls_init_ca(args)
        else:
            raise LabUxError(f"subcomando tls desconhecido: {args.tls_command}")

    canonical_composition, canonical_deployment = canonical_paths()

    explicit_candidate = None
    if args.desired_candidate:
        explicit_candidate = existing_path(
            args.desired_candidate,
            "candidata desejada explícita",
        )

    if args.desired_deployment:
        desired_deployment = existing_path(
            args.desired_deployment,
            "deployment desejado explícito",
        )
    else:
        if not canonical_deployment.is_file():
            raise LabUxError(
                "deployment LAB canônico ausente: "
                f"{canonical_deployment}; declare a intenção LAB ou use "
                "--desired-deployment"
            )
        desired_deployment = canonical_deployment.resolve()

    if explicit_candidate is not None:
        context = authority_context(
            explicit_candidate / "manifest.json",
            desired_deployment if args.desired_deployment else None,
            allow_missing=False,
        )
        return invoke_reconcile(args, explicit_candidate, desired_deployment, context)

    if not canonical_composition.is_file():
        raise LabUxError(
            "composition LAB canônica ausente: "
            f"{canonical_composition}; declare a intenção LAB ou use "
            "--desired-candidate"
        )

    tmp_parent = os.environ.get("SISTER_LAB_TMPDIR")
    if tmp_parent:
        tmp_parent_path = Path(tmp_parent).expanduser()
        tmp_parent_path.mkdir(parents=True, exist_ok=True)
        tmp_dir_arg = str(tmp_parent_path)
    else:
        tmp_dir_arg = None

    with tempfile.TemporaryDirectory(
        prefix="sister-lab-",
        dir=tmp_dir_arg,
    ) as temp_root:
        candidate_dir = Path(temp_root) / "candidate"
        desired_candidate = create_ephemeral_candidate(
            canonical_composition.resolve(),
            candidate_dir,
        )
        context = authority_context(
            deployment=desired_deployment if args.desired_deployment else None,
            allow_missing=False,
        )
        return invoke_reconcile(args, desired_candidate, desired_deployment, context)

def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return run(args)
    except LabUxError as exc:
        print(f"[FAIL] {exc}", file=sys.stderr)
        return 2

if __name__ == "__main__":
    raise SystemExit(main())
