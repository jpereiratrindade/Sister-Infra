#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

INFRA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
RUN_ROOT="${SISTER_INFRA_RUN_ROOT:-$INFRA_ROOT/.run}"
GATEWAY_RUN="$RUN_ROOT/gateway"
LOG_ROOT="$RUN_ROOT/logs"
PROFILE="lan"
COMMAND=""

usage() {
  cat <<'USAGE'
SisTer Infra — adapter privado do runtime de gateway

Uso:
  runtime-gateway <up|down|status|verify|client-env|hosts-line> [--profile dev|lan]

Este entrypoint é privado. Operadores devem usar sister-infra.
USAGE
}

log()  { printf '[infra] %s\n' "$*"; }
pass() { printf '[PASS] %s\n' "$*"; }
warn() { printf '[WARN] %s\n' "$*" >&2; }
die()  { printf '[FAIL] %s\n' "$*" >&2; exit 2; }

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "comando obrigatório ausente: $1"
}

parse_args() {
  [[ $# -ge 1 ]] || { usage; exit 2; }
  COMMAND="$1"
  shift

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --profile)
        [[ $# -ge 2 ]] || die "--profile exige valor"
        PROFILE="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "opção desconhecida: $1"
        ;;
    esac
  done

  case "$PROFILE" in
    dev|lan) ;;
    production)
      die "adapter de runtime não aceita produção; use sister-infra production plan/apply/verify"
      ;;
    *) die "perfil inválido: $PROFILE" ;;
  esac
}

load_profile() {
  local default_port="${GATEWAY_LISTEN_PORT:-}"
  local default_addr="${GATEWAY_LISTEN_ADDRESS:-}"
  HAPROXY_BIN="${HAPROXY_BIN:-/usr/local/sbin/haproxy-3.2.22}"
  GATEWAY_LISTEN_PORT="$default_port"
  GATEWAY_LISTEN_ADDRESS="$default_addr"

  mkdir -p "$GATEWAY_RUN" "$LOG_ROOT"
  chmod 700 "$RUN_ROOT" "$GATEWAY_RUN" "$LOG_ROOT" 2>/dev/null || true

  local workstation_tls="${SISTER_WORKSTATION_CONFIG_ROOT:-$HOME/.config/sister/workstation}/tls"
  TLS_PEM="${TLS_PEM:-$workstation_tls/ecosystem-lab.pem}"
  CA_CERT="${CA_CERT:-$workstation_tls/ecosystem-lab-ca.crt}"
  GATEWAY_CFG="${GATEWAY_CFG:-$GATEWAY_RUN/haproxy-${PROFILE}.cfg}"
  GATEWAY_PID="${GATEWAY_PID:-$GATEWAY_RUN/haproxy-${PROFILE}.pid}"
  GATEWAY_LOADED="${GATEWAY_LOADED:-${GATEWAY_CFG%.cfg}.loaded.json}"
  GATEWAY_LOG="${GATEWAY_LOG:-$LOG_ROOT/haproxy-${PROFILE}.log}"
}

runtime_preflight() {
  require_command curl
  require_command jq
  require_command cmp
  require_command sha256sum

  if [[ -z "${SISTER_RESOLVED_DEPLOYMENT_FILE:-}" || ! -f "$SISTER_RESOLVED_DEPLOYMENT_FILE" ]]; then
    local current_link="${SISTER_WORKSTATION_INSTALL_ROOT:-$HOME/.local/share/sister}/current"
    if [[ -L "$current_link" ]]; then
      local current_path
      current_path="$(readlink -f "$current_link")/evidence/deployment/resolved.json"
      if [[ -f "$current_path" ]]; then
        export SISTER_RESOLVED_DEPLOYMENT_FILE="$current_path"
      fi
    fi
  fi

  local resolved="${SISTER_RESOLVED_DEPLOYMENT_FILE:-}"
  [[ -n "$resolved" && -f "$resolved" ]] || \
    die "deployment resolvido ausente; defina SISTER_RESOLVED_DEPLOYMENT_FILE"
  jq -e '
    .schema == "sister.infra.deployment.resolved/1"
    and .status == "READY"
    and (.components | type == "array" and length > 0)
  ' "$resolved" >/dev/null || die "deployment resolvido inválido"

  local declared_addr declared_port
  declared_addr="$(jq -r '.gateway.listen // empty' "$resolved")"
  declared_port="$(jq -r '.gateway.port // empty' "$resolved")"
  GATEWAY_PROTOCOL="$(jq -r '.gateway.protocol // "https"' "$resolved")"
  GATEWAY_EXPOSURE="$(jq -r '.gateway.exposure // "host"' "$resolved")"
  GATEWAY_LISTEN_ADDRESS="${GATEWAY_LISTEN_ADDRESS:-$declared_addr}"
  GATEWAY_LISTEN_PORT="${GATEWAY_LISTEN_PORT:-$declared_port}"
  [[ -n "$GATEWAY_LISTEN_ADDRESS" ]] || die "gateway.listen ausente no deployment resolvido"
  if [[ "$GATEWAY_EXPOSURE" != "ip-ports" ]]; then
    [[ -n "$GATEWAY_LISTEN_PORT" ]] || die "gateway.port ausente no deployment resolvido"
  fi
  if [[ "$GATEWAY_PROTOCOL" == "https" ]]; then
    require_command openssl
  fi

  if [[ ! -x "$HAPROXY_BIN" ]]; then
    local detected
    detected="$(command -v haproxy 2>/dev/null || true)"
    [[ -n "$detected" ]] || die "HAProxy não encontrado em $HAPROXY_BIN nem no PATH"
    HAPROXY_BIN="$detected"
  fi
  "$HAPROXY_BIN" -vv >/dev/null 2>&1 || \
    die "HAProxy não executável: $HAPROXY_BIN"
}

render_gateway_file() {
  local output="$1"

  if [[ "$GATEWAY_PROTOCOL" == "https" ]]; then
    [[ -f "$TLS_PEM" ]] || die "TLS PEM ausente: $TLS_PEM"
  fi

  local resolved="${SISTER_RESOLVED_DEPLOYMENT_FILE:-}"
  [[ -n "$resolved" && -f "$resolved" ]] || \
    die "deployment resolvido ausente; defina SISTER_RESOLVED_DEPLOYMENT_FILE"

  local -a render_args=(
    "$INFRA_ROOT/bin/sister-gateway" render
    "$resolved"
    --listen-address "$GATEWAY_LISTEN_ADDRESS"
  )

  [[ -n "$GATEWAY_LISTEN_PORT" ]] && \
    render_args+=(--listen-port "$GATEWAY_LISTEN_PORT")

  [[ "$GATEWAY_PROTOCOL" == "https" ]] && \
    render_args+=(--tls-pem "$TLS_PEM")

  "${render_args[@]}" > "$output" || return 1

  "$HAPROXY_BIN" -c -f "$output" >/dev/null || return 1
}


render_gateway() {
  render_gateway_file "$GATEWAY_CFG" || \
    die "falha ao renderizar ou validar gateway declarativo"

  pass "configuração HAProxy válida"
}


verify_gateway_materialization() {
  local expected
  expected="$(mktemp "$GATEWAY_RUN/haproxy-verify.XXXXXX")"

  if ! render_gateway_file "$expected"; then
    rm -f "$expected"
    die "não foi possível derivar configuração esperada do gateway"
  fi

  if [[ ! -f "$GATEWAY_CFG" ]]; then
    rm -f "$expected"
    die "configuração HAProxy materializada ausente: $GATEWAY_CFG"
  fi

  if ! cmp -s "$expected" "$GATEWAY_CFG"; then
    rm -f "$expected"
    die "gateway materializado diverge do render esperado; reconciliação necessária"
  fi

  rm -f "$expected"
  pass "materialização do gateway corresponde ao render esperado"
}


verify_public_navigation() {
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"

  local entry
  entry="$(
    jq -r '
      [
        .components[]
        | select(.gateway != null)
        | [
            .gateway.host,
            (.gateway.port // "")
          ]
        | @tsv
      ][0] // empty
    ' "$resolved"
  )"

  if [[ -z "$entry" ]]; then
    pass "nenhuma superfície publicada para verificar navegação"
    return 0
  fi

  local entry_host entry_public_port
  IFS=$'\t' read -r entry_host entry_public_port <<<"$entry"

  local origin_port
  local origin_url
  local -a request_args=(
    --noproxy '*'
    -sS
    --max-time 5
    -o /dev/null
  )

  if [[ "$GATEWAY_EXPOSURE" == "ip-ports" ]]; then
    [[ -n "$entry_public_port" ]] || \
      die "componente de entrada sem porta pública em ip-ports"

    origin_port="$entry_public_port"
    origin_url="$GATEWAY_PROTOCOL://$GATEWAY_LISTEN_ADDRESS:$origin_port"
  else
    [[ -n "$GATEWAY_LISTEN_PORT" ]] || \
      die "gateway host-routing sem porta pública"

    origin_port="$GATEWAY_LISTEN_PORT"
    origin_url="$GATEWAY_PROTOCOL://$entry_host:$origin_port"

    request_args+=(
      --resolve
      "$entry_host:$origin_port:$GATEWAY_LISTEN_ADDRESS"
    )
  fi

  if [[ "$GATEWAY_PROTOCOL" == "https" && -f "$CA_CERT" ]]; then
    request_args+=(--cacert "$CA_CERT")
  fi

  local component_id target_host target_public_port
  while IFS=$'\t' read -r \
      component_id target_host target_public_port; do

    [[ -n "$component_id" ]] || continue

    local expected_location

    if [[ "$GATEWAY_EXPOSURE" == "ip-ports" ]]; then
      [[ -n "$target_public_port" ]] || \
        die "componente '$component_id' sem porta pública"

      expected_location="$GATEWAY_PROTOCOL://$GATEWAY_LISTEN_ADDRESS:$target_public_port/"
    else
      expected_location="$GATEWAY_PROTOCOL://$target_host:$GATEWAY_LISTEN_PORT/"
    fi

    local result
    if ! result="$(
      curl \
        "${request_args[@]}" \
        -w $'%{http_code}\t%{redirect_url}' \
        "$origin_url/_sister/open/$component_id"
    )"; then
      die "navegação pública factual falhou para '$component_id'"
    fi

    local status location
    IFS=$'\t' read -r status location <<<"$result"

    if [[ "$status" != "302" ]]; then
      die \
        "navegação pública para '$component_id' retornou HTTP $status; esperado 302"
    fi

    if [[ "$location" != "$expected_location" ]]; then
      die \
        "navegação pública para '$component_id' divergiu: esperado '$expected_location', observado '$location'"
    fi

    pass "$component_id navegação pública factual"
  done < <(
    jq -r '
      .components[]
      | select(.gateway != null)
      | [
          .component_id,
          .gateway.host,
          (.gateway.port // "")
        ]
      | @tsv
    ' "$resolved"
  )

  pass "navegação pública do gateway verificada factualmente"
}

write_gateway_loaded_witness() {
  pid_alive "$GATEWAY_PID" ||     die "não é possível registrar witness: gateway não está ativo"

  [[ -f "$GATEWAY_CFG" ]] ||     die "não é possível registrar witness: configuração ausente em $GATEWAY_CFG"

  local pid cfg_sha tmp
  pid="$(cat "$GATEWAY_PID")"
  cfg_sha="$(sha256sum "$GATEWAY_CFG" | awk '{print $1}')"
  tmp="${GATEWAY_LOADED}.tmp.$$"

  jq -n     --argjson pid "$pid"     --arg config_sha256 "$cfg_sha"     '{
      schema: "sister.infra.gateway.loaded/1",
      pid: $pid,
      config_sha256: $config_sha256
    }' >"$tmp"

  chmod 600 "$tmp"
  mv -f "$tmp" "$GATEWAY_LOADED"
}

verify_gateway_loaded_witness() {
  [[ -f "$GATEWAY_LOADED" ]] ||     die "witness factual do gateway ausente: $GATEWAY_LOADED"

  jq -e '
    .schema == "sister.infra.gateway.loaded/1"
    and (.pid | type == "number")
    and (.config_sha256 | type == "string" and length == 64)
  ' "$GATEWAY_LOADED" >/dev/null ||     die "witness factual do gateway inválida: $GATEWAY_LOADED"

  pid_alive "$GATEWAY_PID" ||     die "gateway declarativo não está ativo"

  local factual_pid loaded_pid cfg_sha loaded_sha
  factual_pid="$(cat "$GATEWAY_PID")"
  loaded_pid="$(jq -r '.pid' "$GATEWAY_LOADED")"
  cfg_sha="$(sha256sum "$GATEWAY_CFG" | awk '{print $1}')"
  loaded_sha="$(jq -r '.config_sha256' "$GATEWAY_LOADED")"

  [[ "$loaded_pid" == "$factual_pid" ]] ||     die "witness factual divergiu do PID ativo ($loaded_pid != $factual_pid)"

  [[ "$loaded_sha" == "$cfg_sha" ]] ||     die "witness factual divergiu da configuração materializada"

  pass "gateway carregado coincide com configuração materializada"
}

pid_alive() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  local pid
  pid="$(cat "$file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

stop_gateway() {
  if pid_alive "$GATEWAY_PID"; then
    local pid
    pid="$(cat "$GATEWAY_PID")"
    log "Parando HAProxy PID $pid..."
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 50); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      warn "HAProxy não encerrou graciosamente; enviando TERM novamente"
      kill -TERM "$pid" 2>/dev/null || true
    fi
  fi
  rm -f "$GATEWAY_PID" "$GATEWAY_LOADED"
}

start_gateway() {
  stop_gateway
  render_gateway
  log "Subindo gateway $GATEWAY_LISTEN_ADDRESS:$GATEWAY_LISTEN_PORT..."
  "$HAPROXY_BIN" -D -f "$GATEWAY_CFG" -p "$GATEWAY_PID" >>"$GATEWAY_LOG" 2>&1
  sleep 0.4
  pid_alive "$GATEWAY_PID" || \
    die "HAProxy não permaneceu ativo; veja $GATEWAY_LOG"
  pass "gateway ativo"
}

component_health() {
  local component_id="$1"
  local transport="$2"
  local endpoint_a="$3"
  local endpoint_b="$4"
  local health_path="$5"

  [[ -n "$health_path" && "$health_path" != "null" ]] || return 0

  case "$transport" in
    tcp)
      curl --noproxy '*' -fsS --max-time 5 \
        "http://${endpoint_a}:${endpoint_b}${health_path}" >/dev/null
      ;;
    unix)
      curl --noproxy '*' -fsS --max-time 5 \
        --unix-socket "$endpoint_a" \
        "http://localhost${health_path}" >/dev/null
      ;;
    *) die "transport desconhecido para $component_id: $transport" ;;
  esac
}

verify_components() {
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local component_id transport endpoint_a endpoint_b health_path
  while IFS=$'\t' read -r \
      component_id transport endpoint_a endpoint_b health_path; do
    [[ -n "$component_id" ]] || continue
    component_health \
      "$component_id" "$transport" "$endpoint_a" "$endpoint_b" "$health_path" \
      && pass "$component_id saudável" \
      || die "$component_id não respondeu ao probe declarativo"
  done < <(
    jq -r '
      .components[]
      | [
          .component_id,
          .runtime.transport,
          (if .runtime.transport == "tcp" then .runtime.listen else .runtime.socket end),
          (if .runtime.transport == "tcp" then (.runtime.port | tostring) else "-" end),
          (.probe.health_path // "")
        ] | @tsv
    ' "$resolved"
  )
}

verify_gateway_urls() {
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local -a cacert_args=()
  if [[ "$GATEWAY_PROTOCOL" == "https" && -f "$CA_CERT" ]]; then
    cacert_args=(--cacert "$CA_CERT")
  fi

  local component_id host public_port health_path
  while IFS=$'\t' read -r component_id host public_port health_path; do
    [[ -n "$component_id" ]] || continue
    local port="$GATEWAY_LISTEN_PORT"
    [[ "$GATEWAY_EXPOSURE" == "ip-ports" ]] && port="$public_port"
    local -a resolve_args=()
    if [[ "$GATEWAY_PROTOCOL" == "https" ]]; then
      resolve_args=(--resolve "$host:$port:$GATEWAY_LISTEN_ADDRESS")
    fi
    curl --noproxy '*' -fsS --max-time 5 \
      "${cacert_args[@]}" "${resolve_args[@]}" \
      "$GATEWAY_PROTOCOL://$host:$port$health_path" >/dev/null \
      && pass "$component_id via gateway" \
      || die "$component_id não respondeu via gateway"
  done < <(
    jq -r '
      .components[]
      | select(.gateway != null and (.probe.health_path // "") != "")
      | [.component_id, .gateway.host, (.gateway.port // ""), .probe.health_path] | @tsv
    ' "$resolved"
  )
}

cmd_up() {
  runtime_preflight
  if [[ "$GATEWAY_PROTOCOL" == "https" ]]; then
    [[ -f "$TLS_PEM" && -r "$TLS_PEM" ]] || \
      die "certificado TLS do gateway ausente ou ilegível: ${TLS_PEM:-<indefinido>}"
  fi
  start_gateway
  if ! verify_components || ! verify_gateway_urls; then
    stop_gateway
    die "verificação após start do gateway declarativo falhou"
  fi
  write_gateway_loaded_witness
  pass "gateway declarativo ativo"
}

cmd_down() {
  runtime_preflight
  stop_gateway
  pass "gateway declarativo parado"
}

cmd_status() {
  runtime_preflight
  verify_components
  pid_alive "$GATEWAY_PID" || die "gateway declarativo OFFLINE"
  verify_gateway_loaded_witness
  pass "gateway declarativo PID $(cat "$GATEWAY_PID")"
}

cmd_verify() {
  runtime_preflight
  if [[ "$GATEWAY_PROTOCOL" == "https" ]]; then
    [[ -f "$TLS_PEM" && -r "$TLS_PEM" ]] || \
      die "certificado TLS do gateway ausente ou ilegível: ${TLS_PEM:-<indefinido>}"
  fi
  verify_gateway_materialization
  verify_gateway_loaded_witness
  verify_components
  pid_alive "$GATEWAY_PID" || die "gateway declarativo não está ativo"
  verify_gateway_urls
  verify_public_navigation
  pass "deployment declarativo verificado"
}

cmd_client_env() {
  runtime_preflight
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local values
  values="$(jq -r --arg gw_ip "${GATEWAY_LISTEN_ADDRESS:-}" '
    ["localhost", "127.0.0.0/8", "127.0.0.1", "::1"]
    + (if $gw_ip != "" then [$gw_ip] else [] end)
    + [.components[] | select(.runtime.transport == "tcp") | .runtime.listen]
    + [.components[] | select(.gateway != null) | .gateway.host]
    | unique | join(",")
  ' "$resolved")"
  printf 'export NO_PROXY="%s"\n' "$values"
  printf 'export no_proxy="%s"\n' "$values"
}

cmd_hosts_line() {
  runtime_preflight
  local resolved="$SISTER_RESOLVED_DEPLOYMENT_FILE"
  local hosts_list
  hosts_list="$(jq -r '
    [.components[] | select(.gateway != null) | .gateway.host]
    | unique | join(" ")
  ' "$resolved")"
  printf '%s %s\n' "${GATEWAY_LISTEN_ADDRESS:-127.0.0.1}" "$hosts_list"
}

main() {
  parse_args "$@"
  load_profile

  case "$COMMAND" in
    up) cmd_up ;;
    down) cmd_down ;;
    status) cmd_status ;;
    verify) cmd_verify ;;
    client-env) cmd_client_env ;;
    hosts-line|hosts) cmd_hosts_line ;;
    help|-h|--help) usage ;;
    *) die "comando desconhecido: $COMMAND" ;;
  esac
}

main "$@"
